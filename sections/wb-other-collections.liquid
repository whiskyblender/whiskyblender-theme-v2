{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  /* Same title row as "You may also like": heading left, "View all" right. */
  .wb-other-collections__title-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 2rem;
    row-gap: 0.5rem;
  }

  .wb-other-collections__heading {
    margin: 0 0 3rem;
  }

  /* Card text matches the PRODUCT card title (small Raleway), not the big display
     heading card-collection uses by default. Collections have no type/price line —
     just the title, styled like the product-card title. */
  .wb-other-collections .card__heading,
  .wb-other-collections .card__heading a {
    font-family: 'Raleway', sans-serif;
    font-size: 16px;
    line-height: 20px;
    font-weight: 500;
    text-transform: none;
    letter-spacing: normal;
    color: #121212;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  "Other collections" — the SAME layout as the "You may also like" (related-products)
  section: heading + "View all" link on one line, then a wb-productsgrid of cards.
  Uses card-collection (with the title restyled to match the product-card title) and
  sources from the picked collection_list, SKIPPING the collection currently being
  viewed, capped at collections_to_show. Renders nothing if none remain.

  Deliberately NOT using the `.related-products` container class (it triggers a
  product-page-only banding rule that force-greys the section); and NOT `.wb-banded`,
  so this sits on the plain page background — separating it from the grey product grid
  above on the collection template.
{%- endcomment -%}

{%- liquid
  assign eligible = 0
  for col in section.settings.collection_list
    unless collection != blank and col.id == collection.id
      assign eligible = eligible | plus: 1
      if eligible >= section.settings.collections_to_show
        break
      endif
    endunless
  endfor

  assign columns = section.settings.columns_desktop
  if columns > 3
    assign columns = 3
  endif
-%}

{%- if eligible > 0 -%}
  <section>
    <div class="wb-container">
      <div class="wb-padding">
        <div class="wb-other-collections page-width section-{{ section.id }}-padding isolate">
          <div class="wb-other-collections__title-wrapper">
            <h2 class="wb-other-collections__heading inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </h2>
            <div class="center collection__view-all">
              <a
                href="{{ routes.collections_url }}"
                class="link underlined-link"
                aria-label="View all collections"
              >
                View all
              </a>
            </div>
          </div>
          <ul
            class="wb-productsgrid wb-tightergrid grid product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
            role="list"
          >
            {%- assign shown = 0 -%}
            {%- for col in section.settings.collection_list -%}
              {%- if collection != blank and col.id == collection.id -%}
                {%- continue -%}
              {%- endif -%}
              {%- if shown < section.settings.collections_to_show -%}
                {%- assign placeholder_image_index = shown | modulo: 4 | plus: 1 -%}
                {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
                <li class="wb-productcell grid__item">
                  {% render 'card-collection',
                    card_collection: col,
                    media_aspect_ratio: section.settings.image_ratio,
                    columns: columns,
                    placeholder_image: placeholder_image
                  %}
                </li>
                {%- assign shown = shown | plus: 1 -%}
              {%- else -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Other collections",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Other collections",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "limit": 12,
      "label": "Collections",
      "info": "The collection currently being viewed is skipped automatically."
    },
    {
      "type": "range",
      "id": "collections_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Collections to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "square",
      "label": "Image ratio"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Other collections"
    }
  ]
}
{% endschema %}
