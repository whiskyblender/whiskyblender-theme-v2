{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{{ 'wb-custom.css' | asset_url | stylesheet_tag }}

{%- assign api_base = section.settings.api_base_url | strip -%}
{%- assign lab_url  = section.settings.lab_url -%}
{%- assign malts_url = section.settings.single_malts_url -%}
{%- assign drams_url = section.settings.perfect_drams_url -%}

<div
  id="wb-blend-product-loader"
  class="wb-container wb-padding"
  data-api-base="{{ api_base }}"
  data-lab-url="{{ lab_url }}"
>

  <p id="wb-blend-loading" style="display:none">Loading your blend&hellip;</p>

  <p id="wb-blend-error" class="wb-blend-error" aria-live="polite" style="display:none"></p>

  <div id="wb-blend-recipe" style="display:none"></div>

  {%- comment -%}
    No-blend panel — shown when there is no ?blend= param, or the blend isn't found.
    Matches the prototype's wb-info wb-largepanel structure.
  {%- endcomment -%}
  <div id="wb-noblend-panel" class="wb-info wb-largepanel" style="display:none">
    <p class="wb-noblend-heading">Choose how to fill it&hellip;</p>
    <ul>
      <li>Craft <a href="{{ lab_url | default: '/pages/the-lab' }}">your own whisky</a></li>
      <li>Label a <a href="{{ malts_url | default: '/collections/single-malts' }}">single malt</a></li>
      <li>Check our <a href="{{ drams_url | default: '/pages/perfect-drams' }}">perfect drams</a></li>
    </ul>
    <div class="wb-noblend-divider"><span>or</span></div>
    <p class="wb-noblend-codelabel">Already have a blend code?</p>
    <div class="wb-noblend-form">
      <input
        type="text"
        id="wb-blend-code-input"
        placeholder="e.g. WB000042"
        maxlength="10"
        autocomplete="off"
        autocapitalize="characters"
      />
      <button class="wb-button wb-primary-button" id="wb-blend-code-go" type="button" disabled>&rarr;</button>
    </div>
  </div>

</div>

<script src="{{ 'wb-blend-product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "WB - Blend Product",
  "tag": "section",
  "class": "section wb-banded",
  "settings": [
    {
      "type": "text",
      "id": "api_base_url",
      "label": "App API base URL",
      "info": "Same value as the Blending Lab section — no trailing slash. E.g. https://lab.whiskyblender.com"
    },
    {
      "type": "url",
      "id": "lab_url",
      "label": "Blending Lab page URL",
      "info": "Used in the recipe (Change) link and the no-blend panel."
    },
    {
      "type": "url",
      "id": "single_malts_url",
      "label": "Single malts collection URL",
      "info": "Optional — shown in the no-blend panel."
    },
    {
      "type": "url",
      "id": "perfect_drams_url",
      "label": "Perfect Drams page URL",
      "info": "Optional — shown in the no-blend panel."
    }
  ],
  "presets": [
    {
      "name": "WB - Blend Product"
    }
  ]
}
{% endschema %}
