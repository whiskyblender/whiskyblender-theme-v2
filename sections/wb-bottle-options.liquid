{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{{ 'wb-bottle-options.css' | asset_url | stylesheet_tag }}

<div class="wb-container wb-padding">

  <div class="wb-bottle-options-header">
    <h1 class="wb-bottle-options-title">{{ section.settings.heading | default: "Now choose how you want to bottle your whisky…" }}</h1>
    <p class="wb-bottle-options-phrase" id="wb-scottish-phrase"></p>
  </div>

  <ul class="wb-cards wb-bottle-cards" id="wb-bottle-list">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product != blank -%}
        {%- assign sold_out = true -%}
        {%- for variant in product.variants -%}
          {%- if variant.available -%}
            {%- assign sold_out = false -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        <li class="wb-bottle-option{% if sold_out %} wb-bottle-sold-out{% endif %}"
            {{ block.shopify_attributes }}>
          <a
            class="wb-bottle-option-link"
            href="{{ product.url }}"
            data-product-url="{{ product.url }}"
            {% if sold_out %}aria-disabled="true"{% endif %}
          >
            {%- if product.featured_image -%}
              <div class="wb-bottle-image">
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="600"
                  height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
                  loading="lazy"
                >
              </div>
            {%- endif -%}

            <div class="wb-bottle-details">
              <h2 class="wb-bottle-name">{{ product.title }}</h2>
              <p class="wb-bottle-price">
                {%- if sold_out -%}
                  Sold out
                {%- else -%}
                  From {{ product.price_min | money }}
                {%- endif -%}
              </p>
            </div>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

</div>

<script src="{{ 'wb-bottle-options.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "WB - Bottle Options",
  "tag": "section",
  "class": "section wb-first-item",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Now choose how you want to bottle your whisky…"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Bottle option",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB - Bottle Options"
    }
  ]
}
{% endschema %}
