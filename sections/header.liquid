{% comment %}
  wb-texture.webp is 1600px and 142 KB. Phones get an 800px copy from Shopify's CDN (45 KB),
  which looks the same at phone size; wider screens keep the full texture. footer.liquid has
  the same rule: keep the two in step, or a phone downloads the texture twice.
{% endcomment %}
<style>
  #wb-header .wb-container { background-image: url({{ 'wb-texture.webp' | asset_url }}&width=800); }
  @media screen and (min-width: 768px) {
    #wb-header .wb-container { background-image: url({{ 'wb-texture.webp' | asset_url }}); }
  }
</style>
<header id="wb-header">
  <div class="wb-container">
    <a href="{{ routes.root_url }}" id="wb-logo" style="background-image: url({{"wb-logo-white.svg" | asset_url }})"
      >Whisky Blender</a
    >
    <div class="wb-byline">
      <div class="wb-left-byline"><span class="wb-hide-onmobile">Bothwell, </span>Scotland</div>
      <div class="wb-right-byline">Est<span class="wb-hide-onmobile">ablished</span> 2011</div>
    </div>
  </div>
</header>
<nav id="wb-nav">
  <ul class="wb-topnav">
    {%- for link in section.settings.menu.links -%}
      <li>
        <a
          href="{{ link.url }}"
          {% if link.active %}
            class="wb-active-page"
          {% endif %}
        >
          {{ link.title }}
        </a>
      </li>
    {%- endfor -%}
    <li>
      <ul class="wb-navicons">
        <li>
          <a href="{{ routes.search_url }}"><img src="{{ 'wb-search-white.svg' | asset_url }}" alt="Search" width="16" height="16"></a>
        </li>
        <li>
          <a href="{{ routes.cart_url }}"><img src="{{"wb-basket-white.svg" | asset_url }}" alt="Basket" width="16" height="16" id="cart-icon-bubble">
          {%- if cart != empty -%}
            <div class="cart-count-bubble wb-cart-count-bubble wb-background-red wb-darker">
              {%- if cart.item_count < 100 -%}
                <span aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>
        </li>
        <li>
          <a href="{{ routes.account_url }}"><img src="{{"wb-account-white.svg" | asset_url }}" alt="Account" width="16" height="16"></a>
        </li>
      </ul>
    </li>
  </ul>
</nav>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "max_blocks": 3,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
