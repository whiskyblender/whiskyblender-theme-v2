{%- comment -%}
  Per-collection effect: set metafield custom.page_effect on the collection
  (values: confetti, balloons, snow, none). Falls back to section setting.
{%- endcomment -%}
{%- assign effect = collection.metafields.custom.page_effect | default: section.settings.default_effect -%}

{%- if effect == 'confetti' -%}

{{ 'confetti.min.js' | asset_url | script_tag }}
<script>
(function () {
  function run() {
    if (typeof confetti !== 'undefined' && typeof confetti.start === 'function') {
      confetti.start(5000);
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }
})();
</script>

{%- elsif effect == 'balloons' -%}

<style>
#wb-balloon-stage{position:fixed;left:0;bottom:0;width:100%;height:100vh;pointer-events:none;z-index:9999;overflow:visible}
.wb-balloon{position:absolute;bottom:0}
.wb-balloon-inner{transform-origin:bottom center}
.wb-balloon-body{width:var(--wb-bs);height:calc(var(--wb-bs)*1.22);border-radius:50% 50% 50% 50%/55% 55% 45% 45%;background:var(--wb-bc);position:relative;box-shadow:inset -5px -8px 0 rgba(0,0,0,.1)}
.wb-balloon-body::before{content:'';position:absolute;top:18%;left:18%;width:26%;height:18%;border-radius:50%;background:rgba(255,255,255,.38);transform:rotate(-40deg)}
.wb-balloon-body::after{content:'';position:absolute;bottom:-7px;left:50%;transform:translateX(-50%);border-left:4px solid transparent;border-right:4px solid transparent;border-top:8px solid var(--wb-bc)}
.wb-balloon-string{width:1px;height:55px;background:rgba(80,80,80,.28);margin:0 auto}
@keyframes wb-balloon-rise{from{transform:translateY(0)}to{transform:translateY(-120vh)}}
@keyframes wb-balloon-sway{from{transform:rotate(-8deg)}to{transform:rotate(8deg)}}
</style>
<div id="wb-balloon-stage" aria-hidden="true"></div>
<script>
(function () {
  var stage = document.getElementById('wb-balloon-stage');
  if (!stage) return;
  var colors = ['#ff6b6b','#ff69b4','#ffd166','#74b9ff','#a29bfe','#55efc4','#fd79a8','#fdcb6e','#6c5ce7'];
  function spawn() {
    var color = colors[Math.floor(Math.random() * colors.length)];
    var size  = Math.round(Math.random() * 22 + 36) + 'px';
    var left  = (Math.random() * 86 + 5).toFixed(1) + '%';
    var dur   = (Math.random() * 4 + 7).toFixed(1) + 's';
    var sway  = (Math.random() * 2 + 1.6).toFixed(1) + 's';
    var el = document.createElement('div');
    el.className = 'wb-balloon';
    el.style.left = left;
    el.style.animation = 'wb-balloon-rise ' + dur + ' linear forwards';
    var inner = document.createElement('div');
    inner.className = 'wb-balloon-inner';
    inner.style.animation = 'wb-balloon-sway ' + sway + ' ease-in-out infinite alternate';
    var bdy = document.createElement('div');
    bdy.className = 'wb-balloon-body';
    bdy.style.setProperty('--wb-bc', color);
    bdy.style.setProperty('--wb-bs', size);
    var str = document.createElement('div');
    str.className = 'wb-balloon-string';
    inner.appendChild(bdy);
    inner.appendChild(str);
    el.appendChild(inner);
    stage.appendChild(el);
    setTimeout(function () { el.remove(); }, parseFloat(dur) * 1000 + 600);
  }
  for (var i = 0; i < 14; i++) {
    (function (d) { setTimeout(spawn, d); })(Math.random() * 10000);
  }
})();
</script>

{%- elsif effect == 'snow' -%}

<style>
#wb-snow-canvas{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999}
</style>
<canvas id="wb-snow-canvas" aria-hidden="true"></canvas>
<script>
(function () {
  var canvas = document.getElementById('wb-snow-canvas');
  var ctx = canvas.getContext('2d');
  var W, H, flakes = [];
  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);
  for (var i = 0; i < 100; i++) {
    flakes.push({
      x: Math.random() * window.innerWidth,
      y: Math.random() * window.innerHeight,
      r: Math.random() * 3 + 1,
      d: Math.random() * 80 + 10,
      speed: Math.random() * 0.8 + 0.3,
      sway: Math.random() * 0.4 - 0.2
    });
  }
  var angle = 0;
  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = 'rgba(255,255,255,0.82)';
    ctx.beginPath();
    angle += 0.006;
    for (var i = 0; i < flakes.length; i++) {
      var f = flakes[i];
      ctx.moveTo(f.x, f.y);
      ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2, true);
      f.y += Math.cos(angle + f.d) * 0.5 + f.speed;
      f.x += f.sway + Math.sin(angle) * 0.2;
      if (f.y > H + 5) { f.y = -f.r; f.x = Math.random() * W; }
      if (f.x > W + 5) f.x = -5;
      if (f.x < -5) f.x = W + 5;
    }
    ctx.fill();
    requestAnimationFrame(draw);
  }
  draw();
})();
</script>

{%- endif -%}

{% schema %}
{
  "name": "WB - Page Effect",
  "settings": [
    {
      "type": "paragraph",
      "content": "Set the effect per collection using the metafield custom.page_effect (values: confetti, balloons, snow, none). The dropdown below is the fallback default for all collections on this template."
    },
    {
      "type": "select",
      "id": "default_effect",
      "label": "Default effect (all collections)",
      "options": [
        { "value": "none",     "label": "None" },
        { "value": "confetti", "label": "Confetti" },
        { "value": "balloons", "label": "Balloons" },
        { "value": "snow",     "label": "Snow" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "WB - Page Effect"
    }
  ]
}
{% endschema %}
