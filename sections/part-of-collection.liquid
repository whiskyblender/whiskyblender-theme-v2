<p class="wb-collection-ref">
  {%- assign excluded_handles = section.settings.excluded_collections | split: ',' -%}
  {%- assign filtered_count = 0 -%}
  {%- for collection in product.collections -%}
    {%- assign is_excluded = false -%}
    {%- for handle in excluded_handles -%}
      {%- assign trimmed_handle = handle | strip -%}
      {%- if collection.handle == trimmed_handle -%}
        {%- assign is_excluded = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- unless is_excluded -%}
      {%- assign filtered_count = filtered_count | plus: 1 -%}
    {%- endunless -%}
  {%- endfor -%}

  {%- if filtered_count > 0 -%}
    Part of the &nbsp;
    {%- assign output_count = 0 -%}
    {%- for collection in product.collections -%}
      {%- assign is_excluded = false -%}
      {%- for handle in excluded_handles -%}
        {%- assign trimmed_handle = handle | strip -%}
        {%- if collection.handle == trimmed_handle -%}
          {%- assign is_excluded = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless is_excluded -%}
        {%- assign output_count = output_count | plus: 1 -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        {%- if output_count < filtered_count -%}
          {%- assign next_is_last = filtered_count | minus: output_count -%}
          {%- if next_is_last == 1 %} & {% else %}, {% endif -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}
    &nbsp;collection{% if filtered_count > 1 %}s{% endif %}
  {%- endif -%}
</p>

{% schema %}
{
  "name": "Part of collection",
  "settings": [
    {
      "type": "text",
      "id": "excluded_collections",
      "label": "Excluded collection handles",
      "default": "promoted",
      "info": "Enter collection handles to exclude, separated by commas (e.g., promoted, hidden, internal)"
    }
  ],
  "presets": [
    {
      "name": "Part of collection"
    }
  ]
}
{% endschema %}
