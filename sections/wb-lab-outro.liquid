    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Trust strip"
    },
    {
      "type": "text",
      "id": "trust_line_1",
      "label": "Line 1",
      "default": "Product of Scotland — your recipe, independently bottled"
    },
    {
      "type": "text",
      "id": "trust_line_2",
      "label": "Line 2",
      "default": "Free UK delivery — no minimum spend"
    },
    {
      "type": "text",
      "id": "trust_line_3",
      "label": "Line 3",
      "default": "Arrives gift-ready — no receipt in package"
    },
    {
      "type": "header",
      "content": "Returning customer"
    },
    {
      "type": "text",
      "id": "returning_heading",
      "label": "Heading",
      "default": "Already made one?"
    },
    {
      "type": "text",
      "id": "returning_sub",
