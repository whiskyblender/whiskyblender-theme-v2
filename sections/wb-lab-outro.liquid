  ],
  "presets": [
    {
      "name": "WB Lab Outro",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "heading": "You blend & name it",
            "body": "Create your blend, pick a bottle."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "We hand-make it in Scotland",
            "body": "Our blenders make your recipe by hand."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Dispatched in ~48 hours",
            "body": "Packed and sent straight to your door."
          }
        }
      ]
    }
  ]
}
