      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB Lab Outro",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "heading": "You blend & name it",
            "body": "Pick your casks, name it, design the label."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "We hand-make it in Scotland",
            "body": "Our blenders make your recipe by hand."
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Dispatched in ~48 hours",
            "body": "Arrives gift-ready — no receipt in the box."
          }
        }
      ]
    }
  ]
}
{% endschema %}
