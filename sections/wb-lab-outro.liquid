{%- comment -%}
  wb-lab-outro.liquid — the bottom of the Lab page (below the builder).

  Replaces the old teardown panel baked into wb-lab.liquid (still there, gated
  on teardown_heading / teardown_content / bottle_options_url being non-blank —
  blanked on wb_lab_section in page.lab-page.json). To revert: refill those
  settings and drop wb_lab_outro from the template order.

  Everything here is RECYCLED from existing site patterns — no new type styles:
    - heading + intro      → .wb-small-heading + plain paragraph
    - step panels          → wb-how-it-works-home step panels, toned down (2026-09-15) so
                             they don't compete with the builder: small uppercase "Step N"
                             label (.wb-noblend-divider treatment), 18px title, 16px body,
                             wb-background-*-opacity, 8px radius
    - trust strip          → snippets/wb-trust-strip.liquid, the SAME snippet the product
                             pages render (slug_override gives the custom-blend wording)
    - two lower panels     → neutral trust-strip surface (#fafafa, 1px border), 18px
                             title, 16px body, full-width .wb-button
    - blend-code entry     → .wb-noblend-form from wb-custom.css (as the old teardown)

  Layout: everything stacks on mobile. Lower panels go 2-up from 768px, steps go
  3-up from 1024px, trust-strip lines go into a single row from 1200px.

  No `tag` in the schema — Shopify's default <div class="shopify-section"> wrapper
  keeps the banding nth-of-type count intact (see wb-how-it-works-home).
{%- endcomment -%}

{{ 'wb-custom.css' | asset_url | stylesheet_tag }}
{{ 'wb-products.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="wb-lab-outro">
  <div class="wb-container">
    <div class="wb-padding section-{{ section.id }}-padding">

      {%- if section.settings.heading != blank -%}
        <h2 class="wb-small-heading wb-lab-outro__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="wb-lab-outro__intro">{{ section.settings.intro }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        {%- assign step_colours = 'green,brown,blue' | split: ',' -%}
        <ol class="wb-lab-outro__steps" role="list">
          {%- for block in section.blocks -%}
            {%- assign colour_index = forloop.index0 | modulo: 3 -%}
            {%- assign colour = step_colours[colour_index] -%}
            <li class="wb-lab-outro__step wb-lab-outro__step--{{ colour }} wb-background-{{ colour }}-opacity" {{ block.shopify_attributes }}>
              <p class="wb-lab-outro__step-num">Step {{ forloop.index }}</p>
              {%- if block.settings.heading != blank -%}
                <h3 class="wb-lab-outro__step-title">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <p class="wb-lab-outro__step-body">{{ block.settings.body | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.image != blank -%}
        <div class="wb-lab-outro__image">
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(max-width: 1200px) 90vw, 1120px', alt: section.settings.heading }}
        </div>
      {%- endif -%}

      {%- if section.settings.show_trust_strip -%}
        <div class="wb-lab-outro__trust">
          {%- render 'wb-trust-strip', slug_override: 'customblend' -%}
        </div>
      {%- endif -%}

      {%- assign show_returning = false -%}
      {%- if section.settings.bottle_options_url != blank -%}{%- assign show_returning = true -%}{%- endif -%}
      {%- assign show_hiw = false -%}
      {%- if section.settings.how_it_works_text != blank and section.settings.how_it_works_url != blank -%}{%- assign show_hiw = true -%}{%- endif -%}

      {%- if show_returning or show_hiw -%}
        <div class="wb-lab-outro__panels">
          {%- if show_returning -%}
            <div class="wb-lab-outro__panel">
              <div>
                {%- if section.settings.returning_heading != blank -%}
                  <h3 class="wb-lab-outro__panel-title">{{ section.settings.returning_heading | escape }}</h3>
                {%- endif -%}
                {%- if section.settings.returning_sub != blank -%}
                  <p class="wb-lab-outro__panel-body">{{ section.settings.returning_sub | escape }}</p>
                {%- endif -%}
              </div>
              <div class="wb-noblend-form wb-lab-outro__action">
                <input
                  type="text"
                  id="wb-lab-outro-code-input"
                  placeholder="WB123456"
                  maxlength="10"
                  autocomplete="off"
                  autocapitalize="characters"
                  aria-label="Blend code"
                />
                <button class="wb-button wb-primary-button" id="wb-lab-outro-code-go" disabled>Go</button>
              </div>
            </div>
          {%- endif -%}

          {%- if show_hiw -%}
            <div class="wb-lab-outro__panel">
              <div>
                {%- if section.settings.how_it_works_heading != blank -%}
                  <h3 class="wb-lab-outro__panel-title">{{ section.settings.how_it_works_heading | escape }}</h3>
                {%- endif -%}
                {%- if section.settings.how_it_works_body != blank -%}
                  <p class="wb-lab-outro__panel-body">{{ section.settings.how_it_works_body | escape }}</p>
                {%- endif -%}
              </div>
              <div class="wb-buttons wb-lab-outro__action">
                <a href="{{ section.settings.how_it_works_url }}" class="wb-button">{{ section.settings.how_it_works_text | escape }}</a>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

<style>
  .wb-lab-outro { background: #ffffff; border-top: 1px solid #eeeeee; }

  /* Heading + intro: same as wb-how-it-works-home */
  .wb-lab-outro__heading { margin-bottom: 8px; }
  .wb-lab-outro__intro { margin-top: 0; max-width: 620px; }

  /* Steps: wb-how-it-works-home step panels */
  .wb-lab-outro__steps {
    display: flex;
    flex-direction: column;
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
  }
  .wb-lab-outro__step {
    border-radius: 8px;
    padding: 24px;
    margin: 0;
  }
  /* Small uppercase label (same treatment as .wb-noblend-divider) instead of
     the big poster-font number, so the steps don't compete with the builder. */
  .wb-lab-outro__step-num {
    color: #b88d60;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.2;
    margin: 0 0 8px;
  }
  .wb-lab-outro__step--green .wb-lab-outro__step-num { color: #129776; }
  .wb-lab-outro__step--brown .wb-lab-outro__step-num { color: #a56437; }
  .wb-lab-outro__step--blue  .wb-lab-outro__step-num { color: #3b5ea1; }
  .wb-lab-outro__step-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 8px;
    color: #111;
  }
  .wb-lab-outro__step-body {
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  .wb-lab-outro__image {
    margin: 20px 0 0;
    border-radius: 8px;
    overflow: hidden;
  }
  .wb-lab-outro__image img { display: block; width: 100%; height: auto; }

  /* Trust strip: the product-page snippet, untouched — only its outer spacing
     (and, on wide screens, its line direction) changes here. */
  .wb-lab-outro__trust .wb-trust-strip { margin: 20px 0 0; }

  /* Lower panels: wb-how-it-works-home CTA panel */
  .wb-lab-outro__panels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 20px;
  }
  /* Neutral panels — same surface as the trust strip (wb-products.css) */
  .wb-lab-outro__panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    row-gap: 20px;
    border: 1px solid rgba(0, 0, 0, 0.09);
    border-radius: 8px;
    background: #fafafa;
    padding: 24px;
  }
  .wb-lab-outro__panel-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 8px;
    color: #111;
  }
  /* Same size as the step bodies above, so the section reads as one set */
  .wb-lab-outro__panel-body {
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }
  .wb-lab-outro__action { margin: 0; }
  .wb-lab-outro__action .wb-button { margin: 0; }
  .wb-lab-outro__action.wb-buttons .wb-button { width: 100%; }
  .wb-lab-outro .wb-noblend-form input { min-width: 0; }

  @media screen and (min-width: 768px) {
    .wb-lab-outro__panels { grid-template-columns: 1fr 1fr; }
    .wb-lab-outro__step,
    .wb-lab-outro__panel { padding: 28px; }
  }

  @media screen and (min-width: 1024px) {
    .wb-lab-outro__steps { flex-direction: row; }
    .wb-lab-outro__step { flex: 1; }
  }

  @media screen and (min-width: 1200px) {
    .wb-lab-outro__trust .wb-trust-strip {
      max-width: none;
      flex-direction: row;
      justify-content: space-around;
      flex-wrap: wrap;
      column-gap: 24px;
    }
  }
</style>

{%- if section.settings.bottle_options_url != blank -%}
<script>
(function () {
  var input = document.getElementById('wb-lab-outro-code-input');
  var btn   = document.getElementById('wb-lab-outro-code-go');
  if (!input || !btn) return;
  input.addEventListener('input', function () {
    btn.disabled = input.value.trim().length < 6;
  });
  function go() {
    var code = input.value.trim();
    if (code.length < 6) return;
    window.location.href = {{ section.settings.bottle_options_url | url | json }} + '?blend=' + encodeURIComponent(code);
  }
  btn.addEventListener('click', go);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') go();
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "WB Lab Outro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
