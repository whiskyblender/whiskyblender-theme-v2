<script type="application/json" id="wb-sm-variants-data">
  [
    {%- for variant in product.variants -%}
      {"id":{{ variant.id }},"title":{{ variant.title | json }}}
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<div id="wb-single-malt-loader"
  data-template="{{ template }}"
  data-product-title="{{ product.title | escape }}"
  data-distillery="{{ product.metafields.custom.distilled | escape }}"
  data-product-slug="{{ product.metafields.custom.label_product_slug | default: 'singlemalt' | escape }}"
  data-bottle-size="{{ product.metafields.custom.bottle_size | escape }}"
  data-label-page="/pages/label"
  data-cdn="{{ 'wb-label.css' | asset_url | split: 'wb-label.css' | first }}"
  data-av="14"
  data-bars-url="{{ 'sample50cl-bars.webp' | asset_url }}"
  data-crops-url="{{ 'crops50.png' | asset_url }}"
></div>

{{ 'wb-preview.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wb-single-malt.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "WB - Single Malt Loader",
  "settings": []
}
{% endschema %}
