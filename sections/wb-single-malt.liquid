<script type="application/json" id="wb-sm-variants-data">
  [
    {%- for variant in product.variants -%}
      {"id":{{ variant.id }},"title":{{ variant.title | json }}}
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<div id="wb-single-malt-loader"
  data-product-title="{{ product.title | escape }}"
  data-label-page="/pages/label"
></div>

{{ 'wb-single-malt.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "WB - Single Malt Loader",
  "settings": []
}
{% endschema %}
