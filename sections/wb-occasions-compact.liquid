{%- comment -%}
  Compact occasions strip — the homepage version.

  The full `wb-occasions` section (six large cards) stays on the Gifts page
  untouched; this is a smaller four-card version.

  Two things here are deliberate and easy to break:

  1. NO `tag` or `class` in the schema. Shopify then wraps this in its default
     `<div class="shopify-section">`, which is what the banding system counts:
     `.shopify-section:nth-of-type(even) section.wb-banded` in wb-base.css.
     `nth-of-type` counts within an element type, so emitting a `<section>`
     wrapper instead drops this out of the div sequence and flips the banding
     of every section below it.

  2. It reuses the real card classes — `.wb-card-image`, `.wb-card-details`,
     `.wb-small-heading`, `.wb-emoji` — so it inherits the Gifts card component
     (including the emoji lift-and-rotate on hover) rather than reimplementing
     it. The scoped block below only scales it down. `.wb-card-details` must
     stay `position: relative` or the absolutely-positioned emoji anchors to the
     wrong box.

  Columns come from `wb-productsgrid wb-tightergrid`, matching the homepage
  product cards: 2 per row on mobile, 4 from 768px.
{%- endcomment -%}

<section class="wb-banded">
  <div class="wb-container">
    <div class="wb-padding">
      {%- if section.settings.heading != blank -%}
        <h2 class="wb-medium-heading wb-occ-compact-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="wb-occ-compact-intro">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="wb-productsgrid wb-tightergrid wb-occ-compact" role="list">
          {%- for block in section.blocks -%}
            <li
              class="{% if settings.animations_reveal_on_scroll %}scroll-trigger animate--slide-in{% endif %}"
              data-cascade
              {{ block.shopify_attributes }}
            >
              <a href="{{ block.settings.link | default: '#' }}">
                <div class="wb-card-image">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '200, 300, 400, 600',
                        sizes: '(max-width: 767px) 45vw, 22vw',
                        alt: block.settings.heading
                    }}
                  {%- endif -%}
                </div>
                <div class="wb-card-details">
                  <h3 class="wb-small-heading">{{ block.settings.heading | escape }}</h3>
                  {%- if block.settings.emoji != blank -%}
                    <span class="wb-emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
                  {%- endif -%}
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .wb-occ-compact-heading { margin-bottom: 8px; }
  .wb-occ-compact-intro { margin-top: 0; max-width: 620px; }

  /* Columns come from .wb-tightergrid — don't set flex/width here, or this
     stops matching the product cards. */
  .wb-occ-compact { margin-top: 24px; }

  /* Card chrome, copied from .wb-main-cards.wb-cards li — this grid isn't
     .wb-cards (it uses the product grid for columns), so the white card
     background that backs the title has to be restated here. */
  .wb-occ-compact li {
    position: relative;
    background-color: #ffffff;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid transparent;
    transition: all 0.4s;
  }

  .wb-occ-compact li:hover { border-color: #999999; }

  .wb-occ-compact a {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Fixed height, not a square — same approach as the Gifts cards, scaled for
     a 2-up mobile / 4-up desktop grid. */
  .wb-occ-compact .wb-card-image {
    height: 34vw;
    overflow: hidden;
    position: relative;
  }

  .wb-occ-compact .wb-card-image img {
    width: 100%;
    height: 100% !important;
    object-fit: cover;
  }

  /* Title sits on the white card body below the image. The emoji is absolutely
     positioned against .wb-card-details with a negative top, so it lifts up
     over the image — clipped by the card's overflow:hidden, as on Gifts. */
  .wb-occ-compact .wb-card-details {
    padding: 16px 16px;
  }

  /* Raleway rather than the TrimPoster display face .wb-small-heading normally
     carries. That utility also sets font-weight: 100, which Raleway isn't
     loaded at (the site loads 300-700) — so the weight has to be restated or
     the browser synthesises a hairline. */
  .wb-occ-compact .wb-small-heading {
    font-family: 'Raleway', sans-serif;
    font-weight: 700;
    font-size: clamp(16px, 5.4vw, 24px);
    line-height: 1.25;
    margin: 0;
  }

  .wb-occ-compact .wb-card-details .wb-emoji {
    top: -46px;
    right: 12px;
    font-size: 78px;
    transform: rotate(20deg);
  }

  @media screen and (min-width: 768px) {
    .wb-occ-compact { margin-top: 28px; }
    .wb-occ-compact .wb-card-image { height: 16vw; }
    .wb-occ-compact .wb-small-heading { font-size: clamp(17px, 1.9vw, 26px); }

    .wb-occ-compact .wb-card-details .wb-emoji {
      top: -56px;
      right: 14px;
      font-size: 100px;
      transform: rotate(0deg);
      transition: all 0.4s;
    }

    /* The global hover lift is scoped to .wb-cards, which this grid is not,
       so it's restated at the smaller scale. */
    .wb-occ-compact li:hover .wb-emoji {
      top: -68px;
      right: 20px;
      transform: rotate(10deg);
    }
  }
</style>

{% schema %}
{
  "name": "WB Occasions (compact)",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "A smaller four-card version of the occasions strip, for the homepage. The full six-card section (WB Occasions) is used on the Gifts page. Columns follow the homepage product cards: 2 per row on mobile, 4 from tablet up."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For special occasions"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "A bottle of Scotch that's genuinely theirs — for the moments worth marking."
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Weddings"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square works best — images are cropped to a square."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji",
          "info": "Optional. Sits above the card corner and lifts on hover, as on the Gifts page."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB Occasions (compact)",
      "blocks": [
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" }
      ]
    }
  ]
}
{% endschema %}
