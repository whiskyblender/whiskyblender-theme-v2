{%- comment -%}
  Compact occasions strip — the homepage version.

  The full `wb-occasions` section (six large cards) stays on the Gifts page
  untouched; this is a smaller four-card version so the homepage points at the
  occasion collections without handing over that much space.

  The grid deliberately reuses `wb-productsgrid wb-tightergrid` rather than
  defining its own columns, so it matches the homepage product cards exactly —
  2 per row on mobile, 4 from 768px — and stays in step automatically if that
  grid is ever changed again.
{%- endcomment -%}

<section class="wb-banded">
  <div class="wb-container">
    <div class="wb-padding">
      {%- if section.settings.heading != blank -%}
        <h2 class="wb-medium-heading wb-occ-compact-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="wb-occ-compact-intro">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="wb-productsgrid wb-tightergrid wb-occ-compact" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <a class="wb-occ-compact__link" href="{{ block.settings.link | default: '#' }}">
                <span class="wb-occ-compact__media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '200, 300, 400, 600',
                        sizes: '(max-width: 767px) 45vw, 22vw',
                        alt: block.settings.heading,
                        class: 'wb-occ-compact__img'
                    }}
                  {%- else -%}
                    <span class="wb-occ-compact__placeholder"></span>
                  {%- endif -%}
                </span>
                <span class="wb-occ-compact__label">
                  {%- if block.settings.emoji != blank -%}
                    <span class="wb-occ-compact__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
                  {%- endif -%}
                  {{ block.settings.heading | escape }}
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .wb-occ-compact-heading { margin-bottom: 8px; }
  .wb-occ-compact-intro { margin-top: 0; max-width: 620px; }

  /* Columns come from .wb-tightergrid — don't set flex/width here, or this
     stops matching the product cards. */
  .wb-occ-compact { margin-top: 24px; }

  .wb-occ-compact__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .wb-occ-compact__media {
    display: block;
    overflow: hidden;
    border-radius: 6px;
    aspect-ratio: 1 / 1;
    background-color: #efefef;
  }

  .wb-occ-compact__img,
  .wb-occ-compact__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .wb-occ-compact__link:hover .wb-occ-compact__img { transform: scale(1.04); }

  .wb-occ-compact__label {
    display: block;
    margin-top: 10px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }

  .wb-occ-compact__emoji {
    margin-right: 6px;
  }

  @media screen and (min-width: 768px) {
    .wb-occ-compact { margin-top: 28px; }
    .wb-occ-compact__label { font-size: 16px; }
  }
</style>

{% schema %}
{
  "name": "WB Occasions (compact)",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "A smaller four-card version of the occasions strip, for the homepage. The full six-card section (WB Occasions) is used on the Gifts page. Columns follow the homepage product cards: 2 per row on mobile, 4 from tablet up."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For special occasions"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "A bottle of Scotch that's genuinely theirs — for the moments worth marking."
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Weddings"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square works best — images are cropped to a square."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji",
          "info": "Optional, shown before the heading."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB Occasions (compact)",
      "blocks": [
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" }
      ]
    }
  ]
}
{% endschema %}
