{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding wb-collection-copy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'page_header' -%}
            <h1 class="wb-large-heading">{{ page.title | escape }}</h1>
            <p>
              {{ page.content }}
            </p>

          {%- when 'wb_grid' -%}
            {%- assign grid_items = page.metafields.custom.grid_data.value -%}
            <div {{ block.shopify_attributes }}>
              <div class="wb-container">
                <div class="wb-padding">
                  {% render 'wb-grid-markup', grid_items: grid_items, design_mode: request.design_mode %}
                </div>
              </div>
            </div>

          {%- when 'landing_hero' -%}
            <div class="wb-overflow-hidden-x" {{ block.shopify_attributes }}>
              <div class="wb-container">
                {% render 'wb-landing-hero-markup',
                  video_file: block.settings.video_file,
                  background_image: block.settings.background_image,
                  title: block.settings.title,
                  description: block.settings.description,
                  primary_button_text: block.settings.primary_button_text,
                  primary_button_url: block.settings.primary_button_url,
                  secondary_button_text: block.settings.secondary_button_text,
                  secondary_button_url: block.settings.secondary_button_url
                %}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "WB Grid Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "page_header",
      "name": "Page header",
      "limit": 1,
      "settings": []
    },
    {
      "type": "wb_grid",
      "name": "WB Grid",
      "limit": 1,
      "settings": []
    },
    {
      "type": "landing_hero",
      "name": "WB - Landing Hero",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "video_file",
          "label": "Video filename",
          "info": "Optional. Upload video to assets folder and enter filename here. Leave empty to show static image instead."
        },
        {
          "type": "text",
          "id": "background_image",
          "label": "Background image filename",
          "default": "wb-whisky-bow.jpg",
          "info": "Fallback image shown while video loads, or main image if no video is set"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title text",
          "default": "Create something"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "Description text",
          "default": "When you're looking for that bottle of whisky nobody else has."
        },
        {
          "type": "text",
          "id": "primary_button_text",
          "label": "Primary button text",
          "default": "Create something"
        },
        {
          "type": "url",
          "id": "primary_button_url",
          "label": "Primary button URL"
        },
        {
          "type": "text",
          "id": "secondary_button_text",
          "label": "Secondary button text",
          "default": "Get a voucher"
        },
        {
          "type": "url",
          "id": "secondary_button_url",
          "label": "Secondary button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB Page",
      "blocks": [
        {
          "type": "page_header"
        },
        {
          "type": "wb_grid"
        }
      ]
    }
  ]
}
{% endschema %}
