{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}
{{ 'glide.core.css' | asset_url | stylesheet_tag }}
{{ 'glide.custom.css' | asset_url | stylesheet_tag }}
{{ 'glide.js' | asset_url | script_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding wb-collection-copy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'page_header' -%}
            <h1 class="wb-large-heading">{{ page.title | escape }}</h1>
            <p>
              {{ page.content }}
            </p>

          {%- when 'wb_grid' -%}
            {%- assign grid_items = page.metafields.custom.grid_data.value -%}
            <div {{ block.shopify_attributes }}>
              <div class="wb-container">
                <div class="wb-padding">
                  {% render 'wb-grid-markup', grid_items: grid_items, design_mode: request.design_mode %}
                </div>
              </div>
            </div>

          {%- when 'landing_hero' -%}
            {%- assign hero = page.metafields.custom.hero_details.value -%}
            <div class="wb-overflow-hidden-x" {{ block.shopify_attributes }}>
              <div class="wb-container">
                {% render 'wb-landing-hero-markup',
                  video_file: hero.video.value,
                  background_image: hero.image.value,
                  title: hero.title.value,
                  description: hero.subtitle.value,
                  primary_button_text: hero.primary_button_text.value,
                  primary_button_url: hero.primary_button_url.value,
                  secondary_button_text: hero.secondary_button_text.value,
                  secondary_button_url: hero.secondary_button_url.value
                %}
              </div>
            </div>

          {%- when 'image_reel' -%}
            {%- assign reel_images = page.metafields.custom.image_reel_data.value -%}
            <div class="wb-overflow-hidden-x" {{ block.shopify_attributes }}>
              <div class="wb-container">
                <div class="wb-padding">
                  <div class="glide wb-gifts">
                    <div class="glide__track" data-glide-el="track">
                      <ul class="glide__slides wb-giftphotos">
                        {%- for image in reel_images -%}
                          <li class="glide__slide wb-giftphoto">
                            <img
                              src="{{ image | asset_url }}"
                              alt="Reel photo"
                              width="200"
                              height="200"
                            >
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <script>
              document.addEventListener('DOMContentLoaded', function () {
                if (document.querySelector('.wb-gifts')) {
                  new Glide('.wb-gifts', {
                    type: 'carousel',
                    gap: 40,
                    perView: 5,
                    autoplay: 1,
                    animationDuration: 5000,
                    animationTimingFunc: 'linear',
                    hoverpause: true,
                    breakpoints: {
                      600: { perView: 3, gap: 20 },
                      768: { perView: 4, gap: 30 },
                    },
                  }).mount();
                }
              });
            </script>

          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>
              {{ block.settings.custom_liquid }}
            </div>

          {%- when 'richtext' -%}
            <div class="rte" {{ block.shopify_attributes }}>
              {{ block.settings.richtext }}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "WB Grid Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "page_header",
      "name": "Page header",
      "settings": []
    },
    {
      "type": "wb_grid",
      "name": "WB Grid",
      "settings": []
    },
    {
      "type": "landing_hero",
      "name": "WB - Landing Hero",
      "settings": []
    },
    {
      "type": "image_reel",
      "name": "WB - Image Reel",
      "limit": 1,
      "settings": []
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid",
          "info": "Add app snippets or other Liquid code to create custom content."
        }
      ]
    },
    {
      "type": "richtext",
      "name": "Rich Text",
      "settings": [
        {
          "type": "richtext",
          "id": "richtext",
          "label": "Text",
          "default": "<p>Add your text here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB Page",
      "blocks": [
        {
          "type": "page_header"
        },
        {
          "type": "wb_grid"
        }
      ]
    }
  ]
}
{% endschema %}
