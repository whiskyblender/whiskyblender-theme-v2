{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{%- assign wb_has_image_reel = false -%}
{%- for wb_block in section.blocks -%}
  {%- if wb_block.type == 'image_reel' -%}{%- assign wb_has_image_reel = true -%}{%- endif -%}
{%- endfor -%}
{%- if wb_has_image_reel -%}
  {{ 'glide.core.css' | asset_url | stylesheet_tag }}
  {{ 'glide.custom.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'glide.js' | asset_url }}" defer></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'page_header' -%}
      <div class="wb-container">
        <div class="wb-padding wb-collection-copy">
          <h1 class="wb-large-heading">{{ page.title | escape }}</h1>
          <!-- WBDEBUG count={{ section.blocks.size }} types={% for b in section.blocks %}[{{ b.type }}]{% endfor %} -->
          <p>
            {{ page.content }}
          </p>

        {%- when 'wb_grid' -%}
          {%- assign grid_items = page.metafields.custom.grid_data.value -%}
                {% render 'wb-grid-markup', grid_items: grid_items, design_mode: request.design_mode %}
        </div>
      </div>
        {%- when 'landing_hero' -%}
          {%- assign hero_poster_file = nil -%}
          {%- if page.handle == 'about' -%}{%- assign hero_poster_file = 'wb-cask-heids.jpg' -%}{%- endif -%}
          {%- if page.handle == 'gifts' -%}{%- assign hero_poster_file = 'wb-whisky-bow.jpg' -%}{%- endif -%}
          <div class="wb-container">
            {%- assign hero = page.metafields.custom.hero_details.value -%}
            <div class="wb-overflow-hidden-x" {{ block.shopify_attributes }}>
                {% render 'wb-landing-hero-markup',
                  video_file: hero.video.value,
                  background_image: hero.image.value,
                  poster_file: hero_poster_file,
                  title: hero.title.value,
                  description: hero.subtitle.value,
                  primary_button_text: hero.primary_button_text.value,
                  primary_button_url: hero.primary_button_url.value,
                  secondary_button_text: hero.secondary_button_text.value,
                  secondary_button_url: hero.secondary_button_url.value
                %}
            </div>
          </div>

        {%- when 'image_reel' -%}
          <div class="wb-banded wb-overflow-hidden-x">
          {%- assign reel_images = page.metafields.custom.image_reel_data.value -%}
          {% render 'wb-image-reel-markup', reel_images: reel_images %}
          </div>

        {%- when 'custom_liquid' -%}
          <div class="wb-container">
            <div {{ block.shopify_attributes }} class="wb-padding">
              {{ block.settings.custom_liquid }}
            </div>
          </div>

        {%- when 'richtext' -%}
          <div {{ block.shopify_attributes }}>
            {{ block.settings.richtext }}
          </div>

        {%- when 'info_strip' -%}
          {%- comment -%}
            Renders inside the page_header block's open .wb-padding.wb-collection-copy
            (that block deliberately leaves its wrappers open — wb_grid closes them).
            .wb-padding is already position:relative, so the strip anchors to it.
          {%- endcomment -%}
          {% style %}
            .wb-info-strip {
              margin: 28px 0 0;
              padding: 20px;
              border-radius: 8px;
            }
            .wb-info-strip__heading {
              font-size: 16px;
              font-weight: 700;
              line-height: 1.3;
              margin: 0;
            }
            .wb-info-strip__body {
              font-size: 14px;
              line-height: 1.5;
              margin: 6px 0 0;
              color: #5a5045;
            }
            .wb-info-strip__prices {
              display: flex;
              gap: 28px;
              margin: 10px 0;
            }
            .wb-info-strip__price {
              margin: 0;
            }
            .wb-info-strip__price dt {
              font-size: 11px;
              letter-spacing: 0.1em;
              text-transform: uppercase;
              color: #6d6154;
            }
            .wb-info-strip__price dd {
              margin: 2px 0 0;
              font-size: 24px;
              font-weight: 700;
              line-height: 1;
            }

            @media screen and (min-width: 600px) {
              .wb-info-strip {
                display: flex;
                justify-content: space-between;
                align-items: center;
              }

              .wb-info-strip__prices {
                margin: -4px 10px 10px 0;
              }

              .wb-info-strip__heading {
                margin-left: 10px;
              }
            }

            @media screen and (min-width: 1200px) {
              .wb-info-strip {
                position: absolute;
                top: 60px;
                right: 40px;
                width: 290px;
                margin-top: 0;
                padding: 40px;
                align-items: flex-start;
                flex-direction: column;
              }
            .wb-info-strip__heading {
              font-size: 20px;
              line-height: 1.3;
              margin: 0 0 10px 0;
            }
            }
          {% endstyle %}
          <div class="wb-info-strip wb-background-brown" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <p class="wb-info-strip__heading">{{ block.settings.heading | escape }}</p>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="wb-info-strip__body">{{ block.settings.body | escape }}</p>
            {%- endif -%}
            {%- if block.settings.size_1_price != blank or block.settings.size_2_price != blank -%}
              <dl class="wb-info-strip__prices">
                {%- if block.settings.size_1_price != blank -%}
                  <div class="wb-info-strip__price">
                    <dt>{{ block.settings.size_1_label | escape }}</dt>
                    <dd>{{ block.settings.size_1_price | escape }}</dd>
                  </div>
                {%- endif -%}
                {%- if block.settings.size_2_price != blank -%}
                  <div class="wb-info-strip__price">
                    <dt>{{ block.settings.size_2_label | escape }}</dt>
                    <dd>{{ block.settings.size_2_price | escape }}</dd>
                  </div>
                {%- endif -%}
              </dl>
            {%- endif -%}
          </div>

        {%- when 'contact_form' -%}
          {% render 'wb-contact-form-markup', heading: block.settings.heading, heading_size: 'h1' %}
      {%- endcase -%}
    {%- endfor -%}

{% schema %}
{
  "name": "WB Grid Page",
  "tag": "section",
  "class": "section wb-first-item",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "page_header",
      "name": "Page header",
      "settings": []
    },
    {
      "type": "wb_grid",
      "name": "WB Grid",
      "settings": []
    },
    {
      "type": "landing_hero",
      "name": "WB - Landing Hero",
      "settings": []
    },
    {
      "type": "image_reel",
      "name": "WB - Image Reel",
      "limit": 1,
      "settings": []
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid",
          "info": "Add app snippets or other Liquid code to create custom content."
        }
      ]
    },
    {
      "type": "contact_form",
      "name": "Contact Form",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Contact form",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "richtext",
      "name": "Rich Text",
      "settings": [
        {
          "type": "richtext",
          "id": "richtext",
          "label": "Text",
          "default": "<p>Add your text here.</p>"
        }
      ]
    },
    {
      "type": "info_strip",
      "name": "WB - Info Strip",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Sits below the page intro. Above 1200px it moves to a narrow column on the right. Add this block directly after the Page header block."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Over 10,000 possible blends"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body",
          "default": "Chances are, yours will be the only one."
        },
        {
          "type": "header",
          "content": "Prices"
        },
        {
          "type": "text",
          "id": "size_1_label",
          "label": "First size label",
          "default": "200ml"
        },
        {
          "type": "text",
          "id": "size_1_price",
          "label": "First size price",
          "default": "£30"
        },
        {
          "type": "text",
          "id": "size_2_label",
          "label": "Second size label",
          "default": "500ml"
        },
        {
          "type": "text",
          "id": "size_2_price",
          "label": "Second size price",
          "default": "£60"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB Page",
      "blocks": [
        {
          "type": "page_header"
        },
        {
          "type": "wb_grid"
        }
      ]
    }
  ]
}
{% endschema %}
