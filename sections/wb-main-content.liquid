{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}
{{ 'glide.core.css' | asset_url | stylesheet_tag }}
{{ 'glide.custom.css' | asset_url | stylesheet_tag }}
{{ 'glide.js' | asset_url | script_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="wb-container">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'page_header' -%}
        <div class="wb-padding wb-collection-copy">
          <h1 class="wb-large-heading">{{ page.title | escape }}</h1>
          <p>
            {{ page.content }}
          </p>
        </div>

        {%- when 'wb_grid' -%}
          {%- assign grid_items = page.metafields.custom.grid_data.value -%}
          <div class="wb-padding">
                {% render 'wb-grid-markup', grid_items: grid_items, design_mode: request.design_mode %}
          </div>

        {%- when 'landing_hero' -%}
          {%- assign hero = page.metafields.custom.hero_details.value -%}
          <div class="wb-overflow-hidden-x" {{ block.shopify_attributes }}>
              {% render 'wb-landing-hero-markup',
                video_file: hero.video.value,
                background_image: hero.image.value,
                title: hero.title.value,
                description: hero.subtitle.value,
                primary_button_text: hero.primary_button_text.value,
                primary_button_url: hero.primary_button_url.value,
                secondary_button_text: hero.secondary_button_text.value,
                secondary_button_url: hero.secondary_button_url.value
              %}
          </div>

        {%- when 'image_reel' -%}
          <div class="wb-banded wb-overflow-hidden-x">
          {%- assign reel_images = page.metafields.custom.image_reel_data.value -%}
          {% render 'wb-image-reel-markup', reel_images: reel_images %}
          </div>

        {%- when 'custom_liquid' -%}
          <div {{ block.shopify_attributes }}>
            {{ block.settings.custom_liquid }}
          </div>

        {%- when 'richtext' -%}
          <div {{ block.shopify_attributes }}>
            {{ block.settings.richtext }}
          </div>

        {%- when 'contact_form' -%}
          {% render 'wb-contact-form-markup', heading: block.settings.heading, heading_size: 'h1' %}
      {%- endcase -%}
    {%- endfor -%}
  </div>
{% schema %}
{
  "name": "WB Grid Page",
  "tag": "section",
  "class": "section wb-first-item wb-banded",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "page_header",
      "name": "Page header",
      "settings": []
    },
    {
      "type": "wb_grid",
      "name": "WB Grid",
      "settings": []
    },
    {
      "type": "landing_hero",
      "name": "WB - Landing Hero",
      "settings": []
    },
    {
      "type": "image_reel",
      "name": "WB - Image Reel",
      "limit": 1,
      "settings": []
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid",
          "info": "Add app snippets or other Liquid code to create custom content."
        }
      ]
    },
    {
      "type": "contact_form",
      "name": "Contact Form",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Contact form",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "richtext",
      "name": "Rich Text",
      "settings": [
        {
          "type": "richtext",
          "id": "richtext",
          "label": "Text",
          "default": "<p>Add your text here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB Page",
      "blocks": [
        {
          "type": "page_header"
        },
        {
          "type": "wb_grid"
        }
      ]
    }
  ]
}
{% endschema %}
