{%- comment -%}
  Homepage "how it works" — a condensed version of the How It Works page.

  On that page each step is its own banded section. Here all the steps live in a
  single section as coloured panels, so the homepage gives the gist without
  handing over three full bands.

  NO `tag` or `class` in the schema — Shopify's default `<div class="shopify-section">`
  wrapper is what the banding system counts
  (`.shopify-section:nth-of-type(even) section.wb-banded` in wb-base.css).
  `nth-of-type` counts within an element type, so emitting a `<section>` wrapper
  drops this out of the div sequence and flips the banding of everything below.

  The heading and intro deliberately reuse the same markup as the occasions
  strip (`.wb-medium-heading` + a plain paragraph) so the two read as a pair.

  Panel colours come from the existing `wb-background-*` utilities in wb-base.css
  — all six are light pastels, so the dark text works on any of them.
{%- endcomment -%}

<section class="wb-banded">
  <div class="wb-container">
    <div class="wb-padding">
      {%- if section.settings.heading != blank -%}
        <h2 class="wb-medium-heading wb-hiwh-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="wb-hiwh-intro">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ol class="wb-hiwh-steps" role="list">
          {%- for block in section.blocks -%}
            <li
              class="wb-hiwh-step wb-hiwh-step--{{ block.settings.background | default: 'blue' }} wb-background-{{ block.settings.background | default: 'blue' }}-opacity"
              {{ block.shopify_attributes }}
            >
              <div class="wb-hiwh-step__text">
                {%- if block.settings.step_number != blank -%}
                  <p class="wb-medium-heading wb-hiwh-step__num">{{ block.settings.step_number | escape }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="wb-hiwh-step__title">{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="rte wb-hiwh-step__body">{{ block.settings.body }}</div>
                {%- endif -%}
              </div>

              {%- if block.settings.image != blank -%}
                <div class="wb-hiwh-step__media">
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '500, 800, 1200',
                      sizes: '(max-width: 767px) 90vw, 45vw',
                      alt: block.settings.heading,
                      class: 'wb-hiwh-step__img'
                  }}
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- comment -%}
        CTA panel — the payoff after the steps. Same -opacity background
        family as the steps, in its own colour, so it reads as part of the set
        while still marking the end of the sequence.
      {%- endcomment -%}
      {%- if section.settings.cta_heading != blank or section.settings.button_label != blank -%}
        <div class="wb-hiwh-cta wb-background-{{ section.settings.cta_background | default: 'green' }}-opacity">
          <div class="wb-hiwh-cta__text">
            {%- if section.settings.cta_heading != blank -%}
              <h3 class="wb-hiwh-cta__title">{{ section.settings.cta_heading | escape }}</h3>
            {%- endif -%}
            {%- if section.settings.cta_body != blank -%}
              <p class="wb-hiwh-cta__body">{{ section.settings.cta_body }}</p>
            {%- endif -%}
          </div>
          {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
            <div class="wb-buttons wb-hiwh-cta__action">
              <a href="{{ section.settings.button_url }}" class="wb-button wb-primary-button">
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .wb-hiwh-heading { margin-bottom: 8px; }
  .wb-hiwh-intro { margin-top: 0; max-width: 620px; }

  .wb-hiwh-steps {
    display: flex;
    flex-direction: column;
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
  }

  /* Full-width panels, stacked. Each one is itself a flex container so the
     text and image can sit 50/50 from tablet up — the same shape as a step on
     the How It Works page, just with a coloured panel around it. */
  .wb-hiwh-step {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
    border-radius: 8px;
    padding: 28px 24px;
  }

  .wb-hiwh-step__media {
    border-radius: 6px;
    overflow: hidden;
  }

  .wb-hiwh-step__img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Text styles copied from the How It Works page (.wb-hiw-number /
     .wb-hiw-heading) so the homepage steps read identically. */
  .wb-hiwh-step__num {
    color: #b88d60;
    margin-top: 0;
    margin-bottom: 8px;
    line-height: 1;
  }

  /* Step number tinted to its own panel. These are the `.wb-darker` values
     from wb-base.css — the same hues as the panels, but saturated enough to
     read. The panel's own pastel would be invisible on a 0.3-opacity tint of
     itself. Kept as literal hex because the wb-darker utilities set
     background-color, not color. */
  .wb-hiwh-step--blue   .wb-hiwh-step__num { color: #3b5ea1; }
  .wb-hiwh-step--brown  .wb-hiwh-step__num { color: #a56437; }
  .wb-hiwh-step--green  .wb-hiwh-step__num { color: #129776; }
  .wb-hiwh-step--purple .wb-hiwh-step__num { color: #8f5ea7; }
  .wb-hiwh-step--red    .wb-hiwh-step__num { color: #da5252; }
  .wb-hiwh-step--yellow .wb-hiwh-step__num { color: #e6b82b; }

  .wb-hiwh-step__title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 16px;
    color: #111;
  }

  /* Body deliberately has no type rules — it uses `.rte` exactly as the How It
     Works page does, inheriting the site body styles. Setting font-size or
     line-height on it here would diverge from the page and override the
     global body typography. */
  .wb-hiwh-step__body > p:last-child { margin-bottom: 0; }

  .wb-hiwh-cta {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
    border-radius: 8px;
    padding: 28px 24px;
    margin-top: 20px;
  }

  .wb-hiwh-cta__title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 8px;
    color: #111;
  }

  .wb-hiwh-cta__body { margin: 0; max-width: 46ch; }
  .wb-hiwh-cta__action { margin: 0; }

  @media screen and (min-width: 768px) {
    .wb-hiwh-steps { margin-top: 32px; }

    /* 50/50 inside each full-width panel, matching the How It Works page.
       flex-basis 50% on the text and `auto` on the media mirrors
       .wb-hiw-text / .wb-hiw-image there. */
    .wb-hiwh-step {
      flex-direction: row;
      align-items: center;
      column-gap: 40px;
      row-gap: 0;
      padding: 40px;
    }

    .wb-hiwh-step__text { flex: 0 0 50%; }
    .wb-hiwh-step__media { flex: auto; min-width: 0; }

    /* Copy left, button right — the action sits where the eye lands last. */
    .wb-hiwh-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      column-gap: 40px;
      row-gap: 0;
      padding: 36px 40px;
    }

    .wb-hiwh-cta__action { flex-shrink: 0; }

  }

  @media screen and (min-width: 1024px) {
    .wb-hiwh-step__title { font-size: 30px; }
  }
</style>

{% schema %}
{
  "name": "WB How it works (home)",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "A condensed version of the How It Works page for the homepage — all steps in one section as coloured panels. Panels sit side by side from tablet up."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Three steps from a blank slate to a bottle of Scotch that exists nowhere else."
    },
    {
      "type": "header",
      "content": "Call to action panel"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Ready to create your whisky?"
    },
    {
      "type": "text",
      "id": "cta_body",
      "label": "CTA text",
      "default": "No expertise needed \u2014 trust your instincts, have fun, and get blending!"
    },
    {
      "type": "select",
      "id": "cta_background",
      "label": "Panel colour",
      "default": "green",
      "options": [
        { "value": "brown", "label": "Brown" },
        { "value": "blue", "label": "Blue" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" },
        { "value": "red", "label": "Red" },
        { "value": "yellow", "label": "Yellow" }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter the lab"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step label",
          "default": "One"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Step heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Leave empty for a text-only panel — lighter for homepage load speed."
        },
        {
          "type": "select",
          "id": "background",
          "label": "Panel colour",
          "default": "blue",
          "options": [
            { "value": "blue", "label": "Blue" },
            { "value": "brown", "label": "Brown" },
            { "value": "green", "label": "Green" },
            { "value": "purple", "label": "Purple" },
            { "value": "red", "label": "Red" },
            { "value": "yellow", "label": "Yellow" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB How it works (home)",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
