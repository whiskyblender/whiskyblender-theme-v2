{% schema %}
{
  "name": "WB Collections List",
  "settings": [
    {
      "type": "text",
      "id": "main_collections",
      "label": "Main collection handles (comma-separated)",
      "default": "andrews-of-bothwell,wee-bits,custom,collaborations,football"
    },
    {
      "type": "text",
      "id": "regulars_collections",
      "label": "Regulars collection handles (comma-separated)",
      "default": "royal-anglian-regiment"
    },
    {
      "type": "text",
      "id": "occasions_collections",
      "label": "Occasions collection handles (comma-separated)",
      "default": "anniversaries,birthdays,celebrations,christmas,thankyous,weddings"
    }
  ],
  "presets": [
    { "name": "WB Collections List" }
  ]
}
{% endschema %}
