{{ 'glide.js' | asset_url | script_tag }}
{{ 'glide.core.css' | asset_url | stylesheet_tag }}
{{ 'glide.custom.css' | asset_url | stylesheet_tag }}

<section class="wb-banded wb-overflow-hidden-x">
  <div class="wb-container wb-first-item">
    <div class="wb-padding">
      {%- assign reel_images = '' -%}
      {%- for block in section.blocks -%}
        {%- if forloop.first -%}
          {%- assign reel_images = block.settings.reel_image -%}
        {%- else -%}
          {%- assign reel_images = reel_images | append: ',' | append: block.settings.reel_image -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign reel_images = reel_images | split: ',' -%}
      {% render 'wb-image-reel-markup', reel_images: reel_images %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image Reel",
  "settings": [],
  "blocks": [
    {
      "type": "image_reel",
      "name": "Image",
      "settings": [
        {
          "type": "text",
          "id": "reel_image",
          "label": "Reel image filename",
          "default": "wb-stars.gif",
          "info": "Upload image to assets folder and enter filename here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Reel",
      "blocks": [
        {
          "type": "image_reel"
        }
      ]
    }
  ]
}
{% endschema %}
