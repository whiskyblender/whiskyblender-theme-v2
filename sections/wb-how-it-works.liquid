{%- if section.settings.page_title != blank or page.content != blank -%}
  <header class="wb-container wb-first-item">
    <div class="wb-padding wb-hiw-title-wrap">
      {%- if section.settings.page_title != blank -%}
        <h1 class="wb-large-heading wb-hiw-title">{{ section.settings.page_title | escape }}</h1>
      {%- endif -%}
      {%- if page.content != blank -%}
        <div class="wb-hiw-intro wb-collection-copy">{{ page.content }}</div>
      {%- endif -%}
    </div>
  </header>
{%- endif -%}

{%- for block in section.blocks -%}
  <div class="wb-banded" {{ block.shopify_attributes }}>
    <div class="wb-container">
      <div class="wb-padding wb-hiw-inner">

        <div class="wb-hiw-text">
          {%- if block.settings.step_number != blank -%}
            <p class="wb-medium-heading wb-hiw-number">{{ block.settings.step_number | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="wb-hiw-heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <div class="rte">{{ block.settings.body }}</div>
          {%- endif -%}
          {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
            <div class="wb-buttons wb-hiw-cta">
              <a href="{{ block.settings.button_url }}" class="wb-button wb-primary-button">
                {{ block.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>

        <div class="wb-hiw-image">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200, 1400',
                sizes: '(max-width: 767px) 100vw, 60vw',
                class: 'wb-hiw-img'
            }}
          {%- else -%}
            <div class="wb-hiw-image-placeholder"></div>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
{%- endfor -%}

<style>
  .wb-hiw-title { margin: 0; }
  .wb-hiw-title-wrap { padding-bottom: 0; }
  .wb-hiw-intro { margin-top: 16px; max-width: 640px; }

  .wb-hiw-inner {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
  }

  .wb-hiw-text {
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .wb-hiw-image {
    width: 100%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .wb-hiw-img,
  .wb-hiw-image-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .wb-hiw-image-placeholder {
    background-color: #ddd;
  }

  .wb-hiw-number {
    color: #b88d60;
    margin-top: 0;
    margin-bottom: 8px;
    line-height: 1;
  }

  .wb-hiw-heading {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 16px;
    color: #111;
  }

  .wb-hiw-cta { margin-top: 24px; }

  @media screen and (min-width: 768px) {
    .wb-hiw-inner {
      flex-direction: row;
      align-items: stretch;
      column-gap: 60px;
    }

    .wb-hiw-text {
      flex: 0 0 40%;
      padding: 0;
    }

    .wb-hiw-image {
      flex: auto;
    }
  }

  @media screen and (min-width: 1024px) {
    .wb-hiw-heading {
      font-size: 30px;
    }
  }
</style>

{% schema %}
{
  "name": "How it works",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page title (H1)",
      "default": "How it works"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step number (word)",
          "default": "One"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Step heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works"
    }
  ]
}
{% endschema %}
