{%- if section.settings.page_title != blank or page.content != blank -%}
  <header class="wb-container">
    <div class="wb-padding">
      {%- if section.settings.page_title != blank -%}
        <h1 class="wb-large-heading wb-hiw-title">{{ section.settings.page_title | escape }}</h1>
      {%- endif -%}
      {%- if page.content != blank -%}
        <div class="wb-hiw-intro wb-collection-copy">{{ page.content }}</div>
      {%- endif -%}
    </div>
  </header>
{%- endif -%}

{%- for block in section.blocks -%}
  <div class="wb-banded" {{ block.shopify_attributes }}>
    <div class="wb-container">
      <div class="wb-padding wb-hiw-inner">

        <div class="wb-hiw-text">
          {%- if block.settings.step_number != blank -%}
            <p class="wb-medium-heading wb-hiw-number">{{ block.settings.step_number | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="wb-hiw-heading">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <div class="rte">{{ block.settings.body }}</div>
          {%- endif -%}
          {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
            <div class="wb-buttons wb-hiw-cta">
              <a href="{{ block.settings.button_url }}" class="wb-button wb-primary-button">
                {{ block.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>

        <div class="wb-hiw-image">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200, 1400',
                sizes: '(max-width: 767px) 100vw, 60vw',
                class: 'wb-hiw-img'
            }}
          {%- else -%}
            <div class="wb-hiw-image-placeholder"></div>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
{%- endfor -%}

{%- comment -%}
  Closing CTA. The page previously ended on the last step with nothing to act
  on — a reader who gets this far is about as high-intent as the site sees.
  Same panel treatment as the homepage how-it-works section so the two match.
{%- endcomment -%}
{%- if section.settings.cta_heading != blank or section.settings.button_label != blank -%}
  <div class="wb-banded">
    <div class="wb-container">
      <div class="wb-padding">
        <div class="wb-hiw-endcta wb-background-{{ section.settings.cta_background | default: 'yellow' }}-opacity">
          <div class="wb-hiw-endcta__text">
            {%- if section.settings.cta_heading != blank -%}
              <h2 class="wb-hiw-endcta__title">{{ section.settings.cta_heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.cta_body != blank -%}
              <p class="wb-hiw-endcta__body">{{ section.settings.cta_body }}</p>
            {%- endif -%}
          </div>
          {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
            <div class="wb-buttons wb-hiw-endcta__action">
              <a href="{{ section.settings.button_url }}" class="wb-button wb-primary-button">
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

<style>
  .wb-hiw-title { margin: 0; }
  .wb-hiw-intro { margin-top: 16px; max-width: 640px; }

  .wb-hiw-inner {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
  }

  .wb-hiw-text {
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .wb-hiw-image {
    width: 100%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .wb-hiw-img,
  .wb-hiw-image-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .wb-hiw-image-placeholder {
    background-color: #ddd;
  }

  .wb-hiw-number {
    color: #b88d60;
    margin-top: 0;
    margin-bottom: 8px;
    line-height: 1;
  }

  .wb-hiw-heading {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 16px;
    color: #111;
  }

  .wb-hiw-cta { margin-top: 24px; }

  .wb-hiw-endcta {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
    border-radius: 8px;
    padding: 28px 24px;
  }

  .wb-hiw-endcta__title {
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 8px;
    color: #111;
  }

  .wb-hiw-endcta__body { margin: 0; max-width: 46ch; }
  .wb-hiw-endcta__action { margin: 0; }

  #shopify-section-how_it_works + .shopify-section .wb-banded {
    background-color: #ffffff;
  }

  @media screen and (min-width: 768px) {
    .wb-hiw-inner {
      flex-direction: row;
      align-items: stretch;
      column-gap: 60px;
    }

    .wb-hiw-text {
      flex: 0 0 50%;
      padding: 0;
    }

    .wb-hiw-image {
      flex: auto;
    }

    /* Same geometry as a step above, so the button column lines up with the
       images. Matches the homepage section. */
    .wb-hiw-endcta {
      flex-direction: row;
      align-items: center;
      column-gap: 80px;
      row-gap: 0;
      padding: 40px;
    }

    .wb-hiw-endcta__text { flex: 0 0 50%; }
    .wb-hiw-endcta__action { flex: auto; min-width: 0; }

    .wb-hiw-endcta__action .wb-button {
      width: 100%;
      margin: 0;
    }

    .wb-hiw-endcta__title { font-size: 26px; }
  }

  @media screen and (min-width: 1024px) {
    .wb-hiw-heading {
      font-size: 30px;
    }
  }
</style>

{% schema %}
{
  "name": "How it works",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page title (H1)",
      "default": "How it works"
    },
    {
      "type": "header",
      "content": "Closing call to action"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Ready to create your whisky?"
    },
    {
      "type": "text",
      "id": "cta_body",
      "label": "CTA text",
      "default": "No expertise needed \u2014 trust your instincts, have fun, and get blending!"
    },
    {
      "type": "select",
      "id": "cta_background",
      "label": "Panel colour",
      "default": "yellow",
      "options": [
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "brown", "label": "Brown" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" },
        { "value": "red", "label": "Red" }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter the lab"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step number (word)",
          "default": "One"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Step heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works"
    }
  ]
}
{% endschema %}
