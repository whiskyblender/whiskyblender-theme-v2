{%- comment -%}
  How It Works page.

  Steps are coloured `-opacity` panels, matching the homepage how-it-works
  section (wb-how-it-works-home.liquid). They were previously one alternating
  `wb-banded` block per step. Keep the two in step if either changes.

  Panel colours come from the `wb-background-*` utilities in wb-base.css. The
  step number is tinted to its own panel using the matching `.wb-darker` value:
  the panel's own pastel would be invisible on a 0.3-opacity tint of itself.
{%- endcomment -%}

<div class="wb-banded">
  <div class="wb-container">
    <div class="wb-padding">

      {%- comment -%}
        Title, intro and all four panels share one wrapper — the page reads as a
        single block rather than a header followed by a separate band.
      {%- endcomment -%}
      {%- if section.settings.page_title != blank -%}
        <h1 class="wb-large-heading wb-hiw-title">{{ section.settings.page_title | escape }}</h1>
      {%- endif -%}
      {%- if page.content != blank -%}
        <div class="wb-hiw-intro wb-collection-copy">{{ page.content }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ol class="wb-hiw-steps" role="list">
          {%- for block in section.blocks -%}
            <li
              class="wb-hiw-step wb-hiw-step--{{ block.settings.background | default: 'green' }} wb-background-{{ block.settings.background | default: 'green' }}-opacity"
              {{ block.shopify_attributes }}
            >
              <div class="wb-hiw-text">
                {%- if block.settings.step_number != blank -%}
                  <p class="wb-medium-heading wb-hiw-number">{{ block.settings.step_number | escape }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="wb-hiw-heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <div class="rte">{{ block.settings.body }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <div class="wb-buttons wb-hiw-cta">
                    <a href="{{ block.settings.button_url | default: '/pages/the-lab' }}" class="wb-button wb-primary-button">
                      {{ block.settings.button_label | escape }}
                    </a>
                  </div>
                {%- endif -%}
              </div>

              <div class="wb-hiw-image">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      widths: '600, 900, 1200, 1400',
                      sizes: '(max-width: 767px) 100vw, 45vw',
                      alt: block.settings.heading,
                      class: 'wb-hiw-img'
                  }}
                {%- else -%}
                  <div class="wb-hiw-image-placeholder"></div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- comment -%}
        Closing CTA — a reader who gets this far is about as high-intent as the
        site sees, and the page previously ended with nothing to act on.
      {%- endcomment -%}
      {%- if section.settings.cta_heading != blank or section.settings.button_label != blank -%}
        <div class="wb-hiw-endcta wb-background-{{ section.settings.cta_background | default: 'yellow' }}-opacity">
          <div class="wb-hiw-endcta__text">
            {%- if section.settings.cta_heading != blank -%}
              <h2 class="wb-hiw-endcta__title">{{ section.settings.cta_heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.cta_body != blank -%}
              <p class="wb-hiw-endcta__body">{{ section.settings.cta_body }}</p>
            {%- endif -%}
          </div>
          {%- comment -%}
            Only the label is required. A `url` setting's schema `default` is not
            applied by Shopify (shopify:// routes resolve only when picked in the
            editor), so the fallback lives here — otherwise the button silently
            never renders.
          {%- endcomment -%}
          {%- if section.settings.button_label != blank -%}
            <div class="wb-buttons wb-hiw-endcta__action">
              <a href="{{ section.settings.button_url | default: '/pages/the-lab' }}" class="wb-button wb-primary-button">
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<style>
  .wb-hiw-title { margin: 0; }
  .wb-hiw-intro { margin-top: 16px; max-width: 640px; }

  .wb-hiw-steps {
    display: flex;
    flex-direction: column;
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
  }

  .wb-hiw-step {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
    border-radius: 8px;
    padding: 28px 24px;
  }

  .wb-hiw-text {
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .wb-hiw-image {
    width: 100%;
    overflow: hidden;
    border-radius: 6px;
  }

  .wb-hiw-img,
  .wb-hiw-image-placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .wb-hiw-image-placeholder {
    background-color: rgba(0, 0, 0, 0.06);
    aspect-ratio: 3 / 2;
  }

  .wb-hiw-number {
    color: #b88d60;
    margin-top: 0;
    margin-bottom: 8px;
    line-height: 1;
  }

  /* Step number tinted to its own panel — the `.wb-darker` values from
     wb-base.css. Same approach as the homepage section. */
  .wb-hiw-step--blue   .wb-hiw-number { color: #3b5ea1; }
  .wb-hiw-step--brown  .wb-hiw-number { color: #a56437; }
  .wb-hiw-step--green  .wb-hiw-number { color: #129776; }
  .wb-hiw-step--purple .wb-hiw-number { color: #8f5ea7; }
  .wb-hiw-step--red    .wb-hiw-number { color: #da5252; }
  .wb-hiw-step--yellow .wb-hiw-number { color: #e6b82b; }

  .wb-hiw-heading {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 16px;
    color: #111;
  }

  .wb-hiw-cta { margin-top: 24px; }

  .wb-hiw-endcta {
    display: flex;
    flex-direction: column;
    row-gap: 20px;
    border-radius: 8px;
    padding: 28px 24px;
    margin-top: 20px;
  }

  .wb-hiw-endcta__title {
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 8px;
    color: #111;
  }

  .wb-hiw-endcta__body { margin: 0; max-width: 46ch; }
  .wb-hiw-endcta__action { margin: 0; }

  #shopify-section-how_it_works + .shopify-section .wb-banded {
    background-color: #ffffff;
  }

  /* Mobile only — headings come down a little in the tighter panels. The step
     number keeps its full .wb-medium-heading size, and body text is untouched
     so it inherits the site's 16px mobile size. */
  @media screen and (max-width: 767px) {
    .wb-hiw-heading { font-size: 21px; margin-bottom: 12px; }
    .wb-hiw-endcta__title { font-size: 21px; }
  }

  @media screen and (min-width: 768px) {
    .wb-hiw-step {
      flex-direction: row;
      align-items: center;
      column-gap: 80px;
      row-gap: 0;
      padding: 40px;
    }

    .wb-hiw-text { flex: 0 0 50%; }
    .wb-hiw-image { flex: auto; min-width: 0; }

    .wb-hiw-endcta {
      flex-direction: row;
      align-items: center;
      column-gap: 80px;
      row-gap: 0;
      padding: 40px;
    }

    .wb-hiw-endcta__text { flex: 0 0 50%; }
    .wb-hiw-endcta__action { flex: auto; min-width: 0; }

    .wb-hiw-endcta__action .wb-button {
      width: 100%;
      margin: 0;
    }

    .wb-hiw-endcta__title { font-size: 26px; }
  }

  @media screen and (min-width: 1024px) {
    .wb-hiw-heading { font-size: 30px; }
  }
</style>

{% schema %}
{
  "name": "How it works",
  "settings": [
    {
      "type": "text",
      "id": "page_title",
      "label": "Page title (H1)",
      "default": "How it works"
    },
    {
      "type": "header",
      "content": "Closing call to action"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Ready to create your whisky?"
    },
    {
      "type": "text",
      "id": "cta_body",
      "label": "CTA text",
      "default": "No expertise needed — trust your instincts, have fun, and get blending!"
    },
    {
      "type": "select",
      "id": "cta_background",
      "label": "Panel colour",
      "default": "yellow",
      "options": [
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "brown", "label": "Brown" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" },
        { "value": "red", "label": "Red" }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter the lab"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "info": "Optional — defaults to the Lab."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step number (word)",
          "default": "One"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Step heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "background",
          "label": "Panel colour",
          "default": "green",
          "options": [
            { "value": "green", "label": "Green" },
            { "value": "brown", "label": "Brown" },
            { "value": "blue", "label": "Blue" },
            { "value": "yellow", "label": "Yellow" },
            { "value": "purple", "label": "Purple" },
            { "value": "red", "label": "Red" }
          ]
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link",
          "info": "Optional — defaults to the Lab."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works"
    }
  ]
}
{% endschema %}
