{%- liquid
  if template.name == 'index'
    assign hero_image = images['wb-index.jpg'] | image_url: width: 1920
    assign video_poster = images['wb-index.jpg'] | image_url: width: 750
  elsif collection.image != blank
    assign hero_image = collection.image | image_url: width: 1920
    assign video_poster = collection.image | image_url: width: 750
  elsif section.settings.background_image != blank
    assign hero_image = section.settings.background_image | image_url: width: 1920
    assign video_poster = section.settings.background_image | image_url: width: 750
  elsif page.handle == 'about'
    assign hero_image = images['wb-cask-heids.jpg'] | image_url: width: 1920
    assign video_poster = images['wb-cask-heids.jpg'] | image_url: width: 750
  elsif page.handle == 'gifts'
    assign hero_image = images['wb-whisky-bow.jpg'] | image_url: width: 1920
    assign video_poster = images['wb-whisky-bow.jpg'] | image_url: width: 750
  endif
  assign hero_title = section.settings.title | default: collection.title | default: page.title

  comment
    Hero description: the page's own Shopify content wins over the theme setting,
    so a page's copy is edited in one place (Content → Pages) rather than being
    duplicated into a theme field. The setting stays as the fallback, which is
    what the homepage and every collection use — page.content is nil there.
    page.content is rich text (it carries its own <p> tags), so it must go in a
    div; putting it inside <p> would make the browser close the paragraph early
    and drop the styling.
  endcomment
  assign hero_description = section.settings.description
  assign hero_description_rte = false
  if page.content != blank
    assign hero_description = page.content
    assign hero_description_rte = true
  endif

  comment
    When the title rotates (title_variants), the big phrase is decoration, not the
    page's heading: Google renders the JS, so it would index "Liquid gold" or
    "Sláinte!" as the H1. With description_as_heading ticked, the description line
    becomes the H1 instead (styled to look exactly like the paragraph it replaces)
    and the rotating phrase drops to a <p> with the same class, which renders
    identically. Nothing visible changes. Without variants the section behaves as
    before, so the collection/page heroes sharing it keep their title as the H1.
  endcomment
  assign split_heading = false
  if section.settings.title_variants contains ',' and section.settings.description_as_heading and hero_description_rte == false and hero_description != blank
    assign split_heading = true
  endif
-%}
{%- if video_poster or hero_image -%}
<style>
  .wb-videobg, .wb-imagebg { background-image: url({{ video_poster | default: hero_image }}); }
  @media (min-width: 768px) { .wb-videobg, .wb-imagebg { background-image: url({{ hero_image | default: video_poster }}); } }
</style>
{%- endif -%}
<style>
  /* Hero description sourced from page.content — rich text, so it arrives wrapped
     in its own <p>. Those paragraphs must inherit the hero's type rather than
     falling back to the body defaults, which would shrink them. */
  .wb-hero-rte > p {
    font: inherit;
    color: inherit;
    margin: 0 0 12px;
  }
  .wb-hero-rte > p:last-child { margin-bottom: 0; }

  /* Description as the H1 (see description_as_heading): undo the heading styles so
     it renders exactly like the <p> it replaces */
  .wb-hero-desc {
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
    text-transform: none;
    word-break: normal;
    hyphens: manual;
    margin: 1em 0;
  }

  #wb-video-toggle {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: rgba(0,0,0,0.35);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    opacity: 0.5;
    transition: opacity 0.2s;
  }
  #wb-video-toggle:hover,
  #wb-video-toggle:focus-visible {
    opacity: 1;
  }
  #wb-video-toggle::before,
  #wb-video-toggle::after {
    content: '';
    display: block;
    width: 3px;
    height: 10px;
    background: #fff;
    border-radius: 1px;
  }
  #wb-video-toggle.wb-video-paused {
    gap: 0;
  }
  #wb-video-toggle.wb-video-paused::before {
    width: 0;
    height: 0;
    background: transparent;
    border-style: solid;
    border-width: 6px 0 6px 11px;
    border-color: transparent transparent transparent #fff;
    border-radius: 0;
    margin-left: 2px;
  }
  #wb-video-toggle.wb-video-paused::after {
    display: none;
  }
</style>

<section class="wb-overflow-hidden-x">
  <div class="wb-container">
    {%- assign video_src = section.settings.video_url | default: '' -%}
    {%- if video_src == blank and section.settings.video_file != blank -%}
      {%- assign video_src = section.settings.video_file | asset_url -%}
    {%- endif -%}
    {%- if video_src == blank -%}
      <div class="wb-imagebg">
        <div class="wb-padding">
          <h1 class="wb-medium-heading">{{ hero_title }}</h1>
          {%- if hero_description_rte -%}
            <div class="wb-collection-sub wb-hero-rte">{{ hero_description }}</div>
          {%- else -%}
            <p class="wb-collection-sub">{{ hero_description }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      <div class="wb-videobg">
        <div class="wb-videograin"></div>
        <video muted loop playsinline fetchpriority="high" id="wb-video" aria-hidden="true"{% if video_poster %} poster="{{ video_poster }}"{% endif %} data-video-src="{{ video_src }}"{% if section.settings.video_url_phone != blank %} data-video-src-phone="{{ section.settings.video_url_phone }}"{% endif %}>
        </video>
        <button id="wb-video-toggle" aria-label="Pause video" type="button"></button>
        {%- if section.settings.badge_show and section.settings.badge_url != blank -%}
          <a href="{{ section.settings.badge_url }}" class="wb-birthday-badge" aria-label="{{ section.settings.badge_aria_label | default: 'Read our birthday blog post' }}">
            {%- if section.settings.badge_image != blank -%}
              <img class="wb-badge-image" src="{{ section.settings.badge_image | image_url: width: 360 }}" alt="" loading="eager" width="360" height="360">
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
      <div class="wb-overvideo">
        <div class="wb-padding">
          {%- if split_heading -%}
            <p class="wb-large-heading" id="wb-landing-heading">{{ hero_title }}</p>
            <h1 class="wb-hero-desc">{{ hero_description }}</h1>
          {%- else -%}
            <h1 class="wb-large-heading" id="wb-landing-heading">{{ hero_title }}</h1>
            {%- if hero_description_rte -%}
              <div class="wb-hero-rte">{{ hero_description }}</div>
            {%- else -%}
              <p>{{ hero_description }}</p>
            {%- endif -%}
          {%- endif -%}
          <div class="wb-buttons">
            {%- comment -%}
              Hero button A/B test (homepage only, switch in the theme editor under "Hero button test").
              A = the normal primary button (the Lab); B = the test text/link (a custom bottle).
              The visitor's version is kept as the cart attribute `hero_test`, which travels onto
              the order, so orders can be compared per version. Liquid renders a visitor's saved
              version server-side (no flicker on return visits); a new visitor is assigned by the
              inline script just below, before the button paints. Headless browsers
              (navigator.webdriver) are never assigned and always see A.
            {%- endcomment -%}
            {%- liquid
              assign wb_hero_test = false
              if template.name == 'index' and section.settings.hero_test_on and section.settings.hero_test_url != blank and section.settings.hero_test_text != blank
                assign wb_hero_test = true
                assign wb_hero_arm = cart.attributes.hero_test
              endif
            -%}
            {%- if wb_hero_test and wb_hero_arm == 'B' -%}
              <a href="{{ section.settings.hero_test_url }}" class="wb-button wb-primary-button" id="wb-hero-primary" data-hero-arm="B">{{ section.settings.hero_test_text }}</a>
            {%- else -%}
              <a href="{{ section.settings.primary_button_url }}" class="wb-button wb-primary-button"{% if wb_hero_test %} id="wb-hero-primary" data-hero-arm="{{ wb_hero_arm }}"{% endif %}>{{ section.settings.primary_button_text }}</a>
            {%- endif -%}
            <a href="{{ section.settings.secondary_button_url }}" class="wb-button">{{ section.settings.secondary_button_text }}</a>
          </div>
          {%- if wb_hero_test -%}
            <script>
              (function () {
                var a = document.getElementById('wb-hero-primary');
                if (!a || navigator.webdriver) return;
                var arm = a.getAttribute('data-hero-arm');
                if (arm === 'A' || arm === 'B') return;
                arm = Math.random() < 0.5 ? 'A' : 'B';
                if (arm === 'B') {
                  a.href = {{ section.settings.hero_test_url | json }};
                  a.textContent = {{ section.settings.hero_test_text | json }};
                }
                a.setAttribute('data-hero-arm', arm);
                /* keepalive so the attribute still saves if the button is tapped straight away */
                try {
                  fetch('/cart/update.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ attributes: { hero_test: arm } }),
                    keepalive: true
                  }).catch(function () {});
                } catch (e) {}
              })();
            </script>
          {%- endif -%}
        </div>
      </div>
      <script>
        (function () {
          var vid = document.getElementById('wb-video');
          var btn = document.getElementById('wb-video-toggle');
          if (!vid || !vid.dataset.videoSrc) return;

          function startVideo() {
            if (vid.src) return;
            /* Phones get the smaller copy when one is set (about 1 MB instead of 5 MB) */
            var phone = vid.dataset.videoSrcPhone && window.matchMedia('(max-width: 767px)').matches;
            vid.src = phone ? vid.dataset.videoSrcPhone : vid.dataset.videoSrc;
            vid.play().catch(function () {});
          }

          /* While the age gate covers the page, nobody can see the video, so don't spend
             4 MB of a first visit downloading it. Start when "Aye" is clicked instead.
             The class is set by the inline script in snippets/wb-age-gate.liquid. */
          if (document.documentElement.classList.contains('wb-age-gate-open')) {
            document.addEventListener('wb:age-verified', startVideo, { once: true });
          } else if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', startVideo);
          } else {
            startVideo();
          }

          if (btn) {
            btn.addEventListener('click', function () {
              if (vid.paused) {
                vid.play().catch(function () {});
                btn.setAttribute('aria-label', 'Pause video');
                btn.classList.remove('wb-video-paused');
              } else {
                vid.pause();
                btn.setAttribute('aria-label', 'Play video');
                btn.classList.add('wb-video-paused');
              }
            });
          }
        })();
      </script>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.title_variants != blank -%}
<script>
  (function () {
    var raw = {{ section.settings.title_variants | json }};
    var phrases = raw.split(',').map(function(s){ return s.trim(); }).filter(Boolean);
    if (phrases.length > 1) {
      var el = document.getElementById('wb-landing-heading');
      if (el) el.textContent = phrases[Math.floor(Math.random() * phrases.length)];
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Landing Hero",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "Paste the full URL from Shopify Files (Content → Files). Takes priority over the filename field below."
    },
    {
      "type": "text",
      "id": "video_url_phone",
      "label": "Phone video URL (optional)",
      "info": "A smaller copy of the same video for screens under 768px wide. Leave blank to use the main video everywhere."
    },
    {
      "type": "text",
      "id": "video_file",
      "label": "Video filename (theme asset fallback)",
      "info": "Only used if no Video URL is set above."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Shown while the video loads, or as the main image if no video is set."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title text",
      "info": "Used as the fallback if no variants are set below.",
      "default": "Create something"
    },
    {
      "type": "textarea",
      "id": "title_variants",
      "label": "Title variants (comma-separated)",
      "info": "Enter multiple phrases separated by commas — a random one will be shown on each page load. Leave blank to always show the title above."
    },
    {
      "type": "checkbox",
      "id": "description_as_heading",
      "label": "Use the description as the page heading (H1)",
      "default": false,
      "info": "Only applies with title variants. Google reads the rotating title as the page's main heading, so with this on the description below is the heading instead. Looks the same either way."
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description text",
      "info": "On a page, the page's own Content (Content → Pages) is used instead and this is ignored. Used here only on the homepage, collections, and pages with empty Content.",
      "default": "When you're looking for that bottle of whisky nobody else has."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary button text",
      "default": "Create something"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary button text",
      "default": "Get a voucher"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary button URL"
    },
    {
      "type": "header",
      "content": "Hero button test"
    },
    {
      "type": "checkbox",
      "id": "hero_test_on",
      "label": "Run the hero button test",
      "info": "Homepage only. Half of new visitors see the test button instead of the primary button. Untick to end the test: everyone then sees the primary button.",
      "default": false
    },
    {
      "type": "text",
      "id": "hero_test_text",
      "label": "Test button text",
      "default": "Create a label"
    },
    {
      "type": "url",
      "id": "hero_test_url",
      "label": "Test button URL"
    },
    {
      "type": "header",
      "content": "Birthday badge"
    },
    {
      "type": "checkbox",
      "id": "badge_show",
      "label": "Show badge",
      "default": false
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge link URL",
      "info": "Leave blank to hide the badge."
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge overlay image",
      "info": "Use a PNG with transparency so the glitter shines through."
    },
    {
      "type": "text",
      "id": "badge_aria_label",
      "label": "Badge screen reader label",
      "default": "Read our birthday blog post"
    }
  ],
  "presets": [
    {
      "name": "WB - Landing Hero"
    }
  ]
}
{% endschema %}
