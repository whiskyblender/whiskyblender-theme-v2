{%- liquid
  if template.name == 'index'
    assign hero_image = images['wb-index.jpg'] | image_url: width: 1920
    assign video_poster = images['wb-index.jpg'] | image_url: width: 750
  elsif collection.image != blank
    assign hero_image = collection.image | image_url: width: 1920
    assign video_poster = collection.image | image_url: width: 750
  elsif section.settings.background_image != blank
    assign hero_image = section.settings.background_image | image_url: width: 1920
    assign video_poster = section.settings.background_image | image_url: width: 750
  elsif page.handle == 'about'
    assign hero_image = images['wb-cask-heids.jpg'] | image_url: width: 1920
    assign video_poster = images['wb-cask-heids.jpg'] | image_url: width: 750
  elsif page.handle == 'gifts'
    assign hero_image = images['wb-whisky-bow.jpg'] | image_url: width: 1920
    assign video_poster = images['wb-whisky-bow.jpg'] | image_url: width: 750
  endif
  assign hero_title = section.settings.title | default: collection.title | default: page.title
-%}
{%- if video_poster or hero_image -%}
<style>
  .wb-videobg, .wb-imagebg { background-image: url({{ video_poster | default: hero_image }}); }
  @media (min-width: 768px) { .wb-videobg, .wb-imagebg { background-image: url({{ hero_image | default: video_poster }}); } }
</style>
{%- endif -%}
<style>
  #wb-video-toggle {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 10;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: rgba(0,0,0,0.35);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    opacity: 0.5;
    transition: opacity 0.2s;
  }
  #wb-video-toggle:hover,
  #wb-video-toggle:focus-visible {
    opacity: 1;
  }
  #wb-video-toggle::before,
  #wb-video-toggle::after {
    content: '';
    display: block;
    width: 3px;
    height: 10px;
    background: #fff;
    border-radius: 1px;
  }
  #wb-video-toggle.wb-video-paused {
    gap: 0;
  }
  #wb-video-toggle.wb-video-paused::before {
    width: 0;
    height: 0;
    background: transparent;
    border-style: solid;
    border-width: 6px 0 6px 11px;
    border-color: transparent transparent transparent #fff;
    border-radius: 0;
    margin-left: 2px;
  }
  #wb-video-toggle.wb-video-paused::after {
    display: none;
  }
</style>

<section class="wb-overflow-hidden-x">
  <div class="wb-container">
    {%- assign video_src = section.settings.video_url | default: '' -%}
    {%- if video_src == blank and section.settings.video_file != blank -%}
      {%- assign video_src = section.settings.video_file | asset_url -%}
    {%- endif -%}
    {%- if video_src == blank -%}
      <div class="wb-imagebg">
        <div class="wb-padding">
          <h1 class="wb-medium-heading">{{ hero_title }}</h1>
          <p class="wb-collection-sub">{{ section.settings.description }}</p>
        </div>
      </div>
    {%- else -%}
      <div class="wb-videobg">
        <div class="wb-videograin"></div>
        <video muted loop playsinline fetchpriority="high" id="wb-video" aria-hidden="true"{% if video_poster %} poster="{{ video_poster }}"{% endif %} data-video-src="{{ video_src }}">
        </video>
        <button id="wb-video-toggle" aria-label="Pause video" type="button"></button>
        {%- if section.settings.badge_show and section.settings.badge_url != blank -%}
          <a href="{{ section.settings.badge_url }}" class="wb-birthday-badge" aria-label="{{ section.settings.badge_aria_label | default: 'Read our birthday blog post' }}">
            {%- if section.settings.badge_image != blank -%}
              <img class="wb-badge-image" src="{{ section.settings.badge_image | image_url: width: 360 }}" alt="" loading="eager" width="360" height="360">
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
      <div class="wb-overvideo">
        <div class="wb-padding">
          <h1 class="wb-large-heading" id="wb-landing-heading">{{ hero_title }}</h1>
          <p>{{ section.settings.description }}</p>
          <div class="wb-buttons">
            <a href="{{ section.settings.primary_button_url }}" class="wb-button wb-primary-button">{{ section.settings.primary_button_text }}</a>
            <a href="{{ section.settings.secondary_button_url }}" class="wb-button">{{ section.settings.secondary_button_text }}</a>
          </div>
        </div>
      </div>
      <script>
        (function () {
          var vid = document.getElementById('wb-video');
          var btn = document.getElementById('wb-video-toggle');
          if (!vid || !vid.dataset.videoSrc) return;

          function startVideo() {
            if (vid.src) return;
            vid.src = vid.dataset.videoSrc;
            vid.play().catch(function () {});
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', startVideo);
          } else {
            startVideo();
          }

          if (btn) {
            btn.addEventListener('click', function () {
              if (vid.paused) {
                vid.play().catch(function () {});
                btn.setAttribute('aria-label', 'Pause video');
                btn.classList.remove('wb-video-paused');
              } else {
                vid.pause();
                btn.setAttribute('aria-label', 'Play video');
                btn.classList.add('wb-video-paused');
              }
            });
          }
        })();
      </script>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.title_variants != blank -%}
<script>
  (function () {
    var raw = {{ section.settings.title_variants | json }};
    var phrases = raw.split(',').map(function(s){ return s.trim(); }).filter(Boolean);
    if (phrases.length > 1) {
      var el = document.getElementById('wb-landing-heading');
      if (el) el.textContent = phrases[Math.floor(Math.random() * phrases.length)];
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Landing Hero",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "info": "Paste the full URL from Shopify Files (Content → Files). Takes priority over the filename field below."
    },
    {
      "type": "text",
      "id": "video_file",
      "label": "Video filename (theme asset fallback)",
      "info": "Only used if no Video URL is set above."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Shown while the video loads, or as the main image if no video is set."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title text",
      "info": "Used as the fallback if no variants are set below.",
      "default": "Create something"
    },
    {
      "type": "textarea",
      "id": "title_variants",
      "label": "Title variants (comma-separated)",
      "info": "Enter multiple phrases separated by commas — a random one will be shown on each page load. Leave blank to always show the title above."
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description text",
      "default": "When you're looking for that bottle of whisky nobody else has."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary button text",
      "default": "Create something"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary button text",
      "default": "Get a voucher"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary button URL"
    },
    {
      "type": "header",
      "content": "Birthday badge"
    },
    {
      "type": "checkbox",
      "id": "badge_show",
      "label": "Show badge",
      "default": false
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge link URL",
      "info": "Leave blank to hide the badge."
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge overlay image",
      "info": "Use a PNG with transparency so the glitter shines through."
    },
    {
      "type": "text",
      "id": "badge_aria_label",
      "label": "Badge screen reader label",
      "default": "Read our birthday blog post"
    }
  ],
  "presets": [
    {
      "name": "WB - Landing Hero"
    }
  ]
}
{% endschema %}
