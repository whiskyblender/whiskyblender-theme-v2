{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{{ 'wb-custom.css' | asset_url | stylesheet_tag }}

{%- assign opts_collection = section.settings.collection -%}

<section class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding">

      <h1 class="wb-large-heading" id="wb-custom-heading">Choose your bottle</h1>
      <p class="wb-collection-sub" id="wb-custom-sub">Now choose how you want to bottle your whisky&hellip;</p>

      <div id="wb-noblend-actions" style="display:none">
        <a
          href="{{ section.settings.create_url | default: '/pages/create' }}"
          class="wb-button wb-primary-button"
          style="margin-top:24px;display:inline-block"
        >{{ section.settings.create_label | default: 'Create something' }}</a>

        <div class="wb-noblend-divider">or</div>

        <p class="wb-noblend-codelabel">Already have a blend code?</p>
        <div class="wb-noblend-form">
          <input
            type="text"
            id="wb-code-input"
            placeholder="WB123456"
            maxlength="10"
            autocomplete="off"
            autocapitalize="characters"
          />
          <button class="wb-button wb-primary-button" id="wb-code-go" disabled>Go</button>
        </div>
      </div>

      {%- if opts_collection != blank and opts_collection.products.size > 0 -%}
        <ul class="wb-cards wb-main-cards" id="wb-custom-grid">
          {%- for product in opts_collection.products -%}
            {%- assign sold_out = true -%}
            {%- for variant in product.variants -%}
              {%- if variant.available -%}
                {%- assign sold_out = false -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            <li{% if sold_out %} class="wb-soldout"{% endif %}>
              <a href="{{ product.url }}" data-product-url="{{ product.url }}" class="wb-card-link-overlay" aria-hidden="true" tabindex="-1"></a>
              <div class="wb-card-image">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                    loading="lazy"
                  />
                {%- endif -%}
                {%- if sold_out -%}
                  <div class="wb-productbadge">
                    <div class="wb-soldoutbadge">Sold out</div>
                  </div>
                {%- endif -%}
              </div>
              <div class="wb-card-details">
                <h3 class="wb-small-heading">
                  <a href="{{ product.url }}" data-product-url="{{ product.url }}">{{ product.title }}</a>
                </h3>
                <p class="wb-custom-card-price">
                  {%- if sold_out -%}Sold out{%- else -%}From {{ product.price_min | money }}{%- endif -%}
                </p>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

    </div>
  </div>
</section>

<div class="wb-custom-bottom" id="wb-custom-bottom" style="display:none">
  <div class="wb-container">

    <div id="wb-blend-panel" style="display:none">
      <div class="wb-padding">
        <h3 class="wb-small-heading">Safe an&rsquo; sound</h3>
        <p>Your whisky is saved. Use the options above to order now, or come back to it any time using your unique blend code below.</p>
        <div id="wb-blendcode-ui"></div>
      </div>
    </div>

    <div id="wb-noblend-cta" style="display:none">
      <section class="wb-banded">
        <div class="wb-container">
          <div class="wb-padding">
            {%- if section.settings.cta_image != blank -%}
              <div class="wb-right-image">
                {{ section.settings.cta_image | image_url: width: 400 | image_tag:
                  loading: 'lazy',
                  alt: '',
                  class: section.settings.cta_image_class
                }}
              </div>
            {%- endif -%}
            {%- if section.settings.cta_heading != blank -%}
              <h2 class="wb-medium-heading">{{ section.settings.cta_heading }}</h2>
            {%- endif -%}
            {%- if section.settings.cta_description != blank -%}
              <p>{{ section.settings.cta_description }}</p>
            {%- endif -%}
            <div class="wb-buttons">
              {%- if section.settings.cta_primary_button_text != blank -%}
                <a href="{{ section.settings.cta_primary_button_url }}" class="wb-button wb-primary-button">
                  {{ section.settings.cta_primary_button_text }}
                </a>
              {%- endif -%}
              {%- if section.settings.cta_secondary_button_text != blank -%}
                <a href="{{ section.settings.cta_secondary_button_url }}" class="wb-button">
                  {{ section.settings.cta_secondary_button_text }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </section>
    </div>

  </div>
</div>

<dialog id="wb-invalid-dialog" class="wb-dialog">
  <div class="wb-dialog-inner">
    <h3 class="wb-small-heading">That blend code doesn&rsquo;t look right</h3>
    <p>The link might be incomplete or the code may have changed. You can enter a blend code below, or start fresh.</p>
    <button class="wb-button wb-primary-button" id="wb-dialog-ok">Got it</button>
  </div>
</dialog>

<script>
(function () {
  var PHRASES = [
    "Ya dancer!", "Yaldy!", "Ya wee blender ye!", "Gie's some!",
    "Gawjus!", "Belter!", "Tasty AF!", "Magic!", "Amazin'!",
    "Well done!", "Lookin' guid!", "Canny wait!",
    "Let's get dressed!", "Liquid gold!"
  ];

  var COPY_ICON = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
  var TICK_ICON = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
  var SHARE_ICON = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>';

  function esc(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  var apiBase = 'https://lab.whiskyblender.com';

  function fetchWithTimeout(url, ms) {
    var ctrl = new AbortController();
    var id = setTimeout(function () { ctrl.abort(); }, ms);
    return fetch(url, { signal: ctrl.signal }).then(
      function (res) { clearTimeout(id); return res; },
      function (err) { clearTimeout(id); throw err; }
    );
  }

  var rawBlend   = new URLSearchParams(window.location.search).get('blend') || '';
  var blend      = rawBlend.trim();
  var looksValid = blend.length >= 6 && /^[A-Za-z0-9_-]+$/.test(blend);
  var heading    = document.getElementById('wb-custom-heading');
  var sub        = document.getElementById('wb-custom-sub');
  var bottom     = document.getElementById('wb-custom-bottom');
  var grid       = document.getElementById('wb-custom-grid');

  function buildBlendCodeUi() {
    var shareUrl = window.location.origin + window.location.pathname + '?blend=' + encodeURIComponent(blend);
    var ui       = document.getElementById('wb-blendcode-ui');
    var actions  = document.createElement('div');
    actions.className = 'wb-custom-blend-actions';

    var box = document.createElement('div');
    box.className = 'wb-blendcode-box';
    box.innerHTML = '<span class="wb-blendcode-digits">' + blend + '</span>';

    var copyBtn = document.createElement('button');
    copyBtn.className = 'wb-button wb-primary-button';
    copyBtn.innerHTML = COPY_ICON + '&nbsp;Copy link';
    copyBtn.addEventListener('click', function () {
      copyBtn.style.minWidth = copyBtn.offsetWidth + 'px';
      navigator.clipboard.writeText(shareUrl).then(function () {
        copyBtn.innerHTML = TICK_ICON + '&nbsp;Copied!';
        setTimeout(function () { copyBtn.innerHTML = COPY_ICON + '&nbsp;Copy link'; }, 2000);
      }).catch(function () {});
    });
    actions.appendChild(box);
    actions.appendChild(copyBtn);

    var shareBtn = document.createElement('button');
    shareBtn.className = 'wb-button';
    shareBtn.innerHTML = SHARE_ICON + '&nbsp;Share';
    shareBtn.addEventListener('click', function () {
      if (navigator.share) {
        navigator.share({ title: 'My Whisky Blend', url: shareUrl });
      } else {
        navigator.clipboard.writeText(shareUrl).then(function () {
          shareBtn.innerHTML = TICK_ICON + '&nbsp;Copied!';
          setTimeout(function () { shareBtn.innerHTML = SHARE_ICON + '&nbsp;Share'; }, 2000);
        }).catch(function () {});
      }
    });
    actions.appendChild(shareBtn);
    ui.appendChild(actions);
  }

  function revealNormal() {
    heading.textContent = PHRASES[Math.floor(Math.random() * PHRASES.length)];
    sub.textContent     = 'Now choose how you want to bottle your whisky…';
    document.querySelectorAll('[data-product-url]').forEach(function (el) {
      el.href = el.getAttribute('data-product-url') + '?blend=' + encodeURIComponent(blend);
    });
    if (grid) grid.style.visibility = '';
    bottom.style.display = '';
    document.getElementById('wb-blend-panel').style.display = '';
    buildBlendCodeUi();
  }

  function showInactiveWarning() {
    var labHref = '/pages/the-lab?blend=' + encodeURIComponent(blend);
    heading.textContent = '';
    sub.textContent     = '';
    var warn = document.createElement('div');
    warn.innerHTML =
      '<div style="text-align:center; padding-top:80px; padding-bottom:80px; max-width:560px; margin:0 auto;">' +
        '<p aria-hidden="true" style="font-size:28px; font-weight:700; margin:0 0 16px;">&#x00AF;\\_(&#x30C4;)_/&#x00AF;</p>' +
        '<h2 class="wb-medium-heading">A wee problem</h2>' +
        '<p>The saddest part of great tasting whisky is that every cask eventually empties. Sadly your blend featured some whisky that is officially all gone now.</p>' +
        '<p style="margin-top:24px;">Now you have a chance to renew your recipe with our current casks.</p>' +
        '<p style="margin-top:32px;"><a href="' + esc(labHref) + '" class="wb-button wb-primary-button">Back to the lab</a></p>' +
      '</div>';
    if (grid) {
      grid.style.display = 'none';
      grid.parentNode.insertBefore(warn, grid);
    } else {
      heading.insertAdjacentElement('afterend', warn);
    }
  }

  function checkBlendAndRender() {
    heading.textContent = 'Loading…';
    sub.textContent     = '';
    if (grid) grid.style.visibility = 'hidden';

    Promise.all([
      fetchWithTimeout(apiBase + '/api/blend?slug=' + encodeURIComponent(blend), 10000)
        .then(function (res) { return res.ok ? res.json() : null; })
        .catch(function () { return null; }),
      fetchWithTimeout(apiBase + '/api/whisky-options', 10000)
        .then(function (res) { return res.ok ? res.json() : null; })
        .catch(function () { return null; })
    ]).then(function (results) {
      var blendData     = results[0];
      var activeOptions = results[1];

      /* API is up but blend not found — show the invalid-code dialog */
      if (!blendData && activeOptions !== null) {
        var dialog = document.getElementById('wb-invalid-dialog');
        if (dialog && dialog.showModal) {
          document.getElementById('wb-dialog-ok').addEventListener('click', function () {
            dialog.close();
            initNoblend();
          });
          dialog.showModal();
        } else {
          initNoblend();
        }
        return;
      }

      var inactiveNames = [];
      if (blendData && activeOptions) {
        var activeIds = activeOptions.map(function (o) { return o.identifier; });
        var recipe    = Array.isArray(blendData.recipe) ? blendData.recipe : [];
        inactiveNames = recipe
          .filter(function (item) { return item.amount > 0 && activeIds.indexOf(item.identifier) === -1; })
          .map(function (i) { return i.name; });
      }
      if (inactiveNames.length > 0) {
        showInactiveWarning();
      } else {
        revealNormal();
      }
    }).catch(function () {
      revealNormal();
    });
  }

  function initNoblend() {
    heading.textContent = 'Bottle options';
    sub.textContent     = 'There are a few different bottles we can offer, but first you need to decide what to fill it with.';
    document.getElementById('wb-noblend-actions').style.display = '';
    var cta = document.getElementById('wb-noblend-cta');
    if (cta) { bottom.style.display = ''; cta.style.display = ''; }

    var codeInput = document.getElementById('wb-code-input');
    var codeGo    = document.getElementById('wb-code-go');
    codeInput.addEventListener('input', function () {
      codeGo.disabled = codeInput.value.trim().length < 6;
    });
    function submitCode() {
      var code = codeInput.value.trim().toUpperCase();
      if (code.length >= 6) {
        codeGo.disabled = true;
        codeGo.textContent = 'Loading…';
        window.location.href = window.location.pathname + '?blend=' + encodeURIComponent(code);
      }
    }
    codeGo.addEventListener('click', submitCode);
    codeInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') submitCode(); });
  }

  /* ── Invalid code in URL ─────────────────────────────────────── */
  if (blend && !looksValid) {
    var dialog = document.getElementById('wb-invalid-dialog');
    if (dialog && dialog.showModal) {
      document.getElementById('wb-dialog-ok').addEventListener('click', function () { dialog.close(); });
      dialog.showModal();
    }
    blend = '';
  }

  /* ── Route ───────────────────────────────────────────────────── */
  if (blend) {
    checkBlendAndRender();
  } else {
    initNoblend();
  }

})();
</script>

{% schema %}
{
  "name": "WB - Custom Options",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Products collection"
    },
    {
      "type": "header",
      "content": "No-blend state"
    },
    {
      "type": "url",
      "id": "create_url",
      "label": "\"Create something\" button URL"
    },
    {
      "type": "text",
      "id": "create_label",
      "label": "\"Create something\" button label",
      "default": "Create something"
    },
    {
      "type": "header",
      "content": "No-blend CTA panel"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "cta_description",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "cta_image",
      "label": "Decorative image (floats right on desktop)"
    },
    {
      "type": "text",
      "id": "cta_image_class",
      "label": "Image CSS class",
      "info": "e.g. wb-foryersel, wb-yourownbrand",
      "default": "wb-foryersel"
    },
    {
      "type": "text",
      "id": "cta_primary_button_text",
      "label": "Primary button text"
    },
    {
      "type": "url",
      "id": "cta_primary_button_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_button_text",
      "label": "Secondary button text"
    },
    {
      "type": "url",
      "id": "cta_secondary_button_url",
      "label": "Secondary button URL"
    }
  ],
  "presets": [
    {
      "name": "WB - Custom Options"
    }
  ]
}
{% endschema %}
