<section class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding">
      <h1 class="wb-large-heading">{{ section.settings.heading | default: 'Um...' }}</h1>
      <p>{{ section.settings.message | default: "This page doesn't exist — or it's been moved. Either way, there's nothing here." }}</p>
      <div class="wb-buttons">
        <a href="{{ section.settings.primary_url | default: '/' }}" class="wb-button wb-primary-button">
          {{ section.settings.primary_label | default: 'Back to home' }}
        </a>
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_url | default: '/pages/shop' }}" class="wb-button">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WB - 404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Um..."
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "This page doesn't exist — or it's been moved. Either way, there's nothing here."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Back to home"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Visit the shop"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary button URL"
    }
  ],
  "presets": [
    {
      "name": "WB - 404"
    }
  ]
}
{% endschema %}
