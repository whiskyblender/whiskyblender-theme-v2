{{ 'wb-marquee.css' | asset_url | stylesheet_tag }}
{{ 'wb-reels.css' | asset_url | stylesheet_tag }}
{{ 'wb-collaborate.css' | asset_url | stylesheet_tag }}

<section class="wb-overflow-hidden-x">
  <div class="wb-container">
    <div class="wb-padding wb-collection-copy">
      <p>We work with individuals, brands, and businesses to craft bespoke bottles of Scotch whisky that tell a story &mdash; so <a href="#wb-getintouch">tell us yours</a>.</p>
      <p>Whether you're launching a limited-edition release, celebrating a milestone, or building something entirely new, our team helps you create a Scotch that carries your name, your values, and your taste.</p>
      <p>From cask selection and blending to design, bottling, and packaging, we'll guide you through each step of the journey. The result? A whisky that's uniquely yours — authentic, memorable, and made to share.</p>
    </div>

    {%- comment -%}
      The nine photos are rendered twice: the marquee scrolls by exactly -50%,
      so the second set lands seamlessly where the first began. The duplicates
      are aria-hidden with empty alt so they aren't announced twice.
      See assets/wb-marquee.css.
    {%- endcomment -%}
    <div class="wb-marquee wb-collabs" style="--wb-marquee-duration: 6.7s">
      <ul class="wb-marquee__track wb-collabphotos" role="list">
          <li class="wb-marquee__item wb-collabphoto">
            <img src="{{ '01_hoonjuice.webp' | asset_url }}" alt="Hoon Juice collaboration" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto">
            <img src="{{ '02_glasgow850.jpg' | asset_url }}" alt="Glasgow 850 collaboration" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto">
            <img src="{{ '03_goldendrop.jpg' | asset_url }}" alt="Golden Drop collaboration" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto">
            <img src="{{ '04_joeydunlop.jpg' | asset_url }}" alt="Joey Dunlop collaboration" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto">
            <img src="{{ '05_caskslug.webp' | asset_url }}" alt="Cask Slug collaboration" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto">
            <img src="{{ '06_alba.jpg' | asset_url }}" alt="Alba collaboration" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto">
            <img src="{{ '07_oldsport.jpg' | asset_url }}" alt="Old Sport collaboration" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto">
            <img src="{{ '08_joker.jpg' | asset_url }}" alt="Joker collaboration" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto">
            <img src="{{ '09_dramsylvania.jpg' | asset_url }}" alt="Dramsylvania collaboration" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto" aria-hidden="true">
            <img src="{{ '01_hoonjuice.webp' | asset_url }}" alt="" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto" aria-hidden="true">
            <img src="{{ '02_glasgow850.jpg' | asset_url }}" alt="" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto" aria-hidden="true">
            <img src="{{ '03_goldendrop.jpg' | asset_url }}" alt="" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto" aria-hidden="true">
            <img src="{{ '04_joeydunlop.jpg' | asset_url }}" alt="" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto" aria-hidden="true">
            <img src="{{ '05_caskslug.webp' | asset_url }}" alt="" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto" aria-hidden="true">
            <img src="{{ '06_alba.jpg' | asset_url }}" alt="" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto" aria-hidden="true">
            <img src="{{ '07_oldsport.jpg' | asset_url }}" alt="" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto" aria-hidden="true">
            <img src="{{ '08_joker.jpg' | asset_url }}" alt="" loading="lazy" width="600" height="600">
          </li>
          <li class="wb-marquee__item wb-collabphoto" aria-hidden="true">
            <img src="{{ '09_dramsylvania.jpg' | asset_url }}" alt="" loading="lazy" width="600" height="600">
          </li>
      </ul>
    </div>
  </div>
</section>

<section class="wb-banded" id="wb-getintouch">
  <div class="wb-container">
    <div class="wb-padding">
      {% render 'wb-contact-wizard' %}
    </div>
  </div>
</section>

