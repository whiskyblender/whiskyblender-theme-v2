<script>
(function () {
  var raw = window.location.pathname;
  var p = raw.toLowerCase();

  /* ── Redirect rules ──────────────────────────────────────────────────────── */
  if (p === '/blend') {
    window.location.replace('/pages/the-lab');
  } else if (p.indexOf('/blend/') === 0) {
    var id = raw.slice('/blend/'.length);
    window.location.replace('/pages/the-lab' + (id ? '?blend=' + encodeURIComponent(id) : ''));
  } else if (p === '/thelab' || p === '/the-lab') {
    window.location.replace('/pages/the-lab');
  } else if (p === '/create') {
    window.location.replace('/pages/the-lab');
  } else if (p === '/contact') {
    window.location.replace('/pages/contact');
  } else if (p === '/basket') {
    window.location.replace('/cart');

  /* ── No redirect: render the correct 404 variant ────────────────────────── */
  } else {
    var variant = p.indexOf('/products/') === 0 ? 'product' : 'generic';

    /* Show the right section (CSS hides both by default) */
    document.documentElement.classList.add('wb-404-' + variant);

    /* Override page title for the product variant */
    if (variant === 'product') {
      document.title = 'Blend unavailable – Whisky Blender';
    }

    /* Fire page-load event — skip headless crawlers */
    if (!navigator.webdriver && typeof gtag === 'function') {
      gtag('event', 'error_404', { variant: variant, requested_path: raw });
    }

    /* Wire CTA click events once the section markup is in the DOM */
    document.addEventListener('DOMContentLoaded', function () {
      var section = document.querySelector('.wb-404-' + variant + '-section');
      if (!section) return;
      section.querySelectorAll('.wb-button, .wb-create-options li').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (!navigator.webdriver && typeof gtag === 'function') {
            gtag('event', 'cta_404_click', { variant: variant, requested_path: raw });
          }
        });
      });
    });
  }
})();
</script>

<style>
  .wb-404-product-section,
  .wb-404-generic-section {
    display: none;
  }

  .wb-404-product .wb-404-product-section,
  .wb-404-generic .wb-404-generic-section {
    display: block;
  }

  .wb-404-lede {
    max-width: 560px;
    margin-top: 16px;
  }

  .wb-404-ctas {
    margin-top: 28px;
  }

  .wb-404-product-section p {
    max-width: 520px;
  }
</style>

<section class="wb-first-item wb-404-product-section">
  <div class="wb-container">
    <div class="wb-padding">
      <h1 class="wb-medium-heading">Aw done!</h1>
      <p class="wb-404-lede wb-collection-copy">Every whisky cask is one of a kind. Once it's been drained, it's gone — there's no going back for more of the same.</p>
      <p class="wb-collection-copy">Whatever blend used to live at this address was made with whisky that's no longer available. That's just the nature of Scotch. But you can make something just as special — something that's entirely yours.</p>
      <div class="wb-buttons wb-404-ctas">
        <a href="/pages/the-lab" class="wb-button wb-primary-button">Create a new whisky</a>
        <a href="/pages/contact" class="wb-button">Get in touch</a>
      </div>
    </div>
  </div>
</section>

<section class="wb-first-item wb-404-generic-section">
  <div class="wb-container">
    <div class="wb-padding">
      <h1 class="wb-medium-heading">Sorry, boss!</h1>
      <p class="wb-404-lede wb-collection-copy">The page you're looking for doesn't exist at this address — it may have moved, or it was never here in the first place.</p>
      <ul class="wb-create-options wb-cards">
        <li onclick="location.href='/pages/the-lab';">
          <span class="wb-create-icon">💡</span>
          <h2 class="wb-option-heading">Create a new whisky in <a href="/pages/the-lab">the lab</a></h2>
        </li>
        <li onclick="location.href='{{ routes.collections_url }}/single-malts';">
          <span class="wb-create-icon">🥃</span>
          <h2 class="wb-option-heading">Name your own <a href="{{ routes.collections_url }}/single-malts">single malt</a></h2>
        </li>
        <li onclick="location.href='/products/gift-voucher';">
          <span class="wb-create-icon">💌</span>
          <h2 class="wb-option-heading">Give someone a <a href="/products/gift-voucher">whisky voucher</a></h2>
        </li>
      </ul>
    </div>
  </div>
</section>
