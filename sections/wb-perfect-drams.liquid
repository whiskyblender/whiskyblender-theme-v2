{{ 'wb-perfectdrams.css' | asset_url | stylesheet_tag }}

<section class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding wb-collection-copy">
      <h1 class="wb-large-heading">{{ section.settings.heading | default: 'Perfect drams' }}</h1>
      <p>{{ section.settings.intro }}</p>

      <ul class="wb-cards wb-main-cards" id="wb-perfect-drams-cards">
        {%- for block in section.blocks -%}
          {%- assign href = block.settings.url | default: '/pages/the-lab' -%}
          <li
            onclick="location.href='{{ href }}';"
            data-href="{{ href }}"
            data-recipe="{{ block.settings.recipe }}"
            data-name="{{ block.settings.name | escape }}"
            {{ block.shopify_attributes }}
          >
            <div class="wb-card-image">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.name, loading: 'lazy' }}
              {%- elsif block.settings.image_asset != blank -%}
                <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.name }}" loading="lazy" />
              {%- endif -%}
            </div>
            <div class="wb-card-details">
              <h3 class="wb-small-heading">
                <a href="{{ href }}">{{ block.settings.name }}</a>
              </h3>
              <span class="wb-emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
              <p>{{ block.settings.description }} &#8594;</p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

<script>
(function () {
  var cards = document.querySelectorAll('#wb-perfect-drams-cards li');
  cards.forEach(function (card) {
    var recipeStr = card.getAttribute('data-recipe') || '';
    var recipe = recipeStr.split(',').map(function (n) { return parseInt(n.trim(), 10) || 0; });
    if (recipe.length !== 5 || recipe.reduce(function (a, b) { return a + b; }, 0) !== 100) return;

    var code = 'WB' + (Math.floor(Math.random() * 900000) + 100000);
    try {
      sessionStorage.setItem('wb_' + code, JSON.stringify({
        name:    card.getAttribute('data-name') || '',
        creator: 'whiskyblender.com',
        recipe:  recipe,
      }));
    } catch (e) {}

    var href = (card.getAttribute('data-href') || '/pages/the-lab') + '?blend=' + code;
    card.setAttribute('onclick', "location.href='" + href + "';");
    var link = card.querySelector('a');
    if (link) link.href = href;
  });
})();
</script>

{% schema %}
{
  "name": "WB - Perfect Drams",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Perfect drams"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Forget about what they like, and think about what THEY'RE like. Different whiskies have different characteristics, just like people. Find one that sounds perfect for the person you're buying for and label it up for them."
    }
  ],
  "blocks": [
    {
      "type": "dram",
      "name": "Dram Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Upload a custom image. If left blank, the theme asset below is used."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset filename",
          "info": "Used as a fallback if no image is selected above (e.g. wb-richandbold.png)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Card link URL"
        },
        {
          "type": "text",
          "id": "recipe",
          "label": "Lab recipe",
          "info": "5 comma-separated percentages summing to 100. Order: Banana split, Malted bacon, Spicy beeswax, Salty butter, Charred marshmallow."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB - Perfect Drams"
    }
  ]
}
{% endschema %}
