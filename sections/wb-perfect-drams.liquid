{{ 'wb-perfectdrams.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Perfect Drams (reworked 24 Oct 2026). Each card goes to the default custom bottle
  with one of the four house presets picked and the dram's name in the label:
  ?preset=<slug>&label=<text>, read by assets/wb-blend-product.js. Two drams can share
  a preset; the label is the difference. The 500ml flat is the main link (Andrew,
  13 Oct: one step to the cart for gift buyers); a small "or 200ml" link sits beside it.
  Prices are live from the products via wb-money.
{%- endcomment -%}
{%- liquid
  assign main_product  = section.settings.main_product  | default: all_products['custom-whisky-500ml-flat']
  assign small_product = section.settings.small_product | default: all_products['custom-whisky-200ml-flat']
-%}

<style>
  /* Own line-height: it otherwise inherits a fixed 24px from the card text */
  .wb-dram-flavours {
    margin: 2px 0 6px;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #666666;
  }
  #wb-perfect-drams-cards .wb-dram-desc { margin: 0; }
  /* Size links. The card's overlay link (z-index 2) goes to the 500ml; these sit above
     it (see the stacking note above). Each link is padded out to a 44px-tall tap area, with a 12px gap
     between them, so a tap meant for the 200ml can't land on the 500ml or the card.
     The negative margin keeps the first link's text lined up with the card text. */
  /* The card text sits in its own stacking layer (.wb-card-details has z-index 1), which
     kept any link inside it under the overlay whatever its own z-index. Lift the text
     above the overlay but let taps on plain text fall through to the card; only the
     links inside take taps. */
  #wb-perfect-drams-cards .wb-card-details { z-index: 3; pointer-events: none; }
  #wb-perfect-drams-cards .wb-card-details a { pointer-events: auto; }
  .wb-dram-sizes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 12px;
    margin: 6px 0 -10px -12px;
  }
  #wb-perfect-drams-cards .wb-dram-size {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }
  #wb-perfect-drams-cards .wb-dram-size--main { color: #107a5f; }
  #wb-perfect-drams-cards .wb-dram-size--small { color: #555555; font-weight: 600; }
  .wb-dram-size span { display: inline-block; margin-left: 4px; transition: transform 0.2s; }
  .wb-dram-size:hover span, .wb-dram-size:focus-visible span { transform: translateX(3px); }
  .wb-dram-size:focus-visible { outline: 2px solid #107a5f; outline-offset: -4px; border-radius: 6px; }
  .wb-dram-phone-line { display: none; }

  /* Phones: compact cards. The image runs the full height of the card down its left
     edge (touching top, left and bottom); no emoji on phones.
     Six full-width image cards ran ~2,600px; this is roughly half. Desktop keeps the
     existing image-top grid with the emoji over the image's bottom-right corner. */
  @media screen and (max-width: 767px) {
    #wb-perfect-drams-cards { gap: 12px; }
    #wb-perfect-drams-cards li {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 0 14px;
      align-items: stretch;
      padding: 0;
      border: 0;
      border-radius: 12px;
      overflow: hidden;
      background-color: #f2f2f2;
    }
    #wb-perfect-drams-cards .wb-card-image {
      position: relative;
      width: 120px;
      height: auto;
      min-height: 150px;
      border-radius: 0;
    }
    /* Pinned to the box so it fills the card's full height, whatever the text. The
       photos are wide banners with the glass ~35% from the left in all six; the
       narrow crop sits at 30% (Andrew's call) rather than 50%. */
    #wb-perfect-drams-cards .wb-card-image img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100% !important;
      object-fit: cover;
      object-position: 30% 50%;
    }
    /* No emoji on phones (Andrew, 24 Oct), so the text gets the full width */
    #wb-perfect-drams-cards .wb-card-details { position: static; min-width: 0; padding: 14px 14px 14px 0; }
    #wb-perfect-drams-cards .wb-card-details .wb-emoji { display: none; }
    #wb-perfect-drams-cards .wb-small-heading { margin: 0; font-size: 26px; line-height: 24px; }
    /* Phones show one whole sentence (the card's "phone line": who the dram suits)
       instead of the full description cut off at two lines. No line, no text. */
    #wb-perfect-drams-cards .wb-dram-desc { display: none; }
    #wb-perfect-drams-cards .wb-dram-phone-line { display: block; margin: 0; font-size: 15px; line-height: 1.45; }
    .wb-dram-sizes { margin-top: 2px; margin-bottom: -12px; }
  }
</style>

<section class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding wb-collection-copy">
      <h1 class="wb-large-heading">{{ section.settings.heading | default: 'Perfect drams' }}</h1>
      <p>{{ section.settings.intro }}</p>
      {%- capture small_price -%}{% render 'wb-money', amount: small_product.price_min, code: false %}{%- endcapture -%}
      {%- capture main_price -%}{% render 'wb-money', amount: main_product.price_min, code: false %}{%- endcapture -%}
      {% render 'wb-info-strip',
        size_1_label: '200ml',
        size_1_price: small_price,
        size_2_label: '500ml',
        size_2_price: main_price
      %}

      <ul class="wb-cards wb-main-cards" id="wb-perfect-drams-cards">
        {%- for block in section.blocks -%}
          {%- liquid
            assign label_text = block.settings.label | default: block.settings.name | strip
            assign label_param = label_text | url_encode
            assign href = main_product.url | append: '?preset=' | append: block.settings.preset | append: '&label=' | append: label_param
            assign small_href = small_product.url | append: '?preset=' | append: block.settings.preset | append: '&label=' | append: label_param
          -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ href }}" class="wb-card-link-overlay" aria-hidden="true" tabindex="-1"></a>
            <div class="wb-card-image">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 1024 | image_tag: alt: block.settings.name, loading: 'lazy', widths: '400, 800, 1024', sizes: '(max-width: 767px) 560px, 33vw' }}
              {%- elsif block.settings.image_asset != blank -%}
                <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.name }}" loading="lazy" />
              {%- endif -%}
            </div>
            <div class="wb-card-details">
              <h3 class="wb-small-heading">
                <a href="{{ href }}">{{ block.settings.name }}</a>
              </h3>
              <span class="wb-emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
              {%- comment -%} Flavour words belong to the recipe, so cards sharing a preset match {%- endcomment -%}
              {%- case block.settings.preset -%}
                {%- when 'WB00836' -%}{%- assign flavours = section.settings.flavours_smoke_on_the_water -%}
                {%- when 'WB00821' -%}{%- assign flavours = section.settings.flavours_sweet_tooth -%}
                {%- when 'WB00820' -%}{%- assign flavours = section.settings.flavours_soft_and_fruity -%}
                {%- else -%}{%- assign flavours = section.settings.flavours_all_rounder -%}
              {%- endcase -%}
              {%- if flavours != blank -%}
                <p class="wb-dram-flavours">{{ flavours }}</p>
              {%- endif -%}
              <p class="wb-dram-desc">{{ block.settings.description }}</p>
              {%- if block.settings.phone_line != blank -%}
                <p class="wb-dram-phone-line">{{ block.settings.phone_line }}</p>
              {%- endif -%}
              <p class="wb-dram-sizes">
                <a class="wb-dram-size wb-dram-size--main" href="{{ href }}">500ml<span aria-hidden="true">&rarr;</span></a>
                <a class="wb-dram-size wb-dram-size--small" href="{{ small_href }}">200ml<span aria-hidden="true">&rarr;</span></a>
              </p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WB - Perfect Drams",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Perfect drams"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Forget what they like. Think about what they're like. Pick the whisky that matches them, and we'll put their name on it."
    },
    {
      "type": "product",
      "id": "main_product",
      "label": "Main bottle (500ml)",
      "info": "Cards link here with the dram's preset and label. Leave blank for the 500ml flat."
    },
    {
      "type": "product",
      "id": "small_product",
      "label": "Smaller bottle (200ml)",
      "info": "Each card's 200ml link, and the 200ml price in the sizes box at the top. Leave blank for the 200ml flat."
    },
    {
      "type": "header",
      "content": "Flavour words (per whisky)"
    },
    {
      "type": "paragraph",
      "content": "Shown under each dram's name. They describe the recipe, so every card using the same house preset shows the same words."
    },
    {
      "type": "text",
      "id": "flavours_all_rounder",
      "label": "All rounder",
      "default": "Sea salt · oak · malt"
    },
    {
      "type": "text",
      "id": "flavours_smoke_on_the_water",
      "label": "Smoke on the Water",
      "default": "Smoke · caramel · sea salt"
    },
    {
      "type": "text",
      "id": "flavours_soft_and_fruity",
      "label": "Soft & fruity",
      "default": "Banana · vanilla · spice"
    },
    {
      "type": "text",
      "id": "flavours_sweet_tooth",
      "label": "Sweet tooth",
      "default": "Vanilla · sea salt · smoke"
    }
  ],
  "blocks": [
    {
      "type": "dram",
      "name": "Dram Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Upload a custom image. If left blank, the theme asset below is used."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset filename",
          "info": "Fallback if no image selected above (e.g. wb-richandbold.png)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "phone_line",
          "label": "Phone line",
          "info": "One whole sentence shown on phones instead of the description, e.g. who the dram suits. Leave blank to show no text on phones."
        },
        {
          "type": "select",
          "id": "preset",
          "label": "Whisky (house preset)",
          "options": [
            {
              "value": "WB01767",
              "label": "All rounder"
            },
            {
              "value": "WB00836",
              "label": "Smoke on the Water"
            },
            {
              "value": "WB00820",
              "label": "Soft & fruity"
            },
            {
              "value": "WB00821",
              "label": "Sweet tooth"
            }
          ],
          "default": "WB01767",
          "info": "Must be one of the house presets on the custom bottle pages (assets/wb-blend-product.js)."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label text",
          "info": "Prefilled on the bottle page; the customer can change it. Leave blank to use the name. Max 32 characters."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB - Perfect Drams"
    }
  ]
}
{% endschema %}
