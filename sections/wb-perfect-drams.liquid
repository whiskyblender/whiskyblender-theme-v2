{{ 'wb-perfectdrams.css' | asset_url | stylesheet_tag }}

{%- assign options_base = section.settings.custom_options_url | default: '/pages/custom-options' | strip -%}

<section class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding wb-collection-copy">
      <h1 class="wb-large-heading">{{ section.settings.heading | default: 'Perfect drams' }}</h1>
      <p>{{ section.settings.intro }}</p>

      <ul class="wb-cards wb-main-cards" id="wb-perfect-drams-cards">
        {%- for block in section.blocks -%}
          {%- assign blend_code = block.settings.blend_code | strip -%}
          {%- if blend_code != blank -%}
            {%- assign href = options_base | append: '?blend=' | append: blend_code -%}
          {%- else -%}
            {%- assign href = options_base -%}
          {%- endif -%}
          <li
            {{ block.shopify_attributes }}
          >
            <a href="{{ href }}" class="wb-card-link-overlay" aria-hidden="true" tabindex="-1"></a>
            <div class="wb-card-image">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.name, loading: 'lazy' }}
              {%- elsif block.settings.image_asset != blank -%}
                <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.name }}" loading="lazy" />
              {%- endif -%}
            </div>
            <div class="wb-card-details">
              <h3 class="wb-small-heading">
                <a href="{{ href }}">{{ block.settings.name }}</a>
              </h3>
              <span class="wb-emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
              <p>{{ block.settings.description }} &#8594;</p>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WB - Perfect Drams",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Perfect drams"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Forget about what they like, and think about what THEY'RE like. Different whiskies have different characteristics, just like people. Find one that sounds perfect for the person you're buying for and label it up for them."
    },
    {
      "type": "url",
      "id": "custom_options_url",
      "label": "Bottle options page URL",
      "info": "The page where customers choose their bottle format. Each dram card links here with the blend code appended."
    }
  ],
  "blocks": [
    {
      "type": "dram",
      "name": "Dram Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Upload a custom image. If left blank, the theme asset below is used."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset filename",
          "info": "Fallback if no image selected above (e.g. wb-richandbold.png)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "blend_code",
          "label": "Blend code",
          "info": "The premade blend's slug from the app — e.g. WB000042. Create premade blends in the Shopify app admin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB - Perfect Drams"
    }
  ]
}
{% endschema %}
