<style>
  #wb-legal h2,
  #wb-legal h3 {
    font-size: 1em;
    font-weight: 700;
    margin: 24px 0 8px;
  }
  #wb-legal ul {
    padding-left: 24px;
  }
  #wb-legal li { margin-bottom: 8px; }
  #wb-legal a { color: inherit; }
</style>

<div id="wb-legal">
  <h1 style="display:none">Legal</h1>
  {%- for policy in shop.policies -%}
    {%- unless policy.url == '/policies/privacy-policy' -%}
      {%- case policy.url -%}
        {%- when '/policies/terms-of-service' -%}{%- assign display_title = 'Terms & conditions' -%}
        {%- when '/policies/shipping-policy' -%}{%- assign display_title = 'Disclaimer' -%}
        {%- when '/policies/contact-information' -%}{%- assign display_title = 'Company information' -%}
        {%- when '/policies/refund-policy' -%}{%- assign display_title = 'Return & refund policy' -%}
        {%- else -%}{%- assign display_title = policy.title -%}
      {%- endcase -%}
      <section class="wb-banded">
        <div class="wb-container">
          <div class="wb-padding">
            <h2 class="wb-medium-heading">{{ display_title }}</h2>
            {{ policy.body }}
          </div>
        </div>
      </section>
    {%- endunless -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "WB - Legal Page",
  "settings": []
}
{% endschema %}
