<style>
  #wb-legal .wb-policy-body h2,
  #wb-legal .wb-policy-body h3 {
    font-size: 1em;
    font-weight: 700;
    margin: 24px 0 8px;
  }
  #wb-legal ul {
    padding-left: 24px;
  }
  #wb-legal li { margin-bottom: 8px; }
  #wb-legal a { color: inherit; }
</style>

<div id="wb-legal">
  <h1 style="display:none">Policies</h1>
  {%- for policy in shop.policies -%}
    <section class="wb-banded">
      <div class="wb-container">
        <div class="wb-padding">
          <h2 class="wb-medium-heading">{{ policy.title }}</h2>
          <div class="wb-policy-body">{{ policy.body }}</div>
        </div>
      </div>
    </section>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "WB - Legal Page",
  "settings": []
}
{% endschema %}
