{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding wb-collection-copy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'page_header' -%}
            <h1 class="wb-large-heading">{{ page.title | escape }}</h1>
            <p>
              {{ page.content }}
            </p>

          {%- when 'wb_grid' -%}
            {%- assign grid_items = page.metafields.custom.grid_data.value -%}
            <div {{ block.shopify_attributes }}>
              <div class="wb-container">
                <div class="wb-padding">
                  <ul class="wb-productsgrid" role="list">
                    {%- for grid_item in grid_items -%}
                      {%- assign item_title = grid_item.title.value -%}
                      {%- assign item_description = grid_item.description.value -%}
                      {%- assign item_image = grid_item.image.value -%}
                      {%- assign item_link = grid_item.link.value -%}

                      <li
                        class="wb-productcell"
                        {% if item_link == blank %}
                          style="pointer-events: none"
                        {% endif %}
                      >
                        {%- if item_link != blank -%}
                          <a href="{{ item_link }}" class="wb-productitem">
                        {%- else -%}
                          <div class="wb-productitem">
                        {%- endif -%}
                        <div class="wb-productmedia">
                          <div class="wb-productimage">
                            {%- if item_image != blank -%}
                              {{
                                item_image
                                | image_url: width: 1000
                                | image_tag:
                                  loading: 'lazy',
                                  widths: '220, 320, 480, 640, 800, 1000',
                                  alt: item_image.alt
                                | default: item_title
                              }}
                            {%- endif -%}
                          </div>
                        </div>
                        <div class="wb-productcontent">
                          <div class="wb-productinfo">
                            {%- if item_title != blank -%}
                              <h3 class="wb-producttitle wb-tiny-heading">{{ item_title | escape }}</h3>
                            {%- endif -%}
                            {%- if item_description != blank -%}
                              <div class="wb-productdetails">{{ item_description }}</div>
                            {%- endif -%}
                          </div>
                        </div>
                        {%- if item_link != blank -%}
                          </a>
                        {%- else -%}
                          </div>
                        {%- endif -%}
                      </li>
                    {%- else -%}
                      {%- if request.design_mode -%}
                        <li class="wb-productcell" style="pointer-events: none">
                          <div class="wb-productitem">
                            <div class="wb-productcontent">
                              <div class="wb-productinfo">
                                <h3 class="wb-producttitle wb-tiny-heading">WB - Grid</h3>
                                <div class="wb-productdetails">
                                  Add grid_item entries to the page metafield custom.grid_data to populate this grid.
                                </div>
                              </div>
                            </div>
                          </div>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            </div>

            {%- liquid
              assign fetch_priority = 'auto'
              if section.index == 1
                assign fetch_priority = 'high'
              endif
              assign iwt = page.metafields.custom.image_with_text.value
              assign iwt_image = iwt.image.value
              assign iwt_title = iwt.title.value
              assign iwt_description = iwt.description.value
              assign iwt_button_text = iwt.button_text.value
              assign iwt_button_link = iwt.button_link.value
            -%}
            <div class="wb-banded" {{ block.shopify_attributes }}>
              <div class="wb-container">
                <div class="wb-padding page-width">
                  <div class="image-with-text image-with-text--no-overlap isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                    <div class="image-with-text__grid grid grid--gapless grid--1-col grid--2-col-tablet{% if block.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
                      <div class="image-with-text__media-item image-with-text__media-item--medium image-with-text__media-item--top grid__item">
                        <div
                          class="image-with-text__media image-with-text__media--adapt global-media-settings background-transparent{% if iwt_image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}"
                          {% if iwt_image != blank %}
                            style="padding-bottom: {{ 1 | divided_by: iwt_image.aspect_ratio | times: 100 }}%;"
                          {% endif %}
                        >
                          {%- if iwt_image != blank -%}
                            {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                            {%- capture sizes -%}
                        (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                        (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                      {%- endcapture -%}
                            {{
                              iwt_image
                              | image_url: width: 1500
                              | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                            }}
                          {%- else -%}
                            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          {%- endif -%}
                        </div>
                      </div>
                      <div class="wb-padding image-with-text__text-item grid__item">
                        <div class="image-with-text__content image-with-text__content--top image-with-text__content--desktop-left image-with-text__content--mobile-left image-with-text__content--adapt content-container background-transparent">
                          {%- if iwt_title != blank -%}
                            <h2 class="wb-medium-heading image-with-text__heading inline-richtext h1">
                              {{ iwt_title }}
                            </h2>
                          {%- endif -%}
                          {%- if iwt_description != blank -%}
                            <div class="image-with-text__text rte body">
                              {{ iwt_description }}
                            </div>
                          {%- endif -%}
                          {%- if iwt_button_text != blank -%}
                            <a
                              {% if iwt_button_link == blank %}
                                role="link" aria-disabled="true"
                              {% else %}
                                href="{{ iwt_button_link }}"
                              {% endif %}
                              class="button wb-button button--primary wb-primary-button"
                            >
                              {{ iwt_button_text | escape }}
                            </a>
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "WB Grid Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "page_header",
      "name": "Page header",
      "limit": 1,
      "settings": []
    },
    {
      "type": "wb_grid",
      "name": "WB Grid",
      "limit": 1,
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "WB Grid Page",
      "blocks": [
        {
          "type": "page_header"
        },
        {
          "type": "wb_grid"
        }
      ]
    }
  ]
}
{% endschema %}
