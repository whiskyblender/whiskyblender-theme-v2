{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding wb-collection-copy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'page_header' -%}
            <h1 class="wb-large-heading">{{ page.title | escape }}</h1>
            <p>
              {{ page.content }}
            </p>

          {%- when 'wb_grid' -%}
            {%- assign grid_items = page.metafields.custom.grid_data.value -%}
            <div {{ block.shopify_attributes }}>
              <div class="wb-container">
                <div class="wb-padding">
                  {% render 'wb-grid-markup', grid_items: grid_items, design_mode: request.design_mode %}
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "WB Grid Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "page_header",
      "name": "Page header",
      "limit": 1,
      "settings": []
    },
    {
      "type": "wb_grid",
      "name": "WB Grid",
      "limit": 1,
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "WB Grid Page",
      "blocks": [
        {
          "type": "page_header"
        },
        {
          "type": "wb_grid"
        }
      ]
    }
  ]
}
{% endschema %}
