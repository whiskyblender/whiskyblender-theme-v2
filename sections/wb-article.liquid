{{ 'wb-blog.css' | asset_url | stylesheet_tag }}

<div id="wb-article">
  <section class="wb-overflow-hidden-x">
    <div class="wb-container">
      <div class="wb-imagebg"{% if article.image %} style="background-image: url({{ article.image | image_url: width: 1920 }})"{% endif %}>
        <div class="wb-padding">
          <a href="{{ blog.url }}" class="wb-article-back-top">&#8592; {{ blog.title | escape }}</a>
          <h1 class="wb-medium-heading">{{ article.title | escape }}</h1>
          <p class="wb-collection-sub wb-article-date">{{ article.published_at | date: '%d %B %Y' }}</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wb-container">
      <div class="wb-padding wb-article-body">
        {{ article.content }}
      </div>
    </div>
  </section>

  <section>
    <div class="wb-container">
      <div class="wb-padding" style="padding-top: 0;">
        <a href="{{ blog.url }}" class="wb-article-back-bottom">&#8592; Back to {{ blog.title | escape }}</a>
      </div>
    </div>
  </section>
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "WB Article",
  "settings": []
}
{% endschema %}
