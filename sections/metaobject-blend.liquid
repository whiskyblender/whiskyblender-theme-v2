{%- liquid
  assign blend_code   = metaobject.blend_code.value
  assign blend_title  = metaobject.blend_title.value
  assign blend_author = metaobject.blend_author.value
  assign recipe_raw   = metaobject.recipe.value
  if recipe_raw != blank
    assign recipe = recipe_raw | parse_json
  endif

  assign share_url = canonical_url
  assign lab_url   = 'https://whiskyblender.com/pages/the-lab?blend=' | append: blend_code

  assign wa_text = blend_title | append: ' — ' | append: share_url | url_encode
  assign wa_url  = 'https://wa.me/?text=' | append: wa_text
  assign fb_url  = 'https://www.facebook.com/sharer/sharer.php?u=' | append: share_url | url_encode
  assign x_url   = 'https://x.com/intent/tweet?text=' | append: blend_title | url_encode | append: '&url=' | append: share_url | url_encode

  assign active_cask_count = 0
  if recipe != blank
    for item in recipe
      assign item_amount = item.amount | plus: 0
      if item_amount > 0
        assign active_cask_count = active_cask_count | plus: 1
      endif
    endfor
  endif
  if active_cask_count == 1
    assign cask_word = 'cask'
  else
    assign cask_word = 'casks'
  endif

  assign blend_date = metaobject.blend_date.value
  assign opts_collection = section.settings.collection

  assign tagline_str = 'A blend of '
  assign current_active_idx = 0
  for item in recipe
    assign item_amount = item.amount | plus: 0
    if item_amount > 0
      assign current_active_idx = current_active_idx | plus: 1
      if current_active_idx > 1
        if current_active_idx == active_cask_count
          assign tagline_str = tagline_str | append: ' and '
        else
          assign tagline_str = tagline_str | append: ', '
        endif
      endif
      assign tagline_str = tagline_str | append: item.name
    endif
  endfor
  assign tagline_str = tagline_str | append: '.'
-%}

{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{{ 'wb-custom.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

<div class="wb-container wb-blend-page">
  <div class="wb-padding">
    <div class="page-width page-width--narrow">

      <div class="wb-blend-card wb-background-brown">
        <h1 class="wb-large-heading wb-blend-title">{{ blend_title | escape }}</h1>
        <p class="wb-blend-byline">Created by <strong>{{ blend_author | escape }}</strong></p>
      </div>
      {%- if recipe and recipe.size > 0 -%}
        {%- assign max_amount = 0 -%}
        {%- for item in recipe -%}
          {%- assign item_amount = item.amount | plus: 0 -%}
          {%- if item_amount > max_amount -%}
            {%- assign max_amount = item_amount -%}
          {%- endif -%}
        {%- endfor -%}
        <ul class="wb-recipe wb-blend-recipe">
          {%- for item in recipe -%}
            {%- assign item_amount = item.amount | plus: 0 -%}
            {%- if item_amount > 0 -%}
              {%- assign bar_left = item_amount | times: 100.0 | divided_by: max_amount | round: 1 -%}
              <li style="background-color: {{ item.colour | default: '#b88d60' | escape }}">
                <span class="wb-label">{{ item_amount }}% {{ item.name | escape }}</span>
                <span class="wb-recipebar" style="left: {{ bar_left }}%"></span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="wb-blend-card wb-background-blue">
          <p>{%- if blend_date != blank -%}Created {{ blend_date | date: "%-d %b %Y" }} &mdash; {%- endif -%}This Scotch contains whisky from {{ active_cask_count }} single malt {{ cask_word }}. {{ tagline_str | escape }}</p>
        </div>
      {%- endif -%}

      <div class="wb-custom-blend-actions wb-blend-code-actions">
        <div class="wb-blendcode-box">
          <span class="wb-blendcode-digits">{{ blend_code | escape }}</span>
        </div>
        <button class="wb-button wb-primary-button" id="wb-blend-copy-btn" data-url="{{ share_url | escape }}">
          <span class="svg-wrapper">{{- 'icon-copy.svg' | inline_asset_content -}}</span>&nbsp;Copy link
        </button>
        <a href="{{ lab_url }}" class="wb-button">Tweak in the Lab &rarr;</a>
      </div>

      <p class="wb-blend-share-label">Share this blend</p>
      <div class="wb-blend-share-row">
        <a href="{{ wa_url }}" target="_blank" rel="noopener noreferrer" class="wb-blend-share-icon" title="Share on WhatsApp" aria-label="Share on WhatsApp">
          <span class="svg-wrapper">{{- 'icon-whatsapp.svg' | inline_asset_content -}}</span>
        </a>
        <a href="{{ fb_url }}" target="_blank" rel="noopener noreferrer" class="wb-blend-share-icon" title="Share on Facebook" aria-label="Share on Facebook">
          <span class="svg-wrapper">{{- 'icon-facebook.svg' | inline_asset_content -}}</span>
        </a>
        <a href="{{ x_url }}" target="_blank" rel="noopener noreferrer" class="wb-blend-share-icon" title="Share on X / Twitter" aria-label="Share on X / Twitter">
          <span class="svg-wrapper">{{- 'icon-twitter.svg' | inline_asset_content -}}</span>
        </a>
      </div>

    </div>
  </div>
</div>

{%- if opts_collection != blank and opts_collection.products.size > 0 -%}
  <section class="wb-banded wb-blend-bottle-banded">
    <div class="wb-container">
      <div class="wb-padding">
        <h2 class="wb-blend-bottle-heading">Bottle this creation</h2>
        <ul
          class="wb-productsgrid wb-tightergrid grid product-grid grid--4-col-desktop grid--2-col-tablet-down"
          role="list"
          id="wb-blend-products"
        >
          {%- assign skip_card_styles = false -%}
          {%- for product in opts_collection.products -%}
            <li class="wb-productcell grid__item">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: 'square',
                image_shape: 'default',
                show_secondary_image: true,
                show_vendor: false,
                show_rating: false,
                skip_styles: skip_card_styles
              %}
            </li>
            {%- assign skip_card_styles = true -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>
{%- endif -%}

<style>
  .wb-blend-card { padding: 40px; border-radius: 8px; margin-bottom: 10px; }
  .wb-blend-byline { color: #555; }
  .wb-blend-byline strong { color: #333; font-weight: 600; }
  .wb-blend-code-actions { margin-bottom: 40px; }
  .wb-blend-recipe { margin-top: 40px; margin-bottom: 0; }

  /* Stats panels */
  .wb-blend-stats {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 40px;
    margin-bottom: 40px;
  }
  @media screen and (min-width: 600px) {
    .wb-blend-stats { flex-direction: row; flex-wrap: wrap; }
    .wb-blend-stat { flex: 1 1 calc(50% - 5px); }
  }
  @media screen and (min-width: 1000px) {
    .wb-blend-stats { flex-wrap: nowrap; }
    .wb-blend-stat { flex: 1; }
  }
  .wb-blend-stat {
    position: relative;
    overflow: hidden;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 32px 20px;
    border-radius: 0 0 28px 28px;
    background: linear-gradient(160deg, #1e3a6e, #2a5298);
    color: #fff;
    text-align: center;
  }
  .wb-blend-stat::before {
    content: '';
    position: absolute;
    top: 0;
    left: -75%;
    width: 50%;
    height: 100%;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.12), transparent);
    animation: wb-stat-sheen 5s ease-in-out infinite;
    pointer-events: none;
  }
  .wb-blend-stat:nth-child(2)::before { animation-delay: 1.6s; }
  .wb-blend-stat:nth-child(3)::before { animation-delay: 3.2s; }
  @keyframes wb-stat-sheen {
    0%   { left: -75%; }
    50%  { left: 125%; }
    100% { left: 125%; }
  }
  .wb-blend-stat-value {
    display: block;
    font-size: 48px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .wb-blend-stat-label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.75);
    line-height: 1.3;
  }
  .wb-blend-stat-value--date { font-size: 32px; letter-spacing: 0; }
  @media screen and (min-width: 600px) {
    .wb-blend-stat { padding: 40px 24px; }
    .wb-blend-stat-value { font-size: 56px; }
    .wb-blend-stat-value--date { font-size: 36px; }
    .wb-blend-stat-label { font-size: 14px; }
  }

  /* Bottle strip */
  .wb-blend-bottle-banded { background-color: #efefef; }
  .wb-blend-bottle-heading {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 20px;
  }

  /* Social share */
  .wb-blend-share-label { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #bbb; margin-top: 20px; margin-bottom: 12px; }
  .wb-blend-share-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .wb-blend-share-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #ddd;
    background: transparent;
    color: #555;
    cursor: pointer;
    text-decoration: none;
    transition: border-color .2s, color .2s;
  }
  .wb-blend-share-icon:hover { border-color: #999; color: #333; }
  .wb-blend-share-icon .svg-wrapper { display: flex; align-items: center; justify-content: center; }
  .wb-blend-share-icon .svg-wrapper svg { width: 18px; height: 18px; }
</style>

<script>
(function () {
  var blendCode   = '{{ blend_code | escape }}';
  var productStrip = document.getElementById('wb-blend-products');
  if (productStrip && blendCode) {
    productStrip.querySelectorAll('a[href*="/products/"]').forEach(function (a) {
      var href = a.getAttribute('href');
      if (href && href.indexOf('blend=') === -1) {
        a.href = href + (href.indexOf('?') !== -1 ? '&' : '?') + 'blend=' + encodeURIComponent(blendCode);
      }
    });
  }

  var copyBtn = document.getElementById('wb-blend-copy-btn');
  if (copyBtn) {
    var shareUrl = copyBtn.getAttribute('data-url');
    var origHtml = copyBtn.innerHTML;
    copyBtn.addEventListener('click', function () {
      if (navigator.clipboard && shareUrl) {
        navigator.clipboard.writeText(shareUrl).then(function () {
          copyBtn.textContent = 'Copied!';
          setTimeout(function () { copyBtn.innerHTML = origHtml; }, 2000);
        }).catch(function () {});
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "Blend showcase",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Bottle options collection"
    },
    {
      "type": "text",
      "id": "combinations_count",
      "label": "Possible combinations",
      "info": "Displayed on all blend pages. Update when the catalogue changes. Example: 1,000,000+"
    }
  ]
}
{% endschema %}
