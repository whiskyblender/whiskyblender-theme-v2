{%- liquid
  assign blend_code   = metaobject.blend_code.value
  assign blend_title  = metaobject.blend_title.value
  assign blend_author = metaobject.blend_author.value
  assign recipe_raw   = metaobject.recipe.value
  if recipe_raw != blank
    assign recipe = recipe_raw | parse_json
  endif

  assign share_url  = canonical_url
  assign lab_url    = 'https://whiskyblender.com/pages/the-lab?blend=' | append: blend_code
  assign bottle_url = 'https://whiskyblender.com/pages/custom-options?blend=' | append: blend_code

  assign wa_text = blend_title | append: ' — ' | append: share_url | url_encode
  assign wa_url  = 'https://wa.me/?text=' | append: wa_text
  assign fb_url  = 'https://www.facebook.com/sharer/sharer.php?u=' | append: share_url | url_encode
  assign x_url   = 'https://x.com/intent/tweet?text=' | append: blend_title | url_encode | append: '&url=' | append: share_url | url_encode
-%}

{{ 'wb-products.css' | asset_url | stylesheet_tag }}

<div class="wb-container wb-blend-page">
  <div class="wb-padding">
    <div class="page-width page-width--narrow">

      <h1 class="wb-large-heading wb-blend-title">{{ blend_title | escape }}</h1>
      <p class="wb-blend-byline">Created by <strong>{{ blend_author | escape }}</strong></p>
      <p class="wb-blend-code">{{ blend_code | escape }}</p>

      {%- if recipe and recipe.size > 0 -%}
        {%- assign max_amount = 0 -%}
        {%- for item in recipe -%}
          {%- assign item_amount = item.amount | plus: 0 -%}
          {%- if item_amount > max_amount -%}
            {%- assign max_amount = item_amount -%}
          {%- endif -%}
        {%- endfor -%}
        <ul class="wb-recipe wb-blend-recipe">
          {%- for item in recipe -%}
            {%- assign item_amount = item.amount | plus: 0 -%}
            {%- if item_amount > 0 -%}
              {%- assign bar_left = item_amount | times: 100.0 | divided_by: max_amount | round: 1 -%}
              <li style="background-color: {{ item.colour | default: '#b88d60' | escape }}">
                <span class="wb-label">{{ item_amount }}% {{ item.name | escape }}</span>
                <span class="wb-recipebar" style="left: {{ bar_left }}%"></span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="wb-blend-divider"></div>

      <div class="wb-blend-actions">
        <a href="{{ lab_url }}" class="wb-button wb-secondary-button">Tweak in the Lab</a>
        <a href="{{ bottle_url }}" class="wb-button wb-primary-button">Bottle It</a>
      </div>

      <p class="wb-blend-share-label">Share this blend</p>
      <div class="wb-blend-share-row">
        <button class="wb-blend-share-icon" id="wb-blend-copy" data-url="{{ share_url | escape }}" title="Copy link" aria-label="Copy link">
          <span class="svg-wrapper">{{- 'icon-copy.svg' | inline_asset_content -}}</span>
        </button>
        <a href="{{ wa_url }}" target="_blank" rel="noopener noreferrer" class="wb-blend-share-icon" title="Share on WhatsApp" aria-label="Share on WhatsApp">
          <span class="svg-wrapper">{{- 'icon-whatsapp.svg' | inline_asset_content -}}</span>
        </a>
        <a href="{{ fb_url }}" target="_blank" rel="noopener noreferrer" class="wb-blend-share-icon" title="Share on Facebook" aria-label="Share on Facebook">
          <span class="svg-wrapper">{{- 'icon-facebook.svg' | inline_asset_content -}}</span>
        </a>
        <a href="{{ x_url }}" target="_blank" rel="noopener noreferrer" class="wb-blend-share-icon" title="Share on X / Twitter" aria-label="Share on X / Twitter">
          <span class="svg-wrapper">{{- 'icon-twitter.svg' | inline_asset_content -}}</span>
        </a>
      </div>

    </div>
  </div>
</div>

<style>
  .wb-blend-byline { font-size: 24px; color: #555; margin-top: 4px; margin-bottom: 8px; }
  .wb-blend-byline strong { color: #333; font-weight: 600; }
  .wb-blend-title { margin: 0 0 20px 0; }
  .wb-blend-code { font-size: 12px; color: #bbb; letter-spacing: .1em; margin-bottom: 40px; }
  .wb-blend-recipe { margin-bottom: 40px; }
  .wb-blend-divider { height: 1px; background: #eee; margin-bottom: 40px; }
  .wb-blend-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 40px; }
  .wb-blend-share-label { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #bbb; margin-bottom: 12px; }
  .wb-blend-share-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .wb-blend-share-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #ddd;
    background: transparent;
    color: #555;
    cursor: pointer;
    text-decoration: none;
    transition: border-color .2s, color .2s;
  }
  .wb-blend-share-icon:hover { border-color: #999; color: #333; }
  .wb-blend-share-icon--copied { border-color: #169776 !important; color: #169776 !important; }
  .wb-blend-share-icon .svg-wrapper { display: flex; align-items: center; justify-content: center; }
  .wb-blend-share-icon .svg-wrapper svg { width: 18px; height: 18px; }
</style>

<script>
(function () {
  var btn = document.getElementById('wb-blend-copy');
  if (!btn) return;
  btn.addEventListener('click', function () {
    var url = btn.getAttribute('data-url');
    if (navigator.clipboard && url) {
      navigator.clipboard.writeText(url).then(function () {
        btn.classList.add('wb-blend-share-icon--copied');
        setTimeout(function () {
          btn.classList.remove('wb-blend-share-icon--copied');
        }, 2000);
      });
    }
  });
})();
</script>

{% schema %}
{
  "name": "Blend showcase"
}
{% endschema %}
