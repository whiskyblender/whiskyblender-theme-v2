<style>
  /* ── Banding: hero reads transparent; grey/white alternation starts band 2 ── */
  #wb-label-guide > .wb-banded:nth-of-type(odd) {
    background-color: transparent;
  }
  #wb-label-guide > .wb-banded:nth-of-type(even) {
    background-color: #efefef;
  }

  /* ── Eyebrow ── */
  #wb-label-guide .wb-label-guide-eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #169776;
    margin: 0 0 14px;
  }

  /* ── Intro width (hero + CTA) ── */
  #wb-label-guide .wb-label-guide-intro {
    max-width: 768px;
  }

  /* ── Two paths ── */
  #wb-label-guide .wb-label-guide-paths {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 24px;
  }
  @media screen and (min-width: 760px) {
    #wb-label-guide .wb-label-guide-paths { grid-template-columns: 1fr 1fr; }
  }
  #wb-label-guide .wb-label-path {
    background: #ffffff;
    border-radius: 20px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
  }
  #wb-label-guide .wb-label-path-tag {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #169776;
    margin: 0 0 12px;
  }
  #wb-label-guide .wb-label-path h3 {
    font-size: 24px;
    line-height: 1.2;
    margin: 0 0 12px;
  }
  #wb-label-guide .wb-label-path > p {
    margin: 0 0 16px;
  }
  #wb-label-guide .wb-label-path ul {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    flex: 1 0 auto;
  }
  #wb-label-guide .wb-label-path ul li {
    font-size: 14px;
    padding: 7px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  #wb-label-guide .wb-label-path ul li:first-child {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  #wb-label-guide .wb-label-path .wb-button {
    align-self: flex-start;
  }

  /* ── Steps ── */
  #wb-label-guide ol.wb-label-guide-steps {
    counter-reset: wb-step;
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    max-width: 768px;
  }
  #wb-label-guide ol.wb-label-guide-steps > li {
    counter-increment: wb-step;
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  #wb-label-guide ol.wb-label-guide-steps > li:first-child {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }
  #wb-label-guide ol.wb-label-guide-steps > li::before {
    content: counter(wb-step);
    font-family: 'trimPosterCompressed', sans-serif;
    font-weight: 100;
    font-size: 52px;
    line-height: 44px;
    color: #169776;
    flex-shrink: 0;
    width: 44px;
    text-align: center;
  }
  #wb-label-guide .wb-step-body strong {
    display: block;
    font-size: 18px;
    line-height: 1.3;
    margin: 0 0 6px;
  }
  #wb-label-guide .wb-step-body p {
    margin: 0;
  }

  /* ── Artwork specs table ── */
  #wb-label-guide .wb-label-guide-specs-wrap {
    overflow-x: auto;
    margin: 20px 0 0;
  }
  #wb-label-guide .wb-label-guide-specs-wrap table {
    width: 100%;
    border-collapse: collapse;
    min-width: 360px;
  }
  #wb-label-guide .wb-label-guide-specs-wrap th {
    text-align: left;
    padding: 10px 20px 10px 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-bottom: 2px solid rgba(0, 0, 0, 0.18);
  }
  #wb-label-guide .wb-label-guide-specs-wrap td {
    padding: 10px 20px 10px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    vertical-align: top;
  }
  #wb-label-guide .wb-label-guide-specs-note {
    margin-top: 14px;
    font-size: 14px;
    opacity: 0.75;
    max-width: 600px;
  }

  /* ── Download list ── */
  #wb-label-guide ul.wb-label-guide-downloads {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    max-width: 640px;
  }
  #wb-label-guide ul.wb-label-guide-downloads > li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }
  #wb-label-guide ul.wb-label-guide-downloads > li:first-child {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }
  #wb-label-guide .wb-dl-badge {
    display: inline-block;
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #169776;
    color: #fff;
    border-radius: 4px;
    padding: 3px 8px;
    min-width: 32px;
    text-align: center;
  }
  #wb-label-guide .wb-dl-body {
    flex: 1 1 0;
    min-width: 0;
  }
  #wb-label-guide .wb-dl-title {
    display: block;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }
  #wb-label-guide a.wb-dl-title:hover {
    text-decoration: underline;
  }
  #wb-label-guide .wb-dl-note {
    display: block;
    font-size: 13px;
    opacity: 0.7;
    margin-top: 2px;
  }
  #wb-label-guide .wb-dl-link {
    flex-shrink: 0;
    font-size: 14px;
    font-weight: 700;
    color: #169776;
    text-decoration: none;
    white-space: nowrap;
  }
  #wb-label-guide .wb-dl-link:hover {
    text-decoration: underline;
  }

  /* ── FAQ accordion (mirrors wb-help.liquid) ── */
  #wb-label-guide .wb-faq {
    list-style: none;
    padding: 0;
    max-width: 768px;
  }
  #wb-label-guide .wb-faq li {
    padding: 8px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  #wb-label-guide .wb-faq li:first-child {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  #wb-label-guide .wb-collapsible {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    font-size: 20px;
    line-height: 26px;
    cursor: pointer;
    padding: 10px 0;
    font-family: Raleway, sans-serif;
    font-weight: 600;
    color: inherit;
    background: none;
    border: none;
    text-align: left;
  }
  #wb-label-guide .wb-collapsible::after {
    content: '+';
    font-size: 22px;
    font-weight: 400;
    flex-shrink: 0;
    margin-left: 16px;
    transition: transform 0.2s ease;
  }
  #wb-label-guide .wb-collapsible.active::after {
    content: '\2212';
  }
  #wb-label-guide .wb-faq-content {
    display: none;
    padding: 4px 0 16px;
  }
  #wb-label-guide .wb-faq-content p {
    margin: 0 0 12px;
  }
  #wb-label-guide .wb-faq-content p:last-child {
    margin-bottom: 0;
  }
</style>

{%- assign path_card_blocks = section.blocks | where: 'type', 'path_card' -%}
{%- assign spec_row_blocks  = section.blocks | where: 'type', 'spec_row' -%}
{%- assign download_blocks  = section.blocks | where: 'type', 'download_item' -%}
{%- assign faq_blocks       = section.blocks | where: 'type', 'faq_item' -%}
{%- assign contact_email    = section.settings.contact_email | default: 'info@whiskyblender.com' -%}

<section id="wb-label-guide" class="wb-overflow-hidden-x">

  {%- comment -%} ---------- Hero ---------- {%- endcomment -%}
  <div class="wb-banded">
    <div class="wb-container wb-first-item">
      <div class="wb-padding">
        <p class="wb-label-guide-eyebrow">{{ section.settings.eyebrow | default: 'Personalised labels' }}</p>
        <h1 class="wb-large-heading">{{ section.settings.heading | default: 'Make it yours' }}</h1>
        <div class="wb-label-guide-intro">
          {{
            section.settings.intro
            | default: '<p>Every bottle already carries the name and message you type into the label generator. If you&rsquo;d like a logo, crest, or graphic on there too &mdash; or a label that&rsquo;s entirely bespoke &mdash; here&rsquo;s how.</p>'
          }}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ---------- Two paths ---------- {%- endcomment -%}
  {%- if path_card_blocks.size > 0 -%}
    <div class="wb-banded">
      <div class="wb-container">
        <div class="wb-padding">
          <div class="wb-label-guide-paths">
            {%- for block in path_card_blocks -%}
              {%- if block.settings.button_style == 'primary' -%}
                {%- assign card_btn_class = 'wb-button wb-primary-button' -%}
              {%- else -%}
                {%- assign card_btn_class = 'wb-button' -%}
              {%- endif -%}
              <div class="wb-label-path" {{ block.shopify_attributes }}>
                {%- if block.settings.tag != blank -%}
                  <span class="wb-label-path-tag">{{ block.settings.tag }}</span>
                {%- endif -%}
                <h3>{{ block.settings.heading }}</h3>
                {{ block.settings.body }}
                {%- if block.settings.bullet_1 != blank or block.settings.bullet_2 != blank or block.settings.bullet_3 != blank -%}
                  <ul>
                    {%- if block.settings.bullet_1 != blank -%}<li>{{ block.settings.bullet_1 }}</li>{%- endif -%}
                    {%- if block.settings.bullet_2 != blank -%}<li>{{ block.settings.bullet_2 }}</li>{%- endif -%}
                    {%- if block.settings.bullet_3 != blank -%}<li>{{ block.settings.bullet_3 }}</li>{%- endif -%}
                  </ul>
                {%- endif -%}
                {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
                  <a class="{{ card_btn_class }}" href="{{ block.settings.button_url }}">{{ block.settings.button_label }}</a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- How overprinting works ---------- {%- endcomment -%}
  <div class="wb-banded" id="how-it-works">
    <div class="wb-container">
      <div class="wb-padding">
        <h2 class="wb-small-heading">{{ section.settings.steps_heading | default: 'How overprinting works' }}</h2>
        <ol class="wb-label-guide-steps">
          <li>
            <div class="wb-step-body">
              <strong>Build your label in the generator</strong>
              <p>Choose your bottle, type your name and message, and get your text exactly how you want it &mdash; same as any personalised bottle.</p>
            </div>
          </li>
          <li>
            <div class="wb-step-body">
              <strong>Download a template</strong>
              <p>Grab the blank template for your bottle size below, so your artwork lands in the right spot at the right size.</p>
            </div>
          </li>
          <li>
            <div class="wb-step-body">
              <strong>Email us your file</strong>
              <p>Send your artwork to <a href="mailto:{{ contact_email }}">{{ contact_email }}</a> with your order number, and tell us roughly where you&rsquo;d like it placed.</p>
            </div>
          </li>
          <li>
            <div class="wb-step-body">
              <strong>We check it and confirm</strong>
              <p>We&rsquo;ll drop it onto your label, send you a proof to approve, and bottle once you&rsquo;re happy.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </div>

  {%- comment -%} ---------- Artwork specifications ---------- {%- endcomment -%}
  {%- if spec_row_blocks.size > 0 -%}
    <div class="wb-banded">
      <div class="wb-container">
        <div class="wb-padding">
          <h2 class="wb-small-heading">{{ section.settings.specs_heading | default: 'Artwork specifications' }}</h2>
          <p>
            {{-
              section.settings.specs_intro
              | default: 'Stick to these and your artwork will print cleanly first time.'
            -}}
          </p>
          <div class="wb-label-guide-specs-wrap">
            <table>
              <thead>
                <tr>
                  <th>Bottle size</th>
                  <th>Printable area</th>
                  <th>File formats</th>
                </tr>
              </thead>
              <tbody>
                {%- for block in spec_row_blocks -%}
                  <tr {{ block.shopify_attributes }}>
                    <td>{{ block.settings.bottle_size }}</td>
                    <td>{{ block.settings.printable_area }}</td>
                    <td>{{ block.settings.file_formats }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          {%- assign specs_note = section.settings.specs_note | default: 'Vector files (AI/EPS/PDF) reproduce best &mdash; flat images can look soft once printed. If you only have a low-res logo, send it anyway and we&rsquo;ll let you know if it won&rsquo;t hold up.' -%}
          {%- if specs_note != blank -%}
            <p class="wb-label-guide-specs-note">{{ specs_note }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- Download templates ---------- {%- endcomment -%}
  {%- if download_blocks.size > 0 -%}
    <div class="wb-banded">
      <div class="wb-container">
        <div class="wb-padding">
          <h2 class="wb-small-heading">{{ section.settings.downloads_heading | default: 'Download templates' }}</h2>
          <p>
            {{-
              section.settings.downloads_intro
              | default: 'Blank, print-ready outlines for your bottle size &mdash; drop your artwork straight in.'
            -}}
          </p>
          <ul class="wb-label-guide-downloads">
            {%- for block in download_blocks -%}
              {%- assign raw_url = block.settings.url -%}
              {%- if raw_url contains '://' -%}
                {%- assign download_href = raw_url -%}
              {%- elsif raw_url != blank -%}
                {%- assign download_href = raw_url | asset_url -%}
              {%- else -%}
                {%- assign download_href = '' -%}
              {%- endif -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.format != blank -%}
                  <span class="wb-dl-badge">{{ block.settings.format }}</span>
                {%- endif -%}
                <div class="wb-dl-body">
                  {%- if download_href != blank -%}
                    <a href="{{ download_href }}" class="wb-dl-title" target="_blank" rel="noopener">{{ block.settings.title }}</a>
                  {%- else -%}
                    <span class="wb-dl-title">{{ block.settings.title }}</span>
                  {%- endif -%}
                  {%- if block.settings.note != blank -%}
                    <span class="wb-dl-note">{{ block.settings.note }}</span>
                  {%- endif -%}
                </div>
                {%- if download_href != blank -%}
                  <a href="{{ download_href }}" class="wb-dl-link" target="_blank" rel="noopener" download>Download &rarr;</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- FAQ ---------- {%- endcomment -%}
  {%- if faq_blocks.size > 0 -%}
    <div class="wb-banded">
      <div class="wb-container">
        <div class="wb-padding">
          <h2 class="wb-small-heading">{{ section.settings.faq_heading | default: 'Questions' }}</h2>
          <ul class="wb-faq">
            {%- for block in faq_blocks -%}
              <li {{ block.shopify_attributes }}>
                <button class="wb-collapsible" type="button">{{ block.settings.question | escape }}</button>
                <div class="wb-faq-content">{{ block.settings.answer }}</div>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- Closing CTA ---------- {%- endcomment -%}
  <div class="wb-banded" id="get-in-touch">
    <div class="wb-container">
      <div class="wb-padding">
        <div class="wb-label-guide-intro">
          <h2 class="wb-small-heading">{{ section.settings.cta_heading | default: 'Ready when you are' }}</h2>
          {{
            section.settings.cta_text
            | default: '<p>Whether it&rsquo;s a quick logo drop or a full label from a blank page, we&rsquo;re happy to talk it through first.</p>'
          }}
          <div class="wb-buttons">
            <a class="wb-button wb-primary-button" href="{{ section.settings.cta_primary_url | default: '/pages/collaborate' }}">
              {{- section.settings.cta_primary_label | default: 'Discuss a bespoke label' -}}
            </a>
            <a class="wb-button" href="{{ section.settings.cta_secondary_url | default: '/pages/contact' }}">
              {{- section.settings.cta_secondary_label | default: 'Ask a quick question' -}}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>

<script>
(function () {
  document.querySelectorAll('#wb-label-guide .wb-collapsible').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var content = this.nextElementSibling;
      var isOpen = content.style.display === 'block';
      content.style.display = isOpen ? 'none' : 'block';
      this.classList.toggle('active', !isOpen);
    });
  });
})();
</script>

{%- if faq_blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign faq_first = true -%}
    {%- for block in faq_blocks -%}
      {%- if block.settings.question != blank and block.settings.answer != blank -%}
        {%- unless faq_first -%},{%- endunless -%}
        {%- assign faq_first = false -%}
        {"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "WB - Label Guide",
  "settings": [
    { "type": "text",     "id": "eyebrow",  "label": "Eyebrow label", "default": "Personalised labels" },
    { "type": "text",     "id": "heading",  "label": "Page heading",  "default": "Make it yours" },
    { "type": "richtext", "id": "intro",    "label": "Intro text" },

    { "type": "header", "content": "How overprinting works" },
    { "type": "text", "id": "steps_heading",  "label": "Section heading", "default": "How overprinting works" },
    { "type": "text", "id": "contact_email",  "label": "Contact email",   "default": "info@whiskyblender.com", "info": "Used in step 3 — send artwork to this address." },

    { "type": "header", "content": "Artwork specifications" },
    { "type": "text",     "id": "specs_heading", "label": "Section heading", "default": "Artwork specifications" },
    { "type": "text",     "id": "specs_intro",   "label": "Intro",           "default": "Stick to these and your artwork will print cleanly first time." },
    { "type": "text",     "id": "specs_note",    "label": "Note below table" },

    { "type": "header", "content": "Download templates" },
    { "type": "text", "id": "downloads_heading", "label": "Section heading", "default": "Download templates" },
    { "type": "text", "id": "downloads_intro",   "label": "Intro",           "default": "Blank, print-ready outlines for your bottle size — drop your artwork straight in." },

    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_heading", "label": "Section heading", "default": "Questions" },

    { "type": "header", "content": "Closing CTA" },
    { "type": "text",     "id": "cta_heading",        "label": "Heading",                 "default": "Ready when you are" },
    { "type": "richtext", "id": "cta_text",           "label": "Text" },
    { "type": "text",     "id": "cta_primary_label",  "label": "Primary button label",    "default": "Discuss a bespoke label" },
    { "type": "url",      "id": "cta_primary_url",    "label": "Primary button URL" },
    { "type": "text",     "id": "cta_secondary_label","label": "Secondary button label",  "default": "Ask a quick question" },
    { "type": "url",      "id": "cta_secondary_url",  "label": "Secondary button URL" }
  ],
  "blocks": [
    {
      "type": "path_card",
      "name": "Path card",
      "settings": [
        { "type": "text",     "id": "tag",          "label": "Tag (small caps)",  "default": "Fastest & free" },
        { "type": "text",     "id": "heading",      "label": "Card heading" },
        { "type": "richtext", "id": "body",         "label": "Body text" },
        { "type": "text",     "id": "bullet_1",     "label": "Bullet 1" },
        { "type": "text",     "id": "bullet_2",     "label": "Bullet 2" },
        { "type": "text",     "id": "bullet_3",     "label": "Bullet 3" },
        { "type": "text",     "id": "button_label", "label": "Button label" },
        { "type": "text",     "id": "button_url",   "label": "Button URL",        "info": "Use a relative path (/pages/...) or an anchor (#section-id)." },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "outline", "label": "Outline" },
            { "value": "primary", "label": "Primary (green)" }
          ],
          "default": "outline"
        }
      ]
    },
    {
      "type": "spec_row",
      "name": "Spec row",
      "settings": [
        { "type": "text", "id": "bottle_size",    "label": "Bottle size",    "default": "500ml" },
        { "type": "text", "id": "printable_area", "label": "Printable area", "default": "150mm × 76mm" },
        { "type": "text", "id": "file_formats",   "label": "File formats",   "default": "PDF, AI, EPS, high-res PNG" }
      ]
    },
    {
      "type": "download_item",
      "name": "Download item",
      "settings": [
        { "type": "text", "id": "format", "label": "Format badge (e.g. PDF, AI)",   "default": "PDF" },
        { "type": "text", "id": "title",  "label": "Title" },
        { "type": "text", "id": "note",   "label": "Note" },
        { "type": "text", "id": "url",    "label": "File URL or asset filename", "info": "Enter a full URL (https://...) or the filename of a file in theme assets (e.g. wb-label-template-500ml.pdf). Asset filenames are resolved automatically." }
      ]
    },
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        { "type": "text",     "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer",   "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "WB - Label Guide" }]
}
{% endschema %}
