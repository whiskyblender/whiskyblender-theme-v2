{%- comment -%}
  /pages/create: the "every way to make a bottle yours" hub.
  Each card can carry a one-line description and a live price (from a picked product,
  rendered through wb-money so it never goes stale). The whole card is clickable via
  the heading's own link stretched over the card (a::after), so it works with a
  keyboard and a screen reader, not just a mouse. A heading without a link gets
  wrapped in one pointing at the card's URL.
{%- endcomment -%}
<style>
  .wb-create-intro { max-width: 40em; margin: 0 0 28px; }
  .wb-create-text { display: block; }
  .wb-create-options li a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .wb-create-options li:focus-within { outline: 2px solid #107a5f; outline-offset: 2px; }
  .wb-create-options li a:focus { outline: none; }
  .wb-create-desc {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 150%;
    color: #555555;
  }
  .wb-create-price { font-weight: 700; color: #333333; white-space: nowrap; }
  .wb-create-options li:nth-of-type(7):hover { background-color: rgba(244, 228, 149, 0.8); }
  .wb-create-footnote { margin: 8px 0 0; font-size: 16px; color: #555555; }
  @media screen and (min-width: 768px) {
    .wb-create-desc { font-size: 18px; }
  }
</style>

<section class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding">
      <h1 class="wb-medium-heading">{{ section.settings.heading | default: "Let's get started!" }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="wb-create-intro">{{ section.settings.intro }}</p>
      {%- endif -%}
      <ul class="wb-create-options wb-cards">
        {%- for block in section.blocks -%}
          {%- assign price_product = block.settings.price_product -%}
          <li {{ block.shopify_attributes }}>
            <span class="wb-create-icon" aria-hidden="true">{{ block.settings.icon }}</span>
            <div class="wb-create-text">
              <h2 class="wb-option-heading">
                {%- if block.settings.heading contains '<a' -%}
                  {{ block.settings.heading }}
                {%- else -%}
                  <a href="{{ block.settings.url }}">{{ block.settings.heading }}</a>
                {%- endif -%}
              </h2>
              {%- if block.settings.description != blank or price_product != blank -%}
                <p class="wb-create-desc">
                  {{- block.settings.description -}}
                  {%- if price_product != blank %}
                    <span class="wb-create-price">
                      {%- if block.settings.price_prefix != blank %}{{ block.settings.price_prefix }} {% endif -%}
                      {%- render 'wb-money', amount: price_product.price_min, code: false -%}
                    </span>
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.footnote != blank -%}
        <p class="wb-create-footnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WB-Create Options",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's get started!"
    },
    {
      "type": "inline_richtext",
      "id": "intro",
      "label": "Intro (under the heading)"
    },
    {
      "type": "inline_richtext",
      "id": "footnote",
      "label": "Footnote (under the cards)"
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Option Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🎨"
        },
        {
          "type": "html",
          "id": "heading",
          "label": "Heading (HTML allowed)",
          "default": "Create a new whisky in <a href=\"/pages/thelab\">the lab</a>",
          "info": "The link in the heading makes the whole card clickable. With no link, the Click URL below is used."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Click URL"
        },
        {
          "type": "text",
          "id": "description",
          "label": "One-line description"
        },
        {
          "type": "product",
          "id": "price_product",
          "label": "Show the price of",
          "info": "Optional. Shows this product's lowest price after the description, always current."
        },
        {
          "type": "text",
          "id": "price_prefix",
          "label": "Price prefix",
          "info": "e.g. From. Leave blank to show just the price."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WB - Create Options",
      "blocks": [
        {
          "type": "option",
          "settings": {
            "icon": "🎨",
            "heading": "Create a new whisky in <a href=\"/pages/thelab\">the lab</a>",
            "url": "/pages/thelab"
          }
        },
        {
          "type": "option",
          "settings": {
            "icon": "⭐",
            "heading": "Personalise a <a href=\"/pages/perfectdrams\">perfect dram</a>",
            "url": "/pages/perfectdrams"
          }
        },
        {
          "type": "option",
          "settings": {
            "icon": "🤏",
            "heading": "Label up wee <a href=\"/pages/miniatures\">whisky miniatures</a>",
            "url": "/pages/miniatures"
          }
        },
        {
          "type": "option",
          "settings": {
            "icon": "🥃",
            "heading": "Name your own <a href=\"/pages/singlemalts\">single malt</a>",
            "url": "/pages/singlemalts"
          }
        },
        {
          "type": "option",
          "settings": {
            "icon": "💌",
            "heading": "Get mailed a <a href=\"/pages/vouchers\">gift voucher</a>",
            "url": "/pages/vouchers"
          }
        },
        {
          "type": "option",
          "settings": {
            "icon": "🤝",
            "heading": "Collaborate on <a href=\"/pages/collaborate\">your own brand</a>",
            "url": "/pages/collaborate"
          }
        }
      ]
    }
  ]
}
{% endschema %}
