{{ 'wb-blog.css' | asset_url | stylesheet_tag }}

<style>
  .wb-faq { list-style: none; padding: 0; }
  .wb-faq li { padding: 8px 0; border-bottom: 1px solid rgba(0,0,0,0.08); }
  .wb-faq li:first-child { border-top: 1px solid rgba(0,0,0,0.08); }
  .wb-collapsible {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    font-size: 22px;
    line-height: 28px;
    cursor: pointer;
    padding: 10px 0;
    font-family: Raleway, sans-serif;
    font-weight: 600;
    color: inherit;
    background: none;
    border: none;
    text-align: left;
  }
  .wb-collapsible::after {
    content: '+';
    font-size: 22px;
    font-weight: 400;
    flex-shrink: 0;
    margin-left: 16px;
    transition: transform 0.2s ease;
  }
  .wb-collapsible.active::after { content: '\2212'; }
  .wb-faq-content {
    display: none;
    padding: 4px 0 16px;
  }
  .wb-faq-content p { margin: 0 0 12px; }
  .wb-faq-content p:last-child { margin-bottom: 0; }

  .wb-help-articles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 40px;
  }
  .wb-help-article {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .wb-help-article:hover {
    border-color: #999;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }
  .wb-help-article__image img {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: cover;
  }
  .wb-help-article__body {
    padding: 16px 20px 20px;
  }
  .wb-help-article__body h3 {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .wb-help-article__body p {
    font-size: 14px;
    color: #555;
    margin: 0;
    line-height: 1.55;
  }
  @media (min-width: 600px) {
    .wb-help-articles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 900px) {
    .wb-help-articles {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<section class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding wb-collection-copy">
      <h1 class="wb-large-heading">Need a haun?</h1>
      {%- if page.content != blank -%}
        <div class="wb-blog-intro">{{ page.content }}</div>
      {%- endif -%}
      {%- assign help_blog = blogs[section.settings.help_blog] -%}
      {%- if help_blog -%}
        {%- capture help_articles_html -%}
          {%- for article in help_blog.articles -%}
            {%- if article.tags contains 'help' -%}
              <a href="{{ article.url }}" class="wb-help-article">
                {%- if article.image -%}
                <div class="wb-help-article__image">
                  <img
                    src="{{ article.image | image_url: width: 600 }}"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    loading="lazy"
                    width="600"
                    height="180">
                </div>
                {%- endif -%}
                <div class="wb-help-article__body">
                  <h3>{{ article.title | escape }}</h3>
                  {%- if article.excerpt != blank -%}
                    <p>{{ article.excerpt | strip_html | truncate: 120 }}</p>
                  {%- endif -%}
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if help_articles_html != blank -%}
        <div class="wb-help-articles">
          {{ help_articles_html }}
        </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

<section class="wb-banded">
  <div class="wb-container">
    <div class="wb-padding">
      <h2 class="wb-small-heading">FAQ sake!</h2>
      {%- if section.blocks.size > 0 -%}
      <ul class="wb-faq">
        {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <button class="wb-collapsible" type="button">{{ block.settings.question | escape }}</button>
          <div class="wb-faq-content">{{ block.settings.answer }}</div>
        </li>
        {%- endfor -%}
      </ul>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function () {
  var items = document.querySelectorAll('.wb-collapsible');
  items.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var content = this.nextElementSibling;
      var isOpen = content.style.display === 'block';
      content.style.display = isOpen ? 'none' : 'block';
      this.classList.toggle('active', !isOpen);
    });
  });
})();
</script>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign faq_first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.question != blank and block.settings.answer != blank -%}
        {%- unless faq_first -%},{%- endunless -%}
        {%- assign faq_first = false -%}
        {"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "WB - Help Page",
  "settings": [
    {
      "type": "blog",
      "id": "help_blog",
      "label": "Help articles blog"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    { "name": "WB Help Page" }
  ]
}
{% endschema %}
