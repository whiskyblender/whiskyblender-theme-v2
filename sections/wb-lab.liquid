{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{{ 'wb-thelab.css' | asset_url | stylesheet_tag }}

{%- assign api_base = section.settings.api_base_url | strip -%}

{%- comment -%} Cards + pie chart + sticky fill meter {%- endcomment -%}
<div class="wb-container">
<div class="wb-padding">

<svg width="0" height="0" style="position:absolute">
  <filter id="glass-distortion">
    <feTurbulence type="fractalNoise" baseFrequency="0.01" numOctaves="3" result="noise" />
    <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>

<div id="wb-loader" style="background-image: url({{ 'wb-loader.gif' | asset_url }})">Haud the noo</div>

<div id="wb-load-error" style="display:none">
  <div style="text-align:center; padding-top:80px; padding-bottom:80px; max-width:560px; margin:0 auto;">
    <p aria-hidden="true" style="font-size:28px; font-weight:700; margin:0 0 16px;">¯\_(ツ)_/¯</p>
    <h2 class="wb-medium-heading">That's no right!</h2>
    <p>We seem to be having a technical moment. It might sort itself out &mdash; so worth trying again in a wee bit.</p>
    <p style="margin-top:32px;">Wander roon <a href="/pages/shop">the shop</a> in the meantime.</p>
    <p style="margin-top:32px;"><button id="wb-retry-btn" class="wb-button" type="button">Try again</button></p>
    <p style="font-size:12px; color:#999; margin-top:8px;">If it's still broken, it's still broken.</p>
  </div>
</div>

<ul
  class="wb-cards wb-option-cards"
  id="wb-lab-flavours"
  data-api-base="{{ api_base }}"
  style="display:none"
>
  {%- comment -%} Cards injected by wb-lab.js after fetching /api/whisky-options {%- endcomment -%}
  <li class="wb-notoption">
    <div class="wb-pies">
      <div class="wb-pie-grid" style="background-image: url({{ 'wb-piegrid.svg' | asset_url }})">&nbsp;</div>
      <div class="wb-rotate" id="wb-lab-pie">
        {%- comment -%} Pie slices injected by wb-lab.js {%- endcomment -%}
      </div>
    </div>
  </li>
</ul>

<div class="wb-sticky-lab" id="wb-lab-meter" style="display:none">
  <div class="wb-lab-fillmeter">
    <span>0% filled</span>
    <div class="wb-lab-fillvisual" style="width: 0%"></div>
  </div>
</div>

</div>
</div>

{%- comment -%} Name & save form — separate band below the blending cards {%- endcomment -%}
<div
  class="wb-save-panel"
  id="wb-save-panel"
  style="display:none"
  data-api-base="{{ api_base }}"
  data-product-id="{{ section.settings.product_id | strip }}"
  data-variant-id="{{ section.settings.variant_id | strip }}"
  data-product-url="{{ section.settings.bottle_options_url | strip }}"
>
  <div class="wb-container">
  <div class="wb-padding">

    <form class="wb-bottle-form" id="wb-save-form">
      <div class="wb-lab-inputs">
        <div class="wb-lab-input">
          <label for="wb-blend-title">Name this whisky</label>
          <input
            type="text"
            id="wb-blend-title"
            placeholder="Max. 32 characters"
            autocomplete="off"
            maxlength="80"
          >
          <p class="wb-field-hint">Keep it short &mdash; or <button type="button" id="wb-generate-name" class="wb-hint-link">generate one</button></p>
        </div>
        <div class="wb-lab-input">
          <label for="wb-blend-author">Created by</label>
          <input
            type="text"
            id="wb-blend-author"
            placeholder="Your name"
            autocomplete="off"
            maxlength="60"
          >
          <p class="wb-field-hint">Can be more than one &mdash; sign it like a card</p>
        </div>
      </div>
      <div class="wb-buttons">
        <button type="button" id="wb-save-blend-btn" class="wb-button wb-primary-button wb-button-disabled" disabled>
          Draw from casks
        </button>
      </div>
    </form>

    <p class="wb-save-error" id="wb-save-error" aria-live="polite" style="display:none"></p>

    <div class="wb-save-success" id="wb-save-success" style="display:none">
      <p class="wb-save-success-message">
        Blend <strong id="wb-blend-slug-display"></strong> saved! 🥃
      </p>
      <a id="wb-blend-product-link" class="wb-button wb-primary-button" href="#">
        Personalise your bottle &rarr;
      </a>
    </div>

  </div>
  </div>
</div>

{%- comment -%} Optional teardown panel — configurable in theme editor {%- endcomment -%}
{%- if section.settings.teardown_heading != blank or section.settings.teardown_content != blank -%}
<div class="wb-lab-teardown">
  <div class="wb-container">
    <div class="wb-padding">
      {%- if section.settings.teardown_heading != blank -%}
        <h3 class="wb-small-heading">{{ section.settings.teardown_heading }}</h3>
      {%- endif -%}
      {%- if section.settings.teardown_content != blank -%}
        {{ section.settings.teardown_content }}
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

<script src="{{ 'wb-lab.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "WB - Blending Lab",
  "tag": "section",
  "class": "section wb-first-item wb-banded",
  "settings": [
    {
      "type": "text",
      "id": "api_base_url",
      "label": "App API base URL",
      "info": "Base URL of the Whisky Blender app — no trailing slash. E.g. https://lab.whiskyblender.com"
    },
    {
      "type": "text",
      "id": "product_id",
      "label": "Blend product ID",
      "info": "Shopify product ID to associate with saved blends (numeric, e.g. 8765432100)"
    },
    {
      "type": "text",
      "id": "variant_id",
      "label": "Blend product variant ID",
      "info": "Optional. Leave blank to use the default variant."
    },
    {
      "type": "url",
      "id": "bottle_options_url",
      "label": "Bottle options page URL",
      "info": "URL of the bottle selection page customers go to after saving their blend."
    },
    {
      "type": "header",
      "content": "Bottom panel"
    },
    {
      "type": "text",
      "id": "teardown_heading",
      "label": "Heading",
      "default": "Ye a big fearty?"
    },
    {
      "type": "richtext",
      "id": "teardown_content",
      "label": "Content",
      "default": "<p>If creating your own whisky isn't for you, then maybe you could bottle up one of our <a href=\"#\">signature whiskies</a>, label your own bottle of <a href=\"#\">single malt</a>, or grab a <a href=\"#\">gift voucher</a> for someone else to give it a try.</p>"
    }
  ],
  "presets": [
    {
      "name": "WB - Blending Lab"
    }
  ]
}
{% endschema %}
