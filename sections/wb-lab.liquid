{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{{ 'wb-products.css' | asset_url | stylesheet_tag }}
{{ 'wb-thelab.css' | asset_url | stylesheet_tag }}

{%- assign api_base = section.settings.api_base_url | strip -%}

<div class="wb-container">
<div class="wb-padding">

{%- comment -%} SVG filter for glass / cask distortion {%- endcomment -%}
<svg width="0" height="0" style="position:absolute">
  <filter id="glass-distortion">
    <feTurbulence type="fractalNoise" baseFrequency="0.01" numOctaves="3" result="noise" />
    <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>

<ul
  class="wb-cards wb-option-cards"
  id="wb-lab-flavours"
  data-api-base="{{ api_base }}"
>
  {%- comment -%} Cards are rendered by wb-lab.js after fetching /api/whisky-options {%- endcomment -%}

  <li class="wb-notoption">
    <div class="wb-pies">
      <div class="wb-pie-grid" style="background-image: url({{ 'wb-piegrid.svg' | asset_url }})">&nbsp;</div>
      <div class="wb-rotate" id="wb-lab-pie">
        {%- comment -%} Pie slices are injected by wb-lab.js {%- endcomment -%}
      </div>
    </div>
  </li>
</ul>

<div class="wb-sticky-lab" id="wb-lab-meter">
  <div class="wb-lab-fillmeter">
    <span>0% filled — add some flavours!</span>
    <div class="wb-lab-fillvisual" style="width: 0%"></div>
  </div>
</div>

{%- comment -%} Save panel — always visible; button state guides user through the flow {%- endcomment -%}
<div
  class="wb-save-panel"
  id="wb-save-panel"
  data-api-base="{{ api_base }}"
  data-product-id="{{ section.settings.product_id | strip }}"
  data-variant-id="{{ section.settings.variant_id | strip }}"
  data-product-url="{{ section.settings.bottle_options_url | strip }}"
>
  <div class="wb-save-panel-inner">

    <div class="wb-lab-inputs">
      <div class="wb-lab-input">
        <label class="wb-lab-label" for="wb-blend-title">Blend name</label>
        <input
          class="wb-lab-field field__input"
          type="text"
          id="wb-blend-title"
          placeholder="e.g. Granny's Secret Recipe"
          autocomplete="off"
          maxlength="80"
        >
      </div>
      <div class="wb-lab-input">
        <label class="wb-lab-label" for="wb-blend-author">Your name</label>
        <input
          class="wb-lab-field field__input"
          type="text"
          id="wb-blend-author"
          placeholder="e.g. Wee Shuggy"
          autocomplete="off"
          maxlength="60"
        >
      </div>
    </div>

    <div class="wb-save-actions">
      <button type="button" id="wb-save-blend-btn" class="button button--full-width" disabled>
        Draw from casks
      </button>
    </div>

    <p class="wb-save-error" id="wb-save-error" aria-live="polite"></p>

    <div class="wb-save-success" id="wb-save-success" aria-live="polite" style="display:none">
      <p class="wb-save-success-message">
        Blend <strong id="wb-blend-slug-display"></strong> saved! 🥃
      </p>
      <a id="wb-blend-product-link" class="button button--full-width" href="#">
        Personalise your bottle &rarr;
      </a>
    </div>
  </div>
</div>

</div>
</div>

<script src="{{ 'wb-lab.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "WB - Blending Lab",
  "tag": "section",
  "class": "section wb-first-item wb-banded",
  "settings": [
    {
      "type": "text",
      "id": "api_base_url",
      "label": "App API base URL",
      "info": "Base URL of the Whisky Blender app — no trailing slash. E.g. https://your-app.ngrok.io"
    },
    {
      "type": "text",
      "id": "product_id",
      "label": "Blend product ID",
      "info": "Shopify product ID to associate with saved blends (numeric, e.g. 8765432100)"
    },
    {
      "type": "text",
      "id": "variant_id",
      "label": "Blend product variant ID",
      "info": "Optional. Leave blank to use the default variant."
    },
    {
      "type": "url",
      "id": "bottle_options_url",
      "label": "Bottle options page URL",
      "info": "URL of the bottle selection page customers go to after saving their blend. E.g. /pages/choose-your-bottle"
    }
  ],
  "presets": [
    {
      "name": "WB - Blending Lab"
    }
  ]
}
{% endschema %}
