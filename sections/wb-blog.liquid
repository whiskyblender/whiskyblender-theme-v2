{{ 'wb-blog.css' | asset_url | stylesheet_tag }}

{%- paginate blog.articles by 9 -%}
<section class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding">
      <h1 class="wb-medium-heading">{{ blog.title | escape }}</h1>
      {%- if section.settings.intro_text != blank -%}
        <div class="wb-blog-intro">{{ section.settings.intro_text }}</div>
      {%- endif -%}

      {%- if blog.articles_count > 0 -%}
        <ul class="wb-cards wb-blog-cards">
          {%- for article in blog.articles -%}
            <li>
              <a class="wb-collection-tile" href="{{ article.url }}"{% if article.image %} style="background-image: url({{ article.image | image_url: width: 800 }})"{% endif %}>
                <div class="wb-collection-tile-overlay">
                  <p class="wb-collection-tile-title">{{ article.title | escape }}</p>
                  {%- if article.excerpt_or_content != blank -%}
                    <p class="wb-collection-tile-count">{{ article.excerpt_or_content | strip_html | truncate: 80 }}</p>
                  {%- endif -%}
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          {%- render 'pagination', paginate: paginate -%}
        {%- endif -%}
      {%- else -%}
        <p style="margin-top: 32px; color: #888;">No articles yet — check back soon.</p>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "WB Blog",
  "settings": [
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro text",
      "default": "<p>Whisky stories, tasting notes, distillery guides, and tips for blending your perfect dram.</p>"
    }
  ],
  "presets": [
    { "name": "WB Blog" }
  ]
}
{% endschema %}
