{{ 'wb-blog.css' | asset_url | stylesheet_tag }}
{{ 'wb-perfectdrams.css' | asset_url | stylesheet_tag }}
{{ 'wb-article-cards.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  50 is Shopify's maximum for `paginate`. With 12 articles this puts the whole blog
  on one page: no pagination controls (the paginate.pages > 1 guard below hides
  them), and every post is linked from the index rather than 3 being stranded on
  page 2. Pagination returns by itself if the blog ever passes 50 posts.
{%- endcomment -%}
{%- paginate blog.articles by 50 -%}
<section class="wb-first-item">
  <div class="wb-container">
    <div class="wb-padding wb-collection-copy">
      <h1 class="wb-large-heading">{{ blog.title | escape }}</h1>
      {%- if section.settings.intro_text != blank -%}
        <div class="wb-blog-intro">{{ section.settings.intro_text }}</div>
      {%- endif -%}

      {%- comment -%}
        Tag filter: plain links to Shopify's own /tagged/ pages, so on a tag page
        blog.articles below is already filtered and no JS is needed. Tags are the
        topic words set on each article (Gifts, Guides, Scotland, ...); every tag on
        any article becomes a chip, so keep the set small.
      {%- endcomment -%}
      {%- if blog.all_tags.size > 1 -%}
        <nav class="wb-tag-chips wb-blog-filter" aria-label="Filter articles by topic">
          <a href="{{ blog.url }}" class="wb-tag-chip{% if current_tags == blank %} is-active{% endif %}"{% if current_tags == blank %} aria-current="page"{% endif %}>All</a>
          {%- for tag in blog.all_tags -%}
            {%- assign is_current = false -%}
            {%- if current_tags contains tag -%}{%- assign is_current = true -%}{%- endif -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="wb-tag-chip{% if is_current %} is-active{% endif %}"{% if is_current %} aria-current="page"{% endif %}>{{ tag }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      {%- if blog.articles_count > 0 -%}
        <ul class="wb-cards wb-main-cards wb-blog-cards">
          {%- for article in blog.articles limit: 12 -%}
            <li>
              <a href="{{ article.url }}" class="wb-card-link-overlay" aria-hidden="true" tabindex="-1"></a>
              <div class="wb-card-image">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 800 | image_tag: alt: article.image.alt | default: article.title, loading: 'lazy' }}
                {%- endif -%}
              </div>
              <div class="wb-card-details">
                <h3 class="wb-small-heading">
                  <a href="{{ article.url }}">{{ article.title | escape }}</a>
                </h3>
                {%- if article.excerpt_or_content != blank -%}
                  <p>{{ article.excerpt_or_content | strip_html | truncate: 120 }} &#8594;</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- comment -%}
          Everything after the first 12 drops to the smaller homepage-strip card
          (snippets/wb-article-card.liquid), title only: 2 per row on phones,
          3 on tablet, 4 on desktop. Keeps the older posts linked without the
          page turning into a very long scroll of big cards.
        {%- endcomment -%}
        {%- if blog.articles.size > 12 -%}
          <ul class="wb-article-cards wb-blog-more" role="list">
            {%- for article in blog.articles offset: 12 -%}
              {%- render 'wb-article-card', article: article, hide_excerpt: true -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          {%- render 'pagination', paginate: paginate -%}
        {%- endif -%}
      {%- else -%}
        <p style="margin-top: 32px; color: #888;">No articles yet — check back soon.</p>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endpaginate -%}

<style>
  /* Raleway rather than the TrimPoster display face, matching the occasions
     cards on the Gifts page. Scoped to .wb-blog-cards: .wb-main-cards is shared
     with the collection list, perfect drams and the WB grid, which keep Trim.
     The weight has to be restated because .wb-small-heading sets
     font-weight: 100 and Raleway is only loaded at 300-700.
     The `a` selector matters: wb-fonts.css has `.wb-small-heading a { font-weight: 100 }`,
     so where the link sits INSIDE the heading (blog cards) the anchor wins and
     the heading rule alone has no effect on the visible text. */
  .wb-blog-cards .wb-small-heading,
  .wb-blog-cards .wb-small-heading a {
    font-family: 'Raleway', sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 2.6vw, 30px);
    line-height: 1.2;
  }

  /* Compact cards after the first 12. The gap above matches the gap between
     the big cards so the two grids read as one list. The strip's default is
     4 columns from 768px; tablet gets 3 here. */
  .wb-blog-more {
    margin-top: 20px;
  }
  @media screen and (min-width: 768px) {
    .wb-blog-more { --wb-article-cols: 3; margin-top: 20px; }
  }
  @media screen and (min-width: 1024px) {
    .wb-blog-more { --wb-article-cols: 4; }
  }
</style>

{% schema %}
{
  "name": "WB Blog",
  "settings": [
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro text",
      "default": "<p>Whisky stories, tasting notes, distillery guides, and tips for blending your perfect dram.</p>"
    }
  ],
  "presets": [
    { "name": "WB Blog" }
  ]
}
{% endschema %}
