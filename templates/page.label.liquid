{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Print Label — Whisky Blender</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Antonio:wght@300&family=Raleway:wght@400;600;700&family=Roboto+Mono:wght@400&display=swap" rel="stylesheet">
  <style>
    @font-face {
      font-family: 'trimPosterCompressed';
      src: url('{{ "TrimPosterWeb-Compressed.woff" | asset_url }}') format('woff'),
           url('{{ "TrimPosterWeb-Compressed.ttf" | asset_url }}') format('truetype');
    }
  </style>
  {{ 'wb-label.css' | asset_url | stylesheet_tag }}
</head>
<body>
<div id="wb-label-root"
  data-api-base="https://lab.whiskyblender.com"
  data-cdn="{{ 'wb-label.css' | asset_url | split: 'wb-label.css' | first }}"
  data-av="10"
  data-artwork-map='{"customblend-standard-200ml":"{{ 'wb-customblend-standard-200ml.jpg' | asset_url }}","customblend-standard-500ml":"{{ 'wb-customblend-standard-500ml.jpg' | asset_url }}","customblend-birthday-200ml":"{{ 'wb-customblend-birthday-200ml.jpg' | asset_url }}","customblend-birthday-500ml":"{{ 'wb-customblend-birthday-500ml.jpg' | asset_url }}","customblend-dad-200ml":"{{ 'wb-customblend-dad-200ml.jpg' | asset_url }}","customblend-dad-500ml":"{{ 'wb-customblend-dad-500ml.jpg' | asset_url }}","customblend-wedding-200ml":"{{ 'wb-customblend-wedding-200ml.jpg' | asset_url }}","customblend-wedding-500ml":"{{ 'wb-customblend-wedding-500ml.jpg' | asset_url }}"}'
>

  <!-- ── Toolbar ────────────────────────────────────────────────────────── -->
  <div id="wb-toolbar">
    <button class="wb-btn wb-btn--back" onclick="history.back()">← Back</button>
    <button class="wb-btn wb-btn--edit" id="wb-btn-edit">Edit</button>
    <button class="wb-btn wb-btn--copy" id="wb-btn-copy">Copy URL</button>
    <button class="wb-btn wb-btn--print" onclick="window.print()">Print</button>
  </div>

  <!-- ── Form panel (hidden by default) ────────────────────────────────── -->
  <div id="wb-form-panel">
    <div id="wb-form-inner">

      <div class="wb-field wb-field--full">
        <label for="wb-f-productname">Product name</label>
        <input type="text" id="wb-f-productname" placeholder="e.g. Custom Blend 500ml">
      </div>

      <div class="wb-field wb-field--full">
        <label for="wb-f-type">Product</label>
        <select id="wb-f-type">
          <option value="customblend">Custom Blend</option>
          <option value="singlemalt">Single Malt</option>
          <option value="singlecask">Single Cask</option>
          <option value="miniatures">Miniature</option>
        </select>
      </div>

      <div class="wb-field wb-field--full wb-blendcode-only">
        <label for="wb-f-blend">Blend code</label>
        <div class="wb-field--blend-code">
          <input type="text" id="wb-f-blend" placeholder="WB00000001">
          <button class="wb-btn--load" id="wb-btn-load">Load</button>
        </div>
      </div>

      <div class="wb-field wb-field--full">
        <label for="wb-f-text">Label text</label>
        <input type="text" id="wb-f-text" placeholder="Name on the label" maxlength="32">
      </div>

      <div class="wb-field wb-has-author">
        <label for="wb-f-author">Created by</label>
        <input type="text" id="wb-f-author" placeholder="Blender's name" maxlength="32">
      </div>

      <div class="wb-field wb-singlemalt-only">
        <label for="wb-f-distillery">Distillery</label>
        <input type="text" id="wb-f-distillery" placeholder="e.g. Aultmore 2011">
      </div>

      <div class="wb-field wb-has-strength">
        <label for="wb-f-strength">Strength</label>
        <input type="number" id="wb-f-strength" placeholder="46" min="0" max="99">
      </div>

      <div class="wb-field wb-nonmini-only">
        <label for="wb-f-size">Bottle size</label>
        <select id="wb-f-size">
          <option value="50ml">50ml</option>
          <option value="200ml">200ml</option>
          <option value="500ml">500ml</option>
        </select>
      </div>

      <div class="wb-field">
        <label for="wb-f-variant">Label style</label>
        <select id="wb-f-variant">
          <option value="standard">Standard</option>
          <option value="birthday">Birthday</option>
          <option value="dad">Dad</option>
          <option value="wedding">Wedding</option>
        </select>
      </div>

      <div class="wb-field wb-singlemalt-only">
        <label for="wb-f-fg">Foreground colour</label>
        <select id="wb-f-fg">
          <option value="#111111">Black</option>
          <option value="#ffffff">White</option>
          <option value="#1a2744">Navy</option>
          <option value="#1c3320">Forest</option>
          <option value="#3b0d17">Claret</option>
          <option value="#d4a878">Gold</option>
          <option value="#f5f0e8">Cream</option>
          <option value="#c8bfa8">Parchment</option>
        </select>
      </div>

      <div class="wb-field wb-singlemalt-only">
        <label for="wb-f-bg">Background colour</label>
        <select id="wb-f-bg">
          <option value="#ffffff">White</option>
          <option value="#111111">Black</option>
          <option value="#f5f0e8">Cream</option>
          <option value="#c8bfa8">Parchment</option>
          <option value="#d4a878">Gold</option>
          <option value="#1a2744">Navy</option>
          <option value="#1c3320">Forest</option>
          <option value="#3b0d17">Claret</option>
        </select>
      </div>

      <div class="wb-field">
        <label for="wb-f-reference">Reference (order no.)</label>
        <input type="text" id="wb-f-reference" placeholder="#1234">
      </div>

    </div>
  </div>

  <!-- ── Page wrapper (centres #page on dark background) ───────────────── -->
  <div id="wb-page-wrapper">

    <!-- ── Standard label page ────────────────────────────────────────── -->
    <div id="page">

      <!-- Label area: fills #page, positions crops + label + overlaid zones -->
      <div class="wb-label-area">

        <!-- Zone 1: Order summary (above cropmarks) -->
        <div id="wb-summary"></div>

        <div class="crops"></div>
        <div id="label">
          <div id="outer">
            <div class="text" id="blendName"></div>
          </div>
          <div class="side">
            <div class="side__name text" id="sideName"></div>
          </div>
          <div id="sideLabel" class="side-label"></div>
          <div class="reference" id="reference"></div>
          <div class="image" id="artwork"></div>
          <!-- Side info panel and single cask strip rendered by JS -->
        </div>

        <!-- Zone 3: Recipe (below cropmarks, blend only) -->
        <div id="wb-recipe-panel">
          <p id="wb-recipe-loading" style="display:none">Loading recipe&hellip;</p>
          <p id="wb-recipe-error" style="display:none"></p>
          <ul id="wb-recipe-list" style="display:none"></ul>
        </div>

      </div>

    </div>

    <!-- ── Miniature contact sheet (shown instead of #page for miniature) -->
    <div id="wb-contact-sheet">
      <div class="wb-contact-page" id="wb-contact-page">
        <div class="wb-contact-grid" id="wb-contact-grid"></div>
      </div>
    </div>

  </div><!-- /wb-page-wrapper -->

  <!-- Hidden: single cask SVG template -->
