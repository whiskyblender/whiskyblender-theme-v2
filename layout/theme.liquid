    {%- comment -%}
      Hide the chat bubble on the Lab. It sits bottom-right, which is exactly
      where the sticky fill meter (.wb-sticky-lab) lives, and blending is a
      focused multi-step task — the same reasoning that already suppresses the
      email popup on this page. Done in Liquid rather than JS so the bubble
      never flashes before being hidden. Selector list mirrors the age-gate
      rule in snippets/wb-age-gate.liquid; shopify-chat (Shopify Inbox) is the
      one actually installed, the rest are belt and braces.
    {%- endcomment -%}
    {%- if request.page_type == 'page' and page.handle == 'the-lab' -%}
      <style>
        shopify-chat,
        #tidio-chat,
        [id^="tidio-chat"],
        #gorgias-chat-container,
        #gorgias-chat-messenger,
        .intercom-lightweight-app,
        #intercom-container,
        #crisp-chatbox,
        iframe[src*="tidio"],
        iframe[src*="gorgias"],
        iframe[src*="intercom"] {
          display: none !important;
        }
      </style>
    {%- endif -%}

    <script>
      /* Self-hosted client-error capture. A JS exception in a customer's browser
         leaves no trace in the server logs, so a silent failure of the blend
         builder — especially in iOS Safari or the Meta in-app browsers, where
         most paid traffic lands — would otherwise be invisible.
         Reports go to our own lab app, not a third party, and set no cookie:
           journalctl -u whiskyblender-lab | grep '\[client-error\]'
         Loaded before the other scripts so it catches their errors too. */
      (function () {
        if (navigator.webdriver) return; /* bots inflate everything — ignore them */
        var ENDPOINT = 'https://lab.whiskyblender.com/api/client-error';
        var MAX = 5, sent = 0, seen = {};

        function report(kind, message, source, position, stack) {
          try {
            if (sent >= MAX) return; /* one broken page must not flood the log */
            var key = kind + '|' + message + '|' + position;
            if (seen[key]) return;
            seen[key] = 1;
            sent++;
            fetch(ENDPOINT, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              keepalive: true,
              body: JSON.stringify({
                kind: kind,
                message: String(message || ''),
                page: location.pathname + location.search,
                source: String(source || ''),
                position: position || '',
                stack: String(stack || '')
              })
            }).catch(function () {});
          } catch (e) {}
        }

        window.addEventListener('error', function (e) {
          if (!e) return;
          /* Failed img/script/css loads also fire 'error' in the capture phase —
             they have a target element rather than window. Not what we're after. */
          if (e.target && e.target !== window && e.target.tagName) return;
          report('error', e.message, e.filename,
                 (e.lineno || 0) + ':' + (e.colno || 0),
                 e.error && e.error.stack);
        }, true);

        window.addEventListener('unhandledrejection', function (e) {
          var r = e && e.reason;
          report('unhandledrejection', (r && r.message) || String(r), '', '', r && r.stack);
        });
      })();
    </script>

