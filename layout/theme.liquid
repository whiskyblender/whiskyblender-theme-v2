      which has its own scope) — the admin Preferences fields are ignored for the homepage.
    {%- endcomment -%}
    {%- if template.name == 'index' -%}
      {%- assign page_title = 'Whisky Blender | Blend Your Own Personalised Scotch Whisky' -%}
      {%- assign page_description = 'The bottle of whisky nobody else has — blend, name and label your own personalised Scotch. Hand-picked casks, bottled in Scotland. Free UK shipping.' -%}
    {%- elsif template.directory == 'metaobject' and template.name == 'wb_blend' and metaobject.blend_title.value != blank -%}
      {%- assign page_title = metaobject.blend_title.value | append: ' - A Whisky Blend by ' | append: metaobject.blend_author.value | append: ' | Whisky Blender' -%}
      {%- if metaobject.recipe.value != blank -%}
        {%- assign wb_blend_recipe = metaobject.recipe.value | parse_json -%}
        {%- assign wb_blend_ingredients = wb_blend_recipe | map: 'name' | join: ', ' -%}
        {%- assign page_description = 'A whisky blend created by ' | append: metaobject.blend_author.value | append: ' featuring ' | append: wb_blend_ingredients | append: '. Blend your own at Whisky Blender.' | truncate: 155 -%}
      {%- else -%}
        {%- assign page_description = 'A whisky blend created by ' | append: metaobject.blend_author.value | append: ' at Whisky Blender.' -%}
      {%- endif -%}
    {%- endif -%}

