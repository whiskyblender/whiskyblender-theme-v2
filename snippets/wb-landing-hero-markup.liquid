{%- comment -%}
  Renders the landing hero (image or video background).
  Usage: {% render 'wb-landing-hero-markup',
    video_file: block.settings.video_file,
    background_image: block.settings.background_image,
    title: block.settings.title,
    description: block.settings.description,
    primary_button_text: block.settings.primary_button_text,
    primary_button_url: block.settings.primary_button_url,
    secondary_button_text: block.settings.secondary_button_text,
    secondary_button_url: block.settings.secondary_button_url
  %}
{%- endcomment -%}

{%- liquid
  if collection.image != blank
    assign hero_image = collection.image | image_url: width: 1920
  elsif background_image != blank
    assign hero_image = background_image | asset_url
  endif
-%}
{%- if video_file == blank -%}
  <div class="wb-imagebg" style="background-image: url({{ hero_image }})">
    <div class="wb-padding">
      <h1 class="wb-medium-heading">{{ title }}</h1>
      <p class="wb-collection-sub">{{ description }}</p>
    </div>
  </div>
{%- else -%}
  <div class="wb-videobg" style="background-image: url({{ hero_image }})">
    <div class="wb-videograin"></div>
    <video autoplay muted loop id="wb-video">
      <source src="{{ video_file | asset_url }}" type="video/mp4">
    </video>
  </div>
  <div class="wb-overvideo">
    <div class="wb-padding">
      <h1 class="wb-large-heading">{{ title }}</h1>
      <p>{{ description }}</p>
      <div class="wb-buttons">
        <a href="{{ primary_button_url }}" class="wb-button wb-primary-button">
          {{- primary_button_text -}}
        </a>
        <a href="{{ secondary_button_url }}" class="wb-button">
          {{- secondary_button_text -}}
        </a>
      </div>
    </div>
  </div>
{%- endif -%}
