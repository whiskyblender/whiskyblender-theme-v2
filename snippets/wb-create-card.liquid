{%- comment -%}
  One option card, as on /pages/create and the 404 page. Needs
  {% render 'wb-create-card-styles' %} once on the page, inside a
  <ul class="wb-create-options wb-cards wb-create-grid">.

  Accepts:
    icon          — emoji
    heading       — HTML; its link is stretched over the whole card (a::after), so the
                    card works by keyboard. With no link, it's wrapped in one to `url`.
    url           — used only when the heading has no link
    description   — optional one-liner
    price_product — optional product; its lowest price shows as a pill via wb-money
    price_prefix  — optional, e.g. "From"
    attrs         — optional extra attributes for the <li> (block.shopify_attributes)
{%- endcomment -%}
<li {{ attrs }}>
  <span class="wb-create-icon" aria-hidden="true">{{ icon }}</span>
  <div class="wb-create-text">
    <h2 class="wb-option-heading">
      {%- if heading contains '<a' -%}
        {{ heading }}
      {%- else -%}
        <a href="{{ url }}">{{ heading }}</a>
      {%- endif -%}
    </h2>
    {%- if description != blank -%}
      <p class="wb-create-desc">{{ description }}</p>
    {%- endif -%}
    {%- if price_product != blank -%}
      <span class="wb-create-price">
        {%- if price_prefix != blank %}{{ price_prefix }} {% endif -%}
        {%- render 'wb-money', amount: price_product.price_min, code: false -%}
      </span>
    {%- endif -%}
  </div>
</li>
