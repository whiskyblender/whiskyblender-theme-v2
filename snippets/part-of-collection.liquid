<p class="wb-collection-ref">
  {%- assign excluded_collections = excluded_collections | default: 'Promoted' -%}
  {%- assign excluded_titles = excluded_collections | split: ',' -%}
  {%- assign filtered_count = 0 -%}
  {%- for collection in product.collections -%}
    {%- assign is_excluded = false -%}
    {%- for title in excluded_titles -%}
      {%- assign trimmed_title = title | strip -%}
      {%- if collection.title == trimmed_title -%}
        {%- assign is_excluded = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- unless is_excluded -%}
      {%- assign filtered_count = filtered_count | plus: 1 -%}
    {%- endunless -%}
  {%- endfor -%}

  {%- if filtered_count > 0 -%}
    Part of the &nbsp;
    {%- assign output_count = 0 -%}
    {%- for collection in product.collections -%}
      {%- assign is_excluded = false -%}
      {%- for title in excluded_titles -%}
        {%- assign trimmed_title = title | strip -%}
        {%- if collection.title == trimmed_title -%}
          {%- assign is_excluded = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless is_excluded -%}
        {%- assign output_count = output_count | plus: 1 -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        {%- if output_count < filtered_count -%}
          {%- assign next_is_last = filtered_count | minus: output_count -%}
          {%- if next_is_last == 1 %} & {% else %}, {% endif -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}
    &nbsp;collection{% if filtered_count > 1 %}s{% endif %}
  {%- endif -%}
</p>
