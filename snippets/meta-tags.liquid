{%- liquid
  # SEO overrides — must match the hardcoded logic in layout/theme.liquid
  if template.name == 'index'
    assign page_title = 'Whisky Blender | Blend Your Own Personalised Scotch Whisky'
    assign page_description = 'The bottle of whisky nobody else has — blend, name and label your own personalised Scotch. Hand-picked casks, bottled in Scotland. Free UK shipping.'
  elsif template.name == 'metaobject' and template.suffix == 'wb_blend' and metaobject.blend_title.value != blank
    assign page_title = metaobject.blend_title.value | append: ' - A Whisky Blend by ' | append: metaobject.blend_author.value | append: ' | Whisky Blender'
    if metaobject.recipe.value != blank
      assign wb_blend_recipe = metaobject.recipe.value | parse_json
      assign wb_blend_ingredients = wb_blend_recipe | map: 'name' | join: ', '
      assign page_description = 'A whisky blend created by ' | append: metaobject.blend_author.value | append: ' featuring ' | append: wb_blend_ingredients | append: '. Blend your own at Whisky Blender.' | truncate: 155
    else
      assign page_description = 'A whisky blend created by ' | append: metaobject.blend_author.value | append: ' at Whisky Blender.'
    endif
  endif

  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  {%- assign og_image_url = page_image | image_url: width: 1200 | prepend: 'https:' -%}
  {%- assign og_image_height = 1200 | divided_by: page_image.aspect_ratio | round -%}
  <meta property="og:image" content="{{ og_image_url }}">
  <meta property="og:image:secure_url" content="{{ og_image_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ og_image_height }}">
  <meta property="og:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
  <meta name="twitter:image" content="{{ og_image_url }}">
{%- elsif template.name == 'metaobject' and template.suffix == 'wb_blend' -%}
  {%- assign og_image_url = images['wb-index.jpg'] | image_url: width: 1200 | prepend: 'https:' -%}
  <meta property="og:image" content="{{ og_image_url }}">
  <meta property="og:image:secure_url" content="{{ og_image_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:image" content="{{ og_image_url }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
