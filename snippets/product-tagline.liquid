<ul class="wb-meta-deetz">
  <li>{{ product.type }}</li>
  {%- for option in product.options_with_values -%}
    {%- if option.name == 'Size' or option.name == 'Bottle size' -%}
      <li>
        {%- assign unique_sizes = '' -%}
        {%- for value in option.values -%}
          {%- unless value == 'One of each' -%}
            {%- assign parts = value | split: ' - ' -%}
            {%- if parts.size > 1 -%}
              {%- assign size_part = parts | last -%}
            {%- else -%}
              {%- assign size_part = value -%}
            {%- endif -%}
            {%- unless unique_sizes contains size_part -%}
              {%- if unique_sizes != '' -%}
                {%- assign unique_sizes = unique_sizes | append: '|' | append: size_part -%}
              {%- else -%}
                {%- assign unique_sizes = size_part -%}
              {%- endif -%}
            {%- endunless -%}
          {%- endunless -%}
        {%- endfor -%}
        {%- assign size_array = unique_sizes | split: '|' -%}
        {%- for size in size_array -%}
          {%- if forloop.index > 1 %} / {% endif -%}
          {{- size -}}
        {%- endfor -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
  {%- if product.metafields.custom.abv.value -%}
    <li>{{ product.metafields.custom.abv.value }} abv.</li>
  {%- endif -%}
</ul>
