{%- comment -%}
  Renders the WB card grid from a list of grid_item metaobjects.
  Usage: {% render 'wb-grid-markup', grid_items: page.metafields.custom.grid_data.value %}
{%- endcomment -%}

<ul class="wb-cards wb-main-cards">
  {%- for grid_item in grid_items -%}
    {%- assign item_title = grid_item.title.value -%}
    {%- assign item_description = grid_item.description.value -%}
    {%- assign item_image = grid_item.image.value -%}
    {%- assign item_link = grid_item.link.value -%}

    <li
      {% if item_link != blank %}
        onclick="location.href='{{ item_link }}';"
        style="cursor: pointer;"
      {% else %}
        class="wb-no-link"
        style="cursor: default;"
      {% endif %}
    >
      <div class="wb-card-image">
        {%- if item_image != blank -%}
          {{
            item_image
            | image_url: width: 1000
            | image_tag: loading: 'lazy', widths: '220, 320, 480, 640, 800, 1000', alt: item_image.alt
            | default: item_title
          }}
        {%- endif -%}
      </div>
      <div class="wb-card-details">
        {%- if item_title != blank -%}
          <h3 class="wb-small-heading">
            {%- if item_link != blank -%}
              <a href="{{ item_link }}">{{ item_title | escape }}</a>
            {%- else -%}
              {{ item_title | escape }}
            {%- endif -%}
          </h3>
        {%- endif -%}
        {%- if item_description != blank -%}
          <p>{{ item_description }}</p>
        {%- endif -%}
      </div>
    </li>
  {%- else -%}
    {%- if design_mode -%}
      <li>
        <div class="wb-card-details">
          <h3 class="wb-small-heading">WB - Grid</h3>
          <p>Add grid_item entries to the page metafield custom.grid_data to populate this grid.</p>
        </div>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
