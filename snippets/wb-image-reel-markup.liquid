
  <div class="glide wb-gifts">
  <div class="glide__track" data-glide-el="track">
    <ul class="glide__slides wb-giftphotos">
      {%- for image in reel_images -%}
        <li class="glide__slide wb-giftphoto">
          <img
            src="{{ image | asset_url }}"
            alt="Reel photo"
            width="2500"
            height="5200"
          >
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (document.querySelector('.wb-gifts')) {
      new Glide('.wb-gifts', {
        type: 'carousel',
        gap: 40,
        perView: 4,
        autoplay: 1,
        animationDuration: 5000,
        animationTimingFunc: 'linear',
        hoverpause: true,
        breakpoints: {
          600: { perView: 3, gap: 20 },
          768: { perView: 4, gap: 30 },
        },
      }).mount();
    }
  });
</script>
