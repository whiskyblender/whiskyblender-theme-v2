<style>
#wb-age-gate {
  position: fixed;
  inset: 0;
  z-index: 99998;
  background-color: #0e0b07;
  background-image: url({{ 'age-gate.jpg' | asset_url }});
  background-size: cover;
  background-position: center;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24px 40px;
  transition: opacity 0.4s ease;
}

#wb-age-gate-rain {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

#wb-age-gate.wb-age-gate--hidden {
  opacity: 0;
  pointer-events: none;
}

/* ── Header overlay ────────────────────────────────────────────── */

.wb-age-gate__header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 1;
}

.wb-age-gate__banner-space {
  /* height set by JS to match announcement bar */
}

.wb-age-gate__header-body {
  position: relative;
  padding: 20px 0 10px 0;
  text-align: center;
}

.wb-age-gate__logo-link {
  margin: 1vw auto;
  display: block;
  width: 180px;
  height: 26px;
  overflow: hidden;
  text-indent: 500px;
  font-size: 0;
  background-image: url({{ 'wb-logo-white.svg' | asset_url }});
  background-size: contain;
  background-position: center center;
  background-repeat: no-repeat;
}

.wb-age-gate__byline-row {
  position: absolute;
  top: 1vw;
  width: 100%;
  display: flex;
  justify-content: space-evenly;
  gap: 180px;
  height: 46px;
  padding: 30px 0 10px 0;
  align-items: center;
  font-size: 6px;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #b88d60;
  text-shadow: #000000 2px 2px 2px;
  animation: wb-coppercolor 6s ease infinite;
}

@media screen and (min-width: 375px) {
  .wb-age-gate__byline-row {
    font-size: 8px;
    letter-spacing: 2px;
  }
}

@media screen and (min-width: 768px) {
  .wb-age-gate__logo-link {
    width: 210px;
    height: 30px;
  }

  .wb-age-gate__byline-row {
    gap: 210px;
    font-size: 9px;
    height: 48px;
    letter-spacing: 3px;
  }
}

@media screen and (min-width: 1024px) {
  .wb-age-gate__byline-row {
    font-size: 10px;
    letter-spacing: 6px;
  }
}

/* ── Gate content ──────────────────────────────────────────────── */

.wb-age-gate__inner {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 480px;
  width: 100%;
}

.wb-age-gate__question {
  font-family: Raleway, sans-serif;
  font-weight: 400;
  font-size: clamp(22px, 5vw, 38px);
  line-height: 1.2;
  color: #ffffff;
  margin: 0 0 48px;
  letter-spacing: 0;
}

.wb-age-gate__buttons {
  display: flex;
  gap: 16px;
  justify-content: center;
}

.wb-age-gate__btn {
  flex: 1;
  max-width: 180px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14px 20px 10px;
  border: 2px solid rgba(255,255,255,0.2);
  border-radius: 2px;
  background: rgba(255,255,255,0.05);
  color: #ffffff;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
  font-family: inherit;
  gap: 6px;
}

.wb-age-gate__btn:hover {
  background: rgba(255,255,255,0.12);
  border-color: rgba(255,255,255,0.5);
}

.wb-age-gate__btn:active {
  transform: scale(0.98);
}

.wb-age-gate__btn--yes {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.5);
}

.wb-age-gate__btn--yes:hover {
  background: rgba(255,255,255,0.2);
  border-color: #ffffff;
}

.wb-age-gate__btn-main {
  font-family: 'trimPosterCompressed', sans-serif;
  font-size: 80px;
  font-weight: 400;
  line-height: 1;
  text-transform: uppercase;
  letter-spacing: 0;
}

.wb-age-gate__btn-sub {
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.5px;
  opacity: 0.6;
  text-transform: lowercase;
  font-family: Raleway, sans-serif;
}

/* Sorry state */
.wb-age-gate__sorry {
  display: none;
}

.wb-age-gate__sorry p {
  font-family: Raleway, sans-serif;
  color: rgba(255,255,255,0.7);
  font-size: 15px;
  line-height: 1.7;
  margin: 0 0 12px;
}

.wb-age-gate__sorry p:first-child {
  font-size: 18px;
  color: #ffffff;
  font-weight: 600;
  margin-bottom: 16px;
}

.wb-age-gate__sorry a {
  color: rgba(255,255,255,0.7);
}

@media (max-width: 440px) {
  .wb-age-gate__btn-main { font-size: 56px; }
  .wb-age-gate__question { margin-bottom: 36px; }
}

</style>

<div id="wb-age-gate" role="dialog" aria-modal="true" aria-labelledby="wb-age-gate-heading">
  <canvas id="wb-age-gate-rain" aria-hidden="true"></canvas>

  <!-- Header overlay: replicates #wb-header structure without backgrounds -->
  <div class="wb-age-gate__header" aria-hidden="true">
    <div class="wb-age-gate__banner-space" id="wb-gate-banner-space"></div>
    <div class="wb-age-gate__header-body">
      <div class="wb-age-gate__logo-link">Whisky Blender</div>
      <div class="wb-age-gate__byline-row">
        <div class="wb-left-byline"><span class="wb-hide-onmobile">Bothwell, </span>Scotland</div>
        <div class="wb-right-byline">Est<span class="wb-hide-onmobile">ablished</span> 2011</div>
      </div>
    </div>
  </div>

  <div class="wb-age-gate__inner">
    <div class="wb-age-gate__content" id="wb-age-gate-content">
      <h1 class="wb-age-gate__question" id="wb-age-gate-heading">Are you of legal drinking age in your country?</h1>
      <div class="wb-age-gate__buttons">
        <button class="wb-age-gate__btn wb-age-gate__btn--yes" id="wb-age-yes" type="button">
          <span class="wb-age-gate__btn-main">Aye</span>
          <span class="wb-age-gate__btn-sub">(yes)</span>
        </button>
        <button class="wb-age-gate__btn wb-age-gate__btn--no" id="wb-age-no" type="button">
          <span class="wb-age-gate__btn-main">Naw</span>
          <span class="wb-age-gate__btn-sub">(no)</span>
        </button>
      </div>
    </div>

    <div class="wb-age-gate__sorry" id="wb-age-sorry">
      <p>Sorry, you must be of legal drinking age to enter this site.</p>
      <p>Please visit <a href="https://www.drinkaware.co.uk" target="_blank" rel="noopener">Drinkaware.co.uk</a> for support and information about alcohol.</p>
    </div>
  </div>
</div>

<script>
(function () {
  var gate = document.getElementById('wb-age-gate');

  /* Hide immediately if already verified — runs before first paint */
  if (document.cookie.indexOf('wb_age_verified=1') !== -1) {
    gate.style.display = 'none';
    return;
  }

  /* Lock scroll while gate is visible */
  document.body.style.overflow = 'hidden';

  /* Push the header overlay down by the announcement banner height so the
     logo and bylines sit exactly over their counterparts in the real header. */
  function applyBannerOffset() {
    var banner      = document.getElementById('wb-banner');
    var bannerSpace = document.getElementById('wb-gate-banner-space');
    if (bannerSpace) bannerSpace.style.height = (banner ? banner.offsetHeight : 0) + 'px';
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applyBannerOffset);
  } else {
    applyBannerOffset();
  }

  function setCookie(name, value, days) {
    var expires = new Date(Date.now() + days * 864e5).toUTCString();
    document.cookie = name + '=' + value + '; expires=' + expires + '; path=/; SameSite=Lax; Secure';
  }

  var stopRain = null;

  function dismiss() {
    setCookie('wb_age_verified', '1', 365);
    document.body.style.overflow = '';
    gate.classList.add('wb-age-gate--hidden');
    if (stopRain) stopRain();
    setTimeout(function () { gate.style.display = 'none'; }, 420);
  }

  function decline() {
    document.getElementById('wb-age-gate-content').style.display = 'none';
    document.getElementById('wb-age-sorry').style.display = 'block';
    setTimeout(function () {
      window.location.href = 'https://www.drinkaware.co.uk';
    }, 2500);
  }

  document.getElementById('wb-age-yes').addEventListener('click', dismiss);
  document.getElementById('wb-age-no').addEventListener('click', decline);

  /* Rain effect */
  var canvas = document.getElementById('wb-age-gate-rain');
  var ctx = canvas.getContext('2d');
  var drops = [];
  var DROP_COUNT = 120;
  var raf;
  var windX = 0;

  function setWind(relX) {
    windX = (relX - 0.5) * 6;
  }

  gate.addEventListener('mousemove', function (e) {
    var rect = canvas.getBoundingClientRect();
    setWind((e.clientX - rect.left) / rect.width);
  });

  gate.addEventListener('touchmove', function (e) {
    var rect = canvas.getBoundingClientRect();
    setWind((e.touches[0].clientX - rect.left) / rect.width);
  }, { passive: true });

  function resize() {
    canvas.width = gate.offsetWidth;
    canvas.height = gate.offsetHeight;
  }

  function initDrops() {
    drops = [];
    for (var i = 0; i < DROP_COUNT; i++) {
      drops.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        len: Math.random() * 20 + 10,
        speed: Math.random() * 8 + 8,
        opacity: Math.random() * 0.3 + 0.1,
        width: Math.random() < 0.3 ? 1.5 : 1
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (var i = 0; i < drops.length; i++) {
      var d = drops[i];
      ctx.beginPath();
      ctx.moveTo(d.x, d.y);
      ctx.lineTo(d.x + windX, d.y + d.len);
      ctx.strokeStyle = 'rgba(180, 200, 220, ' + d.opacity + ')';
      ctx.lineWidth = d.width;
      ctx.stroke();
      d.y += d.speed;
      d.x += windX * 0.3;
      if (d.y > canvas.height + d.len) {
        d.y = -d.len;
        d.x = Math.random() * canvas.width;
      }
    }
    raf = requestAnimationFrame(draw);
  }

  stopRain = function () { cancelAnimationFrame(raf); };

  resize();
  initDrops();
  draw();

  window.addEventListener('resize', function () {
    resize();
    initDrops();
  });
})();
</script>
